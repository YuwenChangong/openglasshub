---
import CommunityLayout from "./CommunityLayout.astro";
import { forumTabs } from "../lib/site-navigation";

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  activeTab?: "feed" | "circles" | "new-post";
}

const { title, description, noindex, canonical, activeTab = "feed" } = Astro.props;
---

<CommunityLayout
  title={title}
  description={description}
  noindex={noindex}
  canonical={canonical}
  activeSection="forum"
  pageClass="forum-main"
>
  <div slot="belowHeader" class="forum-subnav">
    <div class="forum-subnav__inner">
      <nav class="forum-subnav__tabs" aria-label="论坛频道">
        {forumTabs.map((tab) => (
          <a href={tab.href} class:list={[{ "is-active": activeTab === tab.key }]}>
            {tab.label}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <slot />
</CommunityLayout>

<style>
  .forum-subnav {
    border-bottom: 1px solid var(--border);
    background: var(--nav-bg);
  }
  .forum-subnav__inner {
    width: min(1200px, calc(100vw - 2rem));
    margin: 0 auto;
    padding: 0.55rem 0 0.65rem;
  }
  .forum-subnav__tabs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .forum-subnav__tabs a {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 0.8rem;
    border-radius: 999px;
    border: 1px solid transparent;
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.88rem;
    font-weight: 600;
    background: transparent;
  }
  .forum-subnav__tabs a:hover,
  .forum-subnav__tabs a.is-active {
    color: var(--text);
    border-color: var(--border);
    background: var(--surface-soft);
  }
  :global(.forum-main) {
    padding-top: 0.9rem;
  }
  :global(.forum-main h1) {
    margin: 0 0 0.35rem;
    font-size: 1.55rem;
    letter-spacing: -0.03em;
  }
  :global(.forum-main .section-lead) {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  @media (max-width: 900px) {
    .forum-subnav__inner {
      width: min(1200px, calc(100vw - 1.25rem));
      padding: 0.5rem 0 0.6rem;
    }
  }
</style>
