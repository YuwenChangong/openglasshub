---
import CommunityLayout from "./CommunityLayout.astro";
import { forumTabs } from "../lib/site-navigation";

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  activeTab?: "feed" | "circles" | "new-post" | "search";
}

const { title, description, noindex, canonical, activeTab = "feed" } = Astro.props;
---

<CommunityLayout
  title={title}
  description={description}
  noindex={noindex}
  canonical={canonical}
  activeSection="forum"
  pageClass="forum-main"
>
  <div class="forum-tabs-row">
    <nav class="forum-tabs-row__tabs" aria-label="论坛频道">
      {forumTabs.map((tab) => (
        <a href={tab.href} class:list={[{ "is-active": activeTab === tab.key }]}>
          {tab.label}
        </a>
      ))}
    </nav>
  </div>

  <slot />
</CommunityLayout>

<style>
  .forum-tabs-row {
    padding: 0.15rem 0 0.6rem;
  }
  .forum-tabs-row__tabs {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.55rem;
  }
  .forum-tabs-row__tabs a {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0;
    border-radius: 0;
    border: 0;
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.84rem;
    font-weight: 500;
    background: transparent;
  }
  .forum-tabs-row__tabs a:hover,
  .forum-tabs-row__tabs a.is-active {
    color: var(--text);
  }
  :global(.forum-main) {
    padding-top: 0.45rem;
  }
  :global(.forum-main h1) {
    margin: 0 0 0.35rem;
    font-size: 1.55rem;
    letter-spacing: -0.03em;
  }
  :global(.forum-main .section-lead) {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
