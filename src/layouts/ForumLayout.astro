---
import CommunityLayout from "./CommunityLayout.astro";
import { forumTabs } from "../lib/site-navigation";

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article" | "profile";
  activeTab?: "feed" | "circles" | "new-post";
}

const { title, description, noindex, canonical, ogImage, ogType, activeTab } = Astro.props;
---

<CommunityLayout
  title={title}
  description={description}
  noindex={noindex}
  canonical={canonical}
  ogImage={ogImage}
  ogType={ogType}
  activeSection="forum"
  pageClass="forum-main"
>
  <div class="forum-tabs-row">
    <nav class="forum-tabs-row__tabs" aria-label="论坛频道">
      {forumTabs.map((tab) => (
        <a href={tab.href} class:list={[{ "is-active": activeTab === tab.key }]}>
          {tab.label}
        </a>
      ))}
    </nav>
  </div>

  <slot />
</CommunityLayout>

<style>
  .forum-tabs-row {
    padding: 0.15rem 0 0.85rem;
  }
  .forum-tabs-row__tabs {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    padding: 0.18rem;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, rgba(18, 21, 27, 0.84), rgba(10, 12, 16, 0.8));
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.2);
  }
  .forum-tabs-row__tabs a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0.2rem 0.88rem;
    border-radius: 12px;
    border: 1px solid transparent;
    text-decoration: none;
    color: rgba(244, 244, 245, 0.72);
    font-size: 0.86rem;
    font-weight: 650;
    background: transparent;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;
  }
  .forum-tabs-row__tabs a:hover,
  .forum-tabs-row__tabs a.is-active {
    color: var(--text);
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.11);
  }
  .forum-tabs-row__tabs a.is-active {
    background: rgba(255, 255, 255, 0.11);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }
  :global(.forum-main) {
    padding-top: 0.55rem;
  }
  :global(.forum-main h1) {
    margin: 0 0 0.35rem;
    font-size: 1.65rem;
    letter-spacing: -0.04em;
  }
  :global(.forum-main .section-lead) {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
