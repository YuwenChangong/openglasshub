---
import CommunityLayout from "./CommunityLayout.astro";
import { forumTabs } from "../lib/site-navigation";

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article" | "profile";
  activeTab?: "feed" | "circles" | "new-post";
}

const { title, description, noindex, canonical, ogImage, ogType, activeTab } = Astro.props;
---

<CommunityLayout
  title={title}
  description={description}
  noindex={noindex}
  canonical={canonical}
  ogImage={ogImage}
  ogType={ogType}
  activeSection="forum"
  pageClass="forum-main"
>
  <div class="forum-tabs-row">
    <nav class="forum-tabs-row__tabs" aria-label="论坛频道">
      {forumTabs.map((tab) => (
        <a href={tab.href} class:list={[{ "is-active": activeTab === tab.key }]}>
          {tab.label}
        </a>
      ))}
    </nav>
  </div>

  <slot />
</CommunityLayout>

<style>
  .forum-tabs-row {
    padding: 0.1rem 0 0.9rem;
  }
  .forum-tabs-row__tabs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    padding: 0;
    border-radius: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }
  .forum-tabs-row__tabs a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 0.18rem 0.78rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    text-decoration: none;
    color: rgba(244, 244, 245, 0.68);
    font-size: 0.84rem;
    font-weight: 600;
    background: transparent;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
  }
  .forum-tabs-row__tabs a:hover,
  .forum-tabs-row__tabs a.is-active {
    color: var(--text);
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
  }
  .forum-tabs-row__tabs a.is-active {
    background: rgba(255, 255, 255, 0.08);
  }
  :global(.forum-main) {
    padding-top: 0.55rem;
  }
  :global(.forum-main h1) {
    margin: 0 0 0.35rem;
    font-size: 1.58rem;
    letter-spacing: -0.035em;
  }
  :global(.forum-main .section-lead) {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }
</style>
