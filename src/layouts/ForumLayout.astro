---
import AuthCTA from "../components/auth/AuthCTA";

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
}

const { title, description, noindex, canonical } = Astro.props;
const pathname = Astro.url.pathname;

const forumTabs = [
  { label: "动态", href: "/feed/" },
  { label: "圈子", href: "/circles/" },
  { label: "发帖", href: "/posts/new/" },
];

const mainLinks = [
  { label: "首页", href: "/" },
  { label: "论坛", href: "/feed/" },
  { label: "热点资讯", href: "/news/" },
  { label: "设备库", href: "/devices/" },
  { label: "选购指南", href: "/guides/" },
  { label: "开发者", href: "/developers/" },
  { label: "Gaze Launcher", href: "/gaze-os/" },
  { label: "社区", href: "/community/" },
];

function isMainActive(href: string) {
  if (href === "/") return pathname === "/";
  if (href === "/feed/") {
    return pathname.startsWith("/feed/") || pathname.startsWith("/circles/") || pathname.startsWith("/posts/");
  }
  return pathname === href || pathname.startsWith(href);
}

function isForumTabActive(href: string) {
  if (href === "/feed/") return pathname.startsWith("/feed/");
  if (href === "/circles/") return pathname.startsWith("/circles/");
  if (href === "/posts/new/") return pathname.startsWith("/posts/new/");
  return pathname === href;
}
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | OpenGlass Hub</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={`${title} | OpenGlass Hub`} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OpenGlass Hub" />
    <link rel="icon" type="image/x-icon" href="/gaze-icon-v6.ico" />
    <link rel="icon" type="image/svg+xml" href="/gaze-icon-v6.svg" />
    <style>
      :root { color-scheme: dark; }
      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Noto Sans SC", sans-serif;
        background: #0b0f19;
        color: #e7ecf5;
        line-height: 1.65;
      }
      main {
        padding: 1.5rem 1rem 4rem;
        max-width: 1180px;
        margin: 0 auto;
      }
      h1, h2, h3 { color: #f8fafc; }
      h1 {
        margin: 0;
        font-size: 2rem;
        line-height: 1.2;
        letter-spacing: 0;
      }
      h2 {
        margin: 0;
        font-size: 1.25rem;
        letter-spacing: 0;
      }
      a { color: #7cb5ff; }
      .site-nav {
        position: sticky;
        top: 0;
        z-index: 10;
        background: #111827;
        border-bottom: 1px solid #20283a;
        padding: 0.78rem 1rem;
      }
      .site-nav-inner {
        max-width: none;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .site-nav-group {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        flex-wrap: wrap;
      }
      .site-nav-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        color: #e8edf8;
        font-weight: 700;
        font-size: 1.15rem;
        text-decoration: none;
        letter-spacing: 0;
      }
      .site-nav-brand img {
        width: 28px;
        height: 28px;
        object-fit: contain;
      }
      .site-nav-links {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        font-size: 0.92rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .site-nav-links a {
        color: #a8b0c7;
        text-decoration: none;
        transition: color 0.15s;
      }
      .site-nav-links a:hover,
      .site-nav-links a.active { color: #f8fafc; }
      .forum-tabs {
        display: flex;
        gap: 0.5rem;
        margin: 0 0 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid #20283a;
      }
      .forum-tabs a {
        display: inline-flex;
        align-items: center;
        height: 2.25rem;
        padding: 0 0.8rem;
        border-radius: 6px;
        color: #a8b0c7;
        text-decoration: none;
        font-weight: 600;
      }
      .forum-tabs a:hover,
      .forum-tabs a.active {
        background: #162033;
        color: #f8fafc;
      }
      .page-intro {
        margin-bottom: 1rem;
      }
      .page-lead {
        max-width: 760px;
        margin: 0.55rem 0 0;
        color: #a8b0c7;
        font-size: 0.98rem;
      }
      .action-row {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin: 1.5rem 0 2rem;
      }
      .breadcrumb {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
        font-size: 0.9rem;
        color: #69738c;
      }
      .breadcrumb a { color: #7cb5ff; text-decoration: none; }
      .breadcrumb a:hover { text-decoration: underline; }
      .card {
        background: rgba(17, 21, 39, 0.88);
        border-radius: 8px;
        border: 1px solid #20283a;
        padding: 1rem 1.1rem;
        transition: border-color 0.15s, transform 0.15s;
      }
      .card:hover {
        border-color: #334155;
      }
      .tag {
        display: inline-block;
        padding: 0.15rem 0.45rem;
        border-radius: 4px;
        font-size: 0.76rem;
        font-weight: 600;
      }
      .tag-blue { background: #7cb5ff20; color: #7cb5ff; }
      .tag-purple { background: rgba(96, 165, 250, 0.12); color: #93c5fd; }
      .meta { font-size: 0.84rem; color: #7b849d; }
      .empty-state {
        padding: 1.4rem;
        background: rgba(17, 21, 39, 0.88);
        border-radius: 8px;
        border: 1px solid #20283a;
        text-align: left;
        color: #a8b0c7;
      }
      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.55rem 0.9rem;
        background: #2563eb;
        color: #f8fafc;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.92rem;
        border: 1px solid #2563eb;
        transition: background 0.15s, border-color 0.15s, transform 0.15s;
      }
      .btn-primary:hover {
        background: #1d4ed8;
        border-color: #1d4ed8;
      }
      .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.55rem 0.9rem;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.92rem;
        border: 1px solid #20283a;
        background: #101725;
        color: #dbeafe;
      }
      .forum-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 280px;
        gap: 1rem;
        align-items: start;
      }
      .forum-panel {
        background: #0f1624;
        border: 1px solid #20283a;
        border-radius: 8px;
      }
      .forum-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.85rem 1rem;
        border-bottom: 1px solid #20283a;
      }
      .forum-list {
        display: grid;
      }
      .forum-item {
        display: block;
        padding: 1rem;
        border-bottom: 1px solid #20283a;
        color: inherit;
        text-decoration: none;
      }
      .forum-item:last-child {
        border-bottom: 0;
      }
      .forum-item:hover {
        background: #111b2c;
      }
      .forum-item h3 {
        margin: 0.35rem 0 0.45rem;
        font-size: 1rem;
        line-height: 1.45;
      }
      .forum-sidebar {
        display: grid;
        gap: 1rem;
      }
      .forum-side-list {
        display: grid;
      }
      .forum-side-link {
        display: block;
        padding: 0.85rem 1rem;
        border-bottom: 1px solid #20283a;
        color: #dbeafe;
        text-decoration: none;
      }
      .forum-side-link:last-child {
        border-bottom: 0;
      }
      .forum-side-link:hover {
        background: #111b2c;
      }
      .btn-secondary:hover {
        border-color: rgba(124, 181, 255, 0.32);
        color: #f8fafc;
      }
      .footer {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(124, 181, 255, 0.12);
        font-size: 0.85rem;
        color: #7b849d;
        text-align: left;
      }
      .footer a { color: #7cb5ff; text-decoration: none; }
      @media (max-width: 720px) {
        main {
          padding-top: 2rem;
        }
        .site-nav-inner {
          align-items: flex-start;
        }
        .forum-grid {
          grid-template-columns: 1fr;
        }
        .forum-sidebar {
          order: -1;
        }
      }
    </style>
  </head>
  <body>
    <nav class="site-nav">
      <div class="site-nav-inner">
        <div class="site-nav-group">
          <a href="/" class="site-nav-brand">
            <img src="/brand/openglass-nav-logo.png" alt="OpenGlass Hub" />
            <span>OpenGlass Hub</span>
          </a>
          <ul class="site-nav-links">
            {mainLinks.map((link) => (
              <li>
                <a href={link.href} class:list={{ active: isMainActive(link.href) }}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <AuthCTA next={canonical ?? "/"} compact={true} client:only="react" />
      </div>
    </nav>
    <main>
      <nav class="forum-tabs" aria-label="论坛频道">
        {forumTabs.map((tab) => (
          <a href={tab.href} class:list={{ active: isForumTabActive(tab.href) }}>
            {tab.label}
          </a>
        ))}
      </nav>
      <slot />
    </main>
  </body>
</html>
