---
import type { ResolvedPostMedia } from "../../lib/forum-media";
import PostMediaPreview from "./PostMediaPreview.astro";

interface Props {
  id: string;
  title: string;
  excerpt?: string;
  circleName?: string;
  circleSlug?: string;
  typeLabel?: string;
  authorName?: string;
  timestamp: string;
  mediaLabel?: string;
  media?: ResolvedPostMedia[];
}

const { id, title, excerpt, circleName, circleSlug, typeLabel, authorName, timestamp, mediaLabel, media = [] } = Astro.props;
const displayName = authorName?.trim() || "社区成员";
const postHref = `/posts/${id}/`;
---

<article class="community-post-card">
  <div class="community-post-meta-row">
    <div class="community-post-meta">
      {circleName && circleSlug && <a href={`/circles/${circleSlug}/`} class="community-post-meta__link">{circleName}</a>}
      <span>{displayName}</span>
      <span>{timestamp}</span>
      {typeLabel && <span>{typeLabel}</span>}
    </div>
    <button type="button" class="community-post-more" aria-label="更多操作" disabled>···</button>
  </div>

  <a href={postHref} class="community-post-title-link">
    <h3>{title}</h3>
  </a>

  {excerpt && (
    <p class="community-post-excerpt">{excerpt}</p>
  )}

  {media.length > 0 ? <PostMediaPreview media={media} href={postHref} mode="feed" maxItems={4} /> : mediaLabel ? <div class="community-media-placeholder">{mediaLabel}</div> : null}

  <div class="community-post-actions">
    <a class="community-action" href={`${postHref}#comments`}>评论</a>
    <span class="community-action--muted" title="收藏功能将在后续版本开放">收藏</span>
    <a class="community-action" href={postHref}>分享</a>
    <div class="community-post-actions__spacer" />
    <a class="community-action--muted" href={postHref}>查看详情</a>
  </div>
  <div class="community-post-divider" aria-hidden="true"></div>
</article>
