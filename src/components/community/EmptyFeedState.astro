---
import { resolveLocale } from "../../lib/i18n/locale";
import { getUiMessages } from "../../lib/i18n/catalog";
interface Props {
  title?: string;
  description?: string;
  primaryHref?: string;
  secondaryHref?: string;
  primaryLabel?: string;
  secondaryLabel?: string;
}

const localeContext = Astro.locals.localeContext ?? resolveLocale({});
const text = getUiMessages(localeContext.locale).community;
const {
  title = text.noPosts,
  description = text.noPostsDetail,
  primaryHref = "/posts/new/",
  secondaryHref = "/circles/",
  primaryLabel = text.firstPost,
  secondaryLabel = text.viewCircles,
} = Astro.props;
---

<div class="community-empty">
  <strong>{title}</strong>
  <p>{description}</p>
  <div class="community-chip-row">
    <span class="community-chip">{text.deviceExperience}</span>
    <span class="community-chip">{text.buyingHelp}</span>
    <span class="community-chip">{text.developmentQuestions}</span>
    <span class="community-chip">{text.launcherSuggestions}</span>
  </div>
  <div class="community-cta-row">
    <a href={primaryHref} class="community-button">{primaryLabel}</a>
    <a href={secondaryHref} class="community-button--secondary">{secondaryLabel}</a>
  </div>
</div>
