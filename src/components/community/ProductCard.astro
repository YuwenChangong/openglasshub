---
import { getUiMessages, formatUiMessage } from "../../lib/i18n/catalog";
const localeContext = Astro.locals.localeContext;
const text = getUiMessages(localeContext.locale).catalog;
interface Props {
  label?: string;
  title: string;
  description: string;
  href: string;
}

const { label = text.productEntry, title, description, href } = Astro.props;
---

<a href={href} class="community-product-card">
  <span class="community-meta">{label}</span>
  <h3>{title}</h3>
  <p>{description}</p>
  <div class="community-post-actions" style="padding-top: 0.35rem;">
    <span class="community-action">{text.enter}</span>
  </div>
</a>
