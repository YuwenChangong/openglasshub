---
interface Props {
  title: string;
  summary: string;
  category: string;
  href: string;
  date: string;
  coverImageUrl?: string;
  coverAlt?: string;
  sourceLabel?: string;
}

const { title, summary, category, href, date, coverImageUrl, coverAlt = title, sourceLabel = "管理员精选" } = Astro.props;
---

<a href={href} class="community-news-card">
  <div class="community-news-top">
    <span class="community-tag">{category}</span>
    <span class="community-meta">{date}</span>
  </div>
  {coverImageUrl && (
    <div class="community-news-cover">
      <img src={coverImageUrl} alt={coverAlt} loading="lazy" />
    </div>
  )}
  <h3>{title}</h3>
  <p>{summary}</p>
  <span class="community-meta">{sourceLabel}</span>
</a>
