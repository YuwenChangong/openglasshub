---
import type { ResolvedPostMedia } from "../../lib/forum-media";

interface Props {
  media?: ResolvedPostMedia[];
  href: string;
  maxItems?: number;
}

const { media = [], href, maxItems = 3 } = Astro.props;
const items = media.filter((item) => item.displayUrl).slice(0, maxItems);
const totalCount = media.filter((item) => item.displayUrl).length;
const visibleCount = items.length;
const extraCount = Math.max(totalCount - visibleCount, 0);
---

{visibleCount > 0 && (
  <div class:list={["community-post-media-preview", `community-post-media-preview--${Math.min(visibleCount, 3)}`]}>
    {items.map((item, index) => (
      <a
        href={href}
        class:list={[
          "community-post-media-preview__item",
          { "community-post-media-preview__item--lead": visibleCount === 3 && index === 0 },
        ]}
      >
        {item.kind === "image" ? (
          <img
            src={item.previewUrl || item.displayUrl}
            alt={item.alt_text || "帖子图片"}
            loading="lazy"
          />
        ) : item.kind === "video" ? (
          <>
            <video
              src={item.previewUrl || item.displayUrl}
              muted
              playsinline
              preload="metadata"
            />
            <span class="community-post-media-preview__badge">视频</span>
          </>
        ) : (
          <div class="community-post-media-preview__external">
            <span class="community-post-media-preview__badge">视频链接</span>
            <strong>{item.alt_text || "打开视频链接"}</strong>
          </div>
        )}
        {index === visibleCount - 1 && extraCount > 0 && (
          <span class="community-post-media-preview__more">+{extraCount}</span>
        )}
      </a>
    ))}
  </div>
)}
