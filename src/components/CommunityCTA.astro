---
import { getUiMessages, formatUiMessage } from "../lib/i18n/catalog";
const localeContext = Astro.locals.localeContext;
const text = getUiMessages(localeContext.locale).catalog;
// Community call-to-action component
---

<section class="community-cta">
  <div class="cta-content">
    <h2>{text.joinCommunity}</h2>
    <p>{text.communityEntries}</p>
    <div class="cta-links">
      <span class="cta-link github disabled">
        {text.githubPreparing}
      </span>
      <span class="cta-link discord disabled">
        {text.discordPreparing}
      </span>
      <span class="cta-link wechat disabled">
        {text.wechatPreparing}
      </span>
    </div>
  </div>
</section>

<style>
  .community-cta {
    margin-top: 3rem;
    padding: 2rem;
    background: var(--sl-color-bg-nav);
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
  }
  .cta-content h2 {
    margin-top: 0;
    margin-bottom: 0.5rem;
  }
  .cta-content p {
    color: var(--sl-color-gray-2);
    margin-bottom: 1.25rem;
  }
  .cta-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cta-link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.25rem;
    border-radius: 0.375rem;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: background 0.15s;
  }
  .cta-link.discord {
    background: #5865F2;
    color: #fff;
  }
  .cta-link.discord:not(.disabled):hover {
    background: #4752c4;
  }
  .cta-link.wechat {
    background: #07C160;
    color: #fff;
  }
  .cta-link.wechat:not(.disabled):hover {
    background: #06ae56;
  }
  .cta-link.github {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text);
  }
  .cta-link.github:hover {
    background: var(--sl-color-gray-5);
  }
  .cta-link.disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
