---
import HeaderUserMenu from "./HeaderUserMenu";
import HeaderNotifications from "./HeaderNotifications";
import GlobalSearchBox from "../community/GlobalSearchBox";
import { inferNavKey, mainNav, type NavKey } from "../../lib/site-navigation";

interface Props {
  currentPath?: string;
  currentSection?: NavKey;
  next?: string;
  variant?: "site" | "starlight";
}

const { currentPath = Astro.url.pathname, currentSection, next = currentPath, variant = "site" } = Astro.props;
const activeKey = currentSection ?? inferNavKey(currentPath);
---

<header class:list={["og-header", "ogh-site-header", { "is-starlight": variant === "starlight" }]}>
  <div class="og-header__inner ogh-site-header__inner">
    <a href="/" class="og-header__brand ogh-brand" aria-label="OpenGlass Hub 首页">
      <img src="/brand/openglass-nav-logo.png" alt="" width="34" height="34" decoding="async" />
      <span>OpenGlass Hub</span>
    </a>

    <nav class="og-header__nav ogh-nav" aria-label="站点导航">
      {mainNav.map((item) => (
        <a
          href={item.href}
          class:list={["og-header__link", { "is-active": activeKey === item.key }]}
          aria-current={activeKey === item.key ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="og-header__search">
      <GlobalSearchBox compact={true} client:load />
    </div>

    <div class="og-header__auth ogh-header-actions">
      <HeaderNotifications client:only="react" />
      <HeaderUserMenu next={next} client:only="react" />
    </div>
  </div>
</header>

<style>
  .og-header,
  .ogh-site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background:
      linear-gradient(
        180deg,
        var(--ogh-header-top, rgba(255,255,255,0.055)),
        var(--ogh-header-bottom, rgba(255,255,255,0.028))
      ),
      var(--ogh-header-base, rgba(0,0,0,0.72));
    backdrop-filter: blur(18px) saturate(135%);
    -webkit-backdrop-filter: blur(18px) saturate(135%);
    border-bottom: 1px solid var(--ogh-header-border, rgba(255,255,255,0.105));
    box-shadow:
      inset 0 1px 0 var(--ogh-header-highlight, rgba(255,255,255,0.07)),
      0 10px 30px var(--ogh-header-shadow, rgba(0,0,0,0.35));
  }
  .og-header__inner,
  .ogh-site-header__inner {
    width: 100%;
    max-width: none;
    min-height: 72px;
    margin: 0;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.1rem;
  }
  .og-header__brand,
  .ogh-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #f5f5f5;
    font-weight: 800;
    font-size: 1.08rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .og-header__brand:hover,
  .ogh-brand:hover {
    opacity: 0.96;
  }
  .og-header__brand img,
  .ogh-brand img {
    width: 34px;
    height: 34px;
    display: block;
    object-fit: contain;
    image-rendering: -webkit-optimize-contrast;
  }
  .og-header__nav,
  .ogh-nav {
    display: flex;
    align-items: center;
    gap: 0.32rem;
    min-width: 0;
    overflow-x: auto;
    flex: 1;
    justify-content: flex-start;
    scrollbar-width: none;
  }
  .og-header__nav::-webkit-scrollbar {
    display: none;
  }
  .og-header__link,
  .ogh-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 10px 12px;
    border-radius: 12px;
    color: rgba(245,245,245,0.72);
    text-decoration: none;
    font-size: 0.94rem;
    font-weight: 650;
    white-space: nowrap;
    position: relative;
    background: transparent;
    border: 0;
    box-shadow: none;
    transition:
      color 140ms ease,
      background 140ms ease;
  }
  .og-header__link:hover,
  .ogh-nav a:hover {
    color: #fff;
    background: rgba(255,255,255,0.065);
  }
  .og-header__link[aria-current="page"],
  .og-header__link.is-active,
  .ogh-nav a[aria-current="page"],
  .ogh-nav a.is-active {
    color: #fff;
    background: rgba(255,255,255,0.05);
    border: 0;
    box-shadow: none;
  }
  .og-header__link[aria-current="page"]::after,
  .og-header__link.is-active::after,
  .ogh-nav a[aria-current="page"]::after,
  .ogh-nav a.is-active::after {
    content: "";
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 4px;
    height: 2px;
    border-radius: 999px;
    background: #2f81f7;
  }
  .og-header__search {
    flex: 0 1 380px;
    min-width: 240px;
  }
  .og-header__auth,
  .ogh-header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    flex-shrink: 0;
    position: relative;
  }
  :global(.ogh-auth-inline) {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  :global(.ogh-login-button),
  :global(.ogh-register-button),
  :global(.ogh-auth-secondary) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 10px 16px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
    border: 1px solid rgba(255,255,255,0.13);
    color: #f5f5f5;
    backdrop-filter: blur(14px) saturate(125%);
    -webkit-backdrop-filter: blur(14px) saturate(125%);
  }
  :global(.ogh-login-button),
  :global(.ogh-auth-secondary) {
    background:
      linear-gradient(180deg, rgba(255,255,255,0.075), rgba(255,255,255,0.04));
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.075),
      0 8px 22px rgba(0,0,0,0.24);
  }
  :global(.ogh-register-button) {
    background:
      linear-gradient(180deg, rgba(89,169,255,0.98), rgba(47,129,247,0.9));
    border-color: rgba(150,200,255,0.45);
    color: #fff;
    font-weight: 800;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.2),
      0 12px 30px rgba(47,129,247,0.26);
  }
  :global(.ogh-auth-status) {
    color: rgba(245,245,245,0.72);
    font-size: 0.88rem;
  }
  :global(.ogh-auth-button-reset) {
    appearance: none;
    font: inherit;
    cursor: pointer;
  }
  :global(.ogh-login-button:hover),
  :global(.ogh-auth-secondary:hover) {
    background:
      linear-gradient(180deg, rgba(255,255,255,0.09), rgba(255,255,255,0.05));
    border-color: rgba(255,255,255,0.18);
    color: #fff;
  }
  :global(.ogh-register-button:hover) {
    background:
      linear-gradient(180deg, rgba(104,178,255,1), rgba(59,130,246,0.94));
  }
  @media (max-width: 1100px) {
    .og-header__search {
      flex-basis: 320px;
      min-width: 200px;
    }
  }
  @media (max-width: 900px) {
    .og-header__inner {
      min-height: auto;
      padding: 0.8rem 0.9rem 0.9rem;
      align-items: flex-start;
      flex-wrap: wrap;
    }
    .og-header__brand {
      min-height: 42px;
    }
    .og-header__search {
      order: 3;
      width: 100%;
      flex-basis: 100%;
    }
    .og-header__nav {
      order: 4;
      width: 100%;
      padding-bottom: 0.1rem;
    }
    .og-header__auth {
      margin-left: auto;
    }
    .og-header__brand span {
      font-size: 1rem;
    }
  }
</style>
