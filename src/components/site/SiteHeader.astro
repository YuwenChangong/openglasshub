---
import HeaderUserMenu from "./HeaderUserMenu";
import HeaderNotifications from "./HeaderNotifications";
import GlobalSearchBox from "../community/GlobalSearchBox";
import { inferNavKey, mainNav, type NavKey } from "../../lib/site-navigation";

interface Props {
  currentPath?: string;
  currentSection?: NavKey;
  next?: string;
  variant?: "site" | "starlight";
  showSearch?: boolean;
}

const { currentPath = Astro.url.pathname, currentSection, next = currentPath, variant = "site", showSearch = true } = Astro.props;
const activeKey = currentSection ?? inferNavKey(currentPath);
---

<header class:list={["og-header", "ogh-site-header", { "is-starlight": variant === "starlight" }]}>
  <div class="og-header__inner ogh-site-header__inner">
    <a href="/" class="og-header__brand ogh-brand" aria-label="OpenGlass Hub 首页">
      <img src="/brand/openglass-nav-logo.png" alt="" width="34" height="34" decoding="async" />
      <span>OpenGlass Hub</span>
    </a>

    <nav class="og-header__nav ogh-nav" aria-label="站点导航">
      {mainNav.map((item) => (
        <a
          href={item.href}
          class:list={["og-header__link", { "is-active": activeKey === item.key }]}
          aria-current={activeKey === item.key ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    {showSearch ? (
      <div class="og-header__search">
        <GlobalSearchBox compact={true} client:load />
      </div>
    ) : null}

    <div class="og-header__auth ogh-header-actions">
      <HeaderNotifications client:only="react" />
      <HeaderUserMenu next={next} client:only="react" />
    </div>
  </div>
</header>

<style>
  .og-header,
  .ogh-site-header {
    position: sticky;
    top: 0;
    z-index: var(--premium-header-z, 120);
    width: 100%;
    background:
      linear-gradient(180deg, rgba(5, 11, 24, 0.88), rgba(3, 5, 9, 0.82)),
      rgba(3, 5, 9, 0.82);
    backdrop-filter: blur(18px) saturate(128%);
    -webkit-backdrop-filter: blur(18px) saturate(128%);
    border-bottom: 1px solid rgba(92, 142, 240, 0.13);
    box-shadow: 0 1px 0 rgba(184, 211, 255, 0.035);
  }
  .og-header__inner,
  .ogh-site-header__inner {
    width: 100%;
    max-width: none;
    min-height: 58px;
    margin: 0;
    padding: 0 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .og-header__brand,
  .ogh-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: rgba(248, 251, 255, 0.98);
    font-weight: 650;
    font-size: 0.98rem;
    letter-spacing: -0.015em;
    white-space: nowrap;
    flex-shrink: 0;
    transition:
      opacity var(--premium-duration-fast, 160ms) var(--premium-ease, ease),
      transform var(--premium-duration-fast, 160ms) var(--premium-ease, ease);
  }
  .og-header__brand:hover,
  .ogh-brand:hover {
    opacity: 0.9;
    transform: none;
  }
  .og-header__brand img,
  .ogh-brand img {
    width: 32px;
    height: 32px;
    display: block;
    object-fit: contain;
    image-rendering: -webkit-optimize-contrast;
  }
  .og-header__nav,
  .ogh-nav {
    display: flex;
    align-items: center;
    gap: 0.08rem;
    min-width: 0;
    overflow-x: auto;
    flex: 1;
    justify-content: flex-start;
    scrollbar-width: none;
  }
  .og-header__nav::-webkit-scrollbar {
    display: none;
  }
  .og-header__link,
  .ogh-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 5px 10px;
    border-radius: 999px;
    color: rgba(218, 228, 246, 0.7);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 560;
    white-space: nowrap;
    position: relative;
    background: transparent;
    border: 1px solid transparent;
    box-shadow: none;
    transition:
      color var(--premium-duration-fast, 160ms) var(--premium-ease, ease),
      background var(--premium-duration-fast, 160ms) var(--premium-ease, ease),
      border-color var(--premium-duration-fast, 160ms) var(--premium-ease, ease),
      transform var(--premium-duration-fast, 160ms) var(--premium-ease, ease),
      box-shadow var(--premium-duration-fast, 160ms) var(--premium-ease, ease);
  }
  .og-header__link:hover,
  .ogh-nav a:hover {
    color: #fff;
    background: rgba(83, 131, 226, 0.11);
    border-color: transparent;
    transform: none;
    box-shadow: none;
  }
  .og-header__link[aria-current="page"],
  .og-header__link.is-active,
  .ogh-nav a[aria-current="page"],
  .ogh-nav a.is-active {
    color: #fff;
    background: rgba(62, 116, 225, 0.16);
    border-color: transparent;
    box-shadow: none;
  }
  .og-header__link[aria-current="page"]::after,
  .og-header__link.is-active::after,
  .ogh-nav a[aria-current="page"]::after,
  .ogh-nav a.is-active::after {
    display: none;
  }
  .og-header__search {
    flex: 0 1 280px;
    min-width: 210px;
  }
  .og-header__search :global(.global-search-box__form) {
    border-radius: 999px;
  }
  .og-header__search :global(.global-search-box__input) {
    min-height: 38px;
    border-radius: 999px;
    background: rgba(7, 18, 39, 0.58);
    border-color: rgba(126, 168, 255, 0.12);
  }
  .og-header__search :global(.global-search-box__button) {
    min-height: 38px;
    border-radius: 999px;
  }
  .og-header__auth,
  .ogh-header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    flex-shrink: 0;
    position: relative;
  }
  :global(.ogh-auth-inline) {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  :global(.ogh-login-button),
  :global(.ogh-register-button),
  :global(.ogh-auth-secondary) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 7px 13px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 650;
    border: 1px solid rgba(126, 168, 255, 0.12);
    color: #f5f5f5;
    backdrop-filter: blur(16px) saturate(116%);
    -webkit-backdrop-filter: blur(16px) saturate(116%);
    transition:
      transform var(--premium-duration-fast, 160ms) var(--premium-ease, ease),
      background var(--premium-duration-fast, 160ms) var(--premium-ease, ease),
      border-color var(--premium-duration-fast, 160ms) var(--premium-ease, ease),
      box-shadow var(--premium-duration-fast, 160ms) var(--premium-ease, ease);
  }
  :global(.ogh-login-button),
  :global(.ogh-auth-secondary) {
    background: rgba(7, 18, 39, 0.52);
    box-shadow: none;
  }
  :global(.ogh-register-button) {
    background: rgba(62, 116, 225, 0.18);
    border-color: rgba(141, 178, 255, 0.26);
    color: #fff;
    font-weight: 650;
    box-shadow: none;
  }
  :global(.ogh-auth-status) {
    color: rgba(245,245,245,0.72);
    font-size: 0.88rem;
  }
  :global(.ogh-auth-button-reset) {
    appearance: none;
    font: inherit;
    cursor: pointer;
  }
  :global(.ogh-login-button:hover),
  :global(.ogh-auth-secondary:hover) {
    background: rgba(76, 132, 240, 0.16);
    border-color: rgba(151, 188, 255, 0.28);
    color: #fff;
    transform: translateY(-1px);
  }
  :global(.ogh-register-button:hover) {
    background: rgba(72, 130, 245, 0.24);
    border-color: rgba(166, 198, 255, 0.34);
    transform: none;
  }
  .og-header__link:focus-visible,
  .ogh-nav a:focus-visible,
  .og-header__brand:focus-visible,
  .ogh-brand:focus-visible,
  :global(.ogh-login-button:focus-visible),
  :global(.ogh-register-button:focus-visible),
  :global(.ogh-auth-secondary:focus-visible) {
    outline: none;
    box-shadow: var(--premium-focus-ring, 0 0 0 3px rgba(75, 135, 255, 0.22));
  }
  @media (max-width: 1100px) {
    .og-header__search {
      flex-basis: 320px;
      min-width: 200px;
    }
  }
  @media (max-width: 860px) {
    .og-header__inner {
      min-height: auto;
      padding: 0.86rem 0.98rem 0.94rem;
      align-items: flex-start;
      flex-wrap: wrap;
    }
    .og-header__brand {
      min-height: 42px;
    }
    .og-header__search {
      order: 3;
      width: 100%;
      flex-basis: 100%;
    }
    .og-header__nav {
      order: 4;
      width: 100%;
      padding-bottom: 0.1rem;
    }
    .og-header__auth {
      margin-left: auto;
    }
    .og-header__brand span {
      font-size: 1rem;
    }
  }
  @media (max-width: 720px) {
    .og-header__inner {
      gap: 0.78rem;
      padding: 0.74rem 0.74rem 0.82rem;
    }
    .og-header__brand,
    .ogh-brand {
      gap: 10px;
      min-height: 40px;
    }
    .og-header__brand img,
    .ogh-brand img {
      width: 30px;
      height: 30px;
    }
    .og-header__brand span,
    .ogh-brand span {
      font-size: 0.96rem;
    }
    .og-header__link,
    .ogh-nav a {
      min-height: 38px;
      padding: 7px 11px;
      border-radius: 999px;
      font-size: 0.86rem;
    }
    .og-header__auth,
    .ogh-header-actions {
      gap: 0.5rem;
    }
    :global(.ogh-login-button),
    :global(.ogh-register-button),
    :global(.ogh-auth-secondary) {
      min-height: 40px;
      padding: 9px 13px;
      border-radius: 999px;
    }
    .og-header__search :global(.global-search-box__form) {
      flex-direction: row;
      gap: 0.45rem;
      align-items: stretch;
    }
    .og-header__search :global(.global-search-box__button) {
      width: auto;
      min-width: 4.6rem;
      padding-inline: 1rem;
    }
  }
  @media (max-width: 420px) {
    .og-header__inner {
      gap: 0.65rem;
      padding: 0.68rem 0.62rem 0.76rem;
    }
    .og-header__brand img,
    .ogh-brand img {
      width: 28px;
      height: 28px;
    }
    .og-header__brand span,
    .ogh-brand span {
      font-size: 0.92rem;
    }
    .og-header__link,
    .ogh-nav a {
      padding: 7px 10px;
      font-size: 0.82rem;
    }
    .og-header__search :global(.global-search-box__button) {
      min-width: 4.25rem;
      padding-inline: 0.86rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .og-header,
    .ogh-site-header,
    .og-header__brand,
    .ogh-brand,
    .og-header__link,
    .ogh-nav a,
    :global(.ogh-login-button),
    :global(.ogh-register-button),
    :global(.ogh-auth-secondary) {
      transition: none;
      transform: none;
    }
  }
</style>
