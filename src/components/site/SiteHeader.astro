---
import HeaderUserMenu from "./HeaderUserMenu";
import HeaderNotifications from "./HeaderNotifications";
import GlobalSearchBox from "../community/GlobalSearchBox";
import LocalePreferenceSync from "../i18n/LocalePreferenceSync";
import { resolveLocale, type LocaleContext } from "../../lib/i18n/locale";
import { getUiMessages } from "../../lib/i18n/catalog";
import { inferNavKey, getMainNav, type NavKey } from "../../lib/site-navigation";

interface Props {
  currentPath?: string;
  currentSection?: NavKey;
  next?: string;
  variant?: "site" | "starlight";
  showSearch?: boolean;
  localeContext?: LocaleContext;
}

const { currentPath = Astro.url.pathname, currentSection, next = currentPath, variant = "site", showSearch = true } = Astro.props;
const activeKey = currentSection ?? inferNavKey(currentPath);
const localeContext = Astro.props.localeContext ?? Astro.locals.localeContext ?? resolveLocale({});
const messages = getUiMessages(localeContext.locale);
---

<header class:list={["og-header", "ogh-site-header", { "is-starlight": variant === "starlight" }]}>
  <div class="og-header__inner ogh-site-header__inner">
    <a href="/" class="og-header__brand ogh-brand" aria-label={`OpenGlass Hub ${messages.shell.home}`}>
      <img src="/brand/openglass-nav-logo.png" alt="" width="34" height="34" decoding="async" />
      <span>OpenGlass Hub</span>
    </a>

    <button
      class="og-header__menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-site-navigation"
      aria-label={messages.shell.openNavigation}
      data-open-label={messages.shell.openNavigation}
      data-close-label={messages.shell.closeNavigation}
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <nav id="primary-site-navigation" class="og-header__nav ogh-nav" aria-label={messages.shell.navigation} data-open="false">
      {getMainNav(localeContext.locale).map((item) => (
        <a
          href={item.href}
          class:list={["og-header__link", { "is-active": activeKey === item.key }]}
          aria-current={activeKey === item.key ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    {showSearch ? (
      <div class="og-header__search">
        <GlobalSearchBox compact={true} localeContext={localeContext} client:load />
      </div>
    ) : null}

    <div class="og-header__auth ogh-header-actions">
      <span class="og-header__action-slot" data-header-action="notifications"><HeaderNotifications localeContext={localeContext} client:only="react" /></span>
      <a href="/settings/" class="og-header__settings" data-header-action="settings" aria-label={messages.shell.settings} title={messages.shell.settings} data-confirm-message={messages.settings.confirmNavigation}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
          <path d="m9 3 1-1h4l1 1 .6 2 1.8 1 2-.5 2 3.5-1.4 1.5v2l1.4 1.5-2 3.5-2-.5-1.8 1-.6 2-1 1h-4l-1-1-.6-2-1.8-1-2 .5-2-3.5L3 12.5v-2L1.6 9l2-3.5 2 .5 1.8-1Z" /><circle cx="12" cy="11.5" r="3" />
        </svg>
      </a>
      <span class="og-header__action-slot" data-header-action="account"><HeaderUserMenu next={next} localeContext={localeContext} client:load /></span>
    </div>
  </div>
</header>
<dialog class="og-settings-confirm glass-confirm-dialog glass-modal" aria-labelledby="settings-navigation-title">
  <form method="dialog">
    <div class="glass-confirm-header glass-modal__header">
      <h3 id="settings-navigation-title">{messages.settings.title}</h3>
      <p>{messages.settings.confirmNavigation}</p>
    </div>
    <div class="glass-confirm-actions glass-modal__actions">
      <button type="submit" value="cancel" class="community-button--secondary" autofocus>{messages.settings.cancel}</button>
      <button type="submit" value="continue" class="community-button">{messages.settings.continueNavigation}</button>
    </div>
  </form>
</dialog>
<LocalePreferenceSync initial={localeContext} client:load />

<script>
  import { confirmSettingsNavigation } from "../settings/SettingsPage";
  document.querySelectorAll<HTMLElement>(".og-header").forEach((header) => {
    const toggle = header.querySelector<HTMLButtonElement>(".og-header__menu-toggle");
    const navigation = header.querySelector<HTMLElement>(".og-header__nav");
    const setMenuOpen = (open: boolean) => {
      if (!toggle || !navigation) return;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? "");
      navigation.dataset.open = String(open);
    };

    toggle?.addEventListener("click", () => setMenuOpen(toggle.getAttribute("aria-expanded") !== "true"));
    const confirmation = header.nextElementSibling instanceof HTMLDialogElement ? header.nextElementSibling : null;
    confirmation?.addEventListener("close", () => {
      if (confirmation.returnValue === "continue") location.assign("/settings/");
    });
    header.querySelector<HTMLAnchorElement>(".og-header__settings")?.addEventListener("click", event => {
      const hasUnsavedInput = [...document.querySelectorAll<HTMLInputElement>('form input[type="password"], form input[type="email"]')].some(input => !!input.value);
      if (!confirmSettingsNavigation(location.pathname, hasUnsavedInput, () => false, "")) {
        event.preventDefault();
        if (confirmation && !confirmation.open) { confirmation.returnValue = "cancel"; confirmation.showModal(); }
      }
    });
    navigation?.addEventListener("click", (event) => {
      if (event.target instanceof HTMLAnchorElement) setMenuOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape"&&toggle?.getAttribute("aria-expanded")==="true") {setMenuOpen(false);toggle.focus();}
    });
  });
</script>

<style>
  .og-settings-confirm { max-width: min(440px, calc(100vw - 32px)); margin: auto; color: var(--text); background: #15181d; border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; padding: 20px; }
  .og-settings-confirm::backdrop { background: rgba(0,0,0,0.6); }
  .og-settings-confirm p { overflow-wrap: anywhere; }
  .og-header__action-slot { display: contents; }
  .og-header__settings { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; flex: 0 0 44px; color: inherit; border-radius: 6px; }
  .og-header__settings:hover { background: rgba(255,255,255,0.07); }
  .og-header__settings:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .og-header,
  .ogh-site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: rgba(10, 12, 15, 0.88);
    backdrop-filter: blur(10px) saturate(108%);
    -webkit-backdrop-filter: blur(10px) saturate(108%);
    border-bottom: 1px solid rgba(255,255,255,0.04);
    box-shadow: 0 1px 0 rgba(255,255,255,0.02);
  }
  .og-header__inner,
  .ogh-site-header__inner {
    width: 100%;
    max-width: none;
    min-height: 66px;
    margin: 0;
    padding: 0 26px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.1rem;
  }
  .og-header__brand,
  .ogh-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #f5f5f5;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.018em;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .og-header__brand:hover,
  .ogh-brand:hover {
    opacity: 0.96;
  }
  .og-header__brand img,
  .ogh-brand img {
    width: 34px;
    height: 34px;
    display: block;
    object-fit: contain;
    image-rendering: -webkit-optimize-contrast;
  }
  .og-header__nav,
  .ogh-nav {
    display: flex;
    align-items: center;
    gap: 0.18rem;
    min-width: 0;
    overflow-x: auto;
    flex: 1;
    justify-content: flex-start;
    scrollbar-width: none;
  }
  .og-header__nav::-webkit-scrollbar {
    display: none;
  }
  .og-header__menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 999px;
    background: rgba(255,255,255,0.045);
    color: #f5f5f5;
    cursor: pointer;
    flex: 0 0 40px;
    flex-direction: column;
    gap: 4px;
  }
  .og-header__menu-toggle span {
    width: 16px;
  height: 1.6px;
    border-radius: 999px;
    background: currentColor;
  }
  .og-header__menu-toggle:focus-visible {
    outline: none;
    box-shadow: var(--premium-focus-ring, 0 0 0 3px rgba(255,255,255,0.09));
  }
  .og-header__link,
  .ogh-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 8px 12px;
    border-radius: 12px;
    color: rgba(245,245,245,0.7);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    position: relative;
    background: transparent;
    border: 0;
    box-shadow: none;
    transition:
      color 140ms ease,
      background 140ms ease;
  }
  .og-header__link:hover,
  .ogh-nav a:hover {
    color: #fff;
    background: rgba(255,255,255,0.035);
  }
  .og-header__link[aria-current="page"],
  .og-header__link.is-active,
  .ogh-nav a[aria-current="page"],
  .ogh-nav a.is-active {
    color: #fff;
    background: rgba(255,255,255,0.045);
    border: 0;
    box-shadow: none;
  }
  .og-header__link[aria-current="page"]::after,
  .og-header__link.is-active::after,
  .ogh-nav a[aria-current="page"]::after,
  .ogh-nav a.is-active::after {
    display: none;
  }
  .og-header__search {
    flex: 0 1 360px;
    min-width: 240px;
  }
  .og-header__auth,
  .ogh-header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    flex-shrink: 0;
    position: relative;
  }
  :global(.ogh-auth-inline) {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  :global(.ogh-login-button),
  :global(.ogh-register-button),
  :global(.ogh-auth-secondary) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 9px 14px;
    border-radius: 11px;
    text-decoration: none;
    font-weight: 700;
    border: 1px solid rgba(255,255,255,0.13);
    color: #f5f5f5;
    backdrop-filter: blur(10px) saturate(112%);
    -webkit-backdrop-filter: blur(10px) saturate(112%);
  }
  :global(.ogh-login-button),
  :global(.ogh-auth-secondary) {
    background: rgba(255,255,255,0.045);
    box-shadow: none;
  }
  :global(.ogh-register-button) {
    background: linear-gradient(180deg, rgba(89,169,255,0.96), rgba(47,129,247,0.9));
    border-color: rgba(150,200,255,0.45);
    color: #fff;
    font-weight: 700;
    box-shadow: 0 10px 24px rgba(47,129,247,0.22);
  }
  :global(.ogh-auth-status) {
    color: rgba(245,245,245,0.72);
    font-size: 0.88rem;
  }
  :global(.ogh-auth-button-reset) {
    appearance: none;
    font: inherit;
    cursor: pointer;
  }
  :global(.ogh-login-button:hover),
  :global(.ogh-auth-secondary:hover) {
    background: rgba(255,255,255,0.07);
    border-color: rgba(255,255,255,0.18);
    color: #fff;
  }
  :global(.ogh-register-button:hover) {
    background:
      linear-gradient(180deg, rgba(104,178,255,1), rgba(59,130,246,0.94));
  }
  @media (max-width: 1100px) {
    .og-header__search {
      flex-basis: 320px;
      min-width: 200px;
    }
  }
  @media (max-width: 860px) {
    .og-header__menu-toggle {display:inline-flex;width:44px;height:44px;flex:0 0 44px;align-items:center;justify-content:center;}
    .og-header__inner {
      min-height: auto;
      padding: 0.68rem 0.82rem 0.76rem;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 0.68rem 0.8rem;
    }
    .og-header__brand {
      min-height: 40px;
    }
    .og-header__search {
      order: 4;
      width: 100%;
      flex-basis: 100%;
    }
    .og-header__nav {
      display:none;
      order: 3;
      width: 100%;
      padding-bottom: 0;
    }
    .og-header__nav[data-open="true"] {display:flex;flex-wrap:wrap;flex-basis:100%;}
    .og-header__auth {
      margin-left: auto;
    }
    .og-header__brand span {
      font-size: 0.98rem;
    }
  }
  @media (max-width: 720px) {
    .og-header__inner {
      gap: 0.58rem 0.72rem;
      padding: 0.62rem 0.68rem 0.7rem;
    }
    .og-header__brand,
    .ogh-brand {
      gap: 9px;
      min-height: 38px;
    }
    .og-header__brand img,
    .ogh-brand img {
      width: 30px;
      height: 30px;
    }
    .og-header__brand span,
    .ogh-brand span {
      font-size: 0.93rem;
    }
    .og-header__link,
    .ogh-nav a {
      min-height: 34px;
      padding: 6px 9px;
      border-radius: 10px;
      font-size: 0.84rem;
    }
    .og-header__auth,
    .ogh-header-actions {
      gap: 0.42rem;
    }
    :global(.ogh-login-button),
    :global(.ogh-register-button),
    :global(.ogh-auth-secondary) {
      min-height: 38px;
      padding: 8px 11px;
      border-radius: 11px;
      font-size: 0.9rem;
    }
    .og-header__search :global(.global-search-box__form) {
      flex-direction: row;
      gap: 0.38rem;
      align-items: stretch;
    }
    .og-header__search :global(.global-search-box__input) {
      min-height: 40px;
    }
    .og-header__search :global(.global-search-box__button) {
      width: auto;
      min-width: 4.2rem;
      padding-inline: 0.88rem;
      min-height: 40px;
    }
  }
  @media (max-width: 420px) {
    .og-header__inner {
      gap: 0.52rem 0.62rem;
      padding: 0.58rem 0.58rem 0.66rem;
    }
    .og-header__brand img,
    .ogh-brand img {
      width: 28px;
      height: 28px;
    }
    .og-header__brand span,
    .ogh-brand span {
      font-size: 0.9rem;
    }
    .og-header__link,
    .ogh-nav a {
      min-height: 33px;
      padding: 6px 8px;
      font-size: 0.8rem;
    }
    :global(.ogh-login-button),
    :global(.ogh-register-button),
    :global(.ogh-auth-secondary) {
      min-height: 36px;
      padding: 7px 10px;
      font-size: 0.88rem;
    }
    .og-header__search :global(.global-search-box__input),
    .og-header__search :global(.global-search-box__button) {
      min-height: 38px;
    }
    .og-header__search :global(.global-search-box__button) {
      min-width: 3.9rem;
      padding-inline: 0.78rem;
    }
  }
  .og-header__link {min-height:44px;}
  @media(max-width:860px){
    .og-header__link,.ogh-nav a,:global(.ogh-login-button),:global(.ogh-register-button),:global(.ogh-auth-secondary),.og-header__search :global(.global-search-box__input),.og-header__search :global(.global-search-box__button){min-height:44px;}
  }
</style>
