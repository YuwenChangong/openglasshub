---
import AuthCTA from "../auth/AuthCTA";
import { inferNavKey, mainNav, type NavKey } from "../../lib/site-navigation";

interface Props {
  currentPath?: string;
  currentSection?: NavKey;
  next?: string;
}

const { currentPath = Astro.url.pathname, currentSection, next = currentPath } = Astro.props;
const activeKey = currentSection ?? inferNavKey(currentPath);
---

<header class="og-header">
  <div class="og-header__inner">
    <a href="/" class="og-header__brand" aria-label="OpenGlass Hub 首页">
      <img src="/brand/openglass-nav-logo.png" alt="" />
      <span>OpenGlass Hub</span>
    </a>

    <nav class="og-header__nav" aria-label="站点导航">
      {mainNav.map((item) => (
        <a href={item.href} class:list={["og-header__link", { "is-active": activeKey === item.key }]}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="og-header__auth">
      <AuthCTA next={next} compact={true} client:only="react" />
    </div>
  </div>
</header>

<style>
  .og-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid #20283a;
    background: rgba(9, 13, 22, 0.97);
    backdrop-filter: blur(18px);
  }
  .og-header__inner {
    width: 100%;
    max-width: none;
    min-height: 64px;
    margin: 0;
    padding: 0 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .og-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.82rem;
    text-decoration: none;
    color: #f8fafc;
    font-weight: 800;
    font-size: 1.08rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .og-header__brand img {
    width: 34px;
    height: 34px;
    object-fit: contain;
    image-rendering: -webkit-optimize-contrast;
    filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.06));
  }
  .og-header__nav {
    display: flex;
    align-items: center;
    gap: 0.18rem;
    min-width: 0;
    overflow-x: auto;
    flex: 1;
    justify-content: flex-start;
  }
  .og-header__link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 0.84rem;
    border-radius: 10px;
    color: #a5b3ce;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .og-header__link:hover,
  .og-header__link.is-active {
    color: #f8fafc;
    background: #131c2d;
  }
  .og-header__auth {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
  }
  @media (max-width: 900px) {
    .og-header__inner {
      min-height: auto;
      padding: 0.75rem 0.9rem;
      align-items: flex-start;
      flex-wrap: wrap;
    }
    .og-header__nav {
      order: 3;
      width: 100%;
      padding-bottom: 0.2rem;
    }
    .og-header__auth {
      margin-left: auto;
    }
    .og-header__brand span {
      font-size: 1rem;
    }
  }
</style>
