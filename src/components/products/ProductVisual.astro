---
interface Props {
  brandMark: string;
  title: string;
  categoryLabel: string;
  variant?: "card" | "hero";
  statusLabel?: string | null;
  highlights?: Array<{ label: string; value: string }>;
  placeholderType?: "glasses" | "headset" | "frame" | "wordmark";
}

const {
  brandMark,
  title,
  variant = "card",
  statusLabel = null,
  placeholderType = "glasses",
} = Astro.props;
---

<div class:list={["product-visual", `product-visual--${variant}`, `product-visual--${placeholderType}`]}>
  <div class="product-visual__shell">
    <span class="product-visual__glow" aria-hidden="true"></span>
    <span class="product-visual__gridline" aria-hidden="true"></span>

    <span class="product-visual__brand">{brandMark}</span>

    <div class="product-visual__copy">
      <p class="product-visual__title">{title}</p>
      {statusLabel ? <span class="product-visual__status">{statusLabel}</span> : null}
    </div>

    <div class="product-visual__base" aria-hidden="true">
      <span class="product-visual__rail"></span>
      <span class="product-visual__halo"></span>
    </div>
  </div>
</div>

<style>
  .product-visual {
    position: relative;
    overflow: hidden;
    min-width: 0;
    min-height: 100%;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background:
      radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.05), transparent 34%),
      linear-gradient(180deg, rgba(14, 17, 21, 0.98), rgba(9, 11, 15, 1));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    isolation: isolate;
  }

  .product-visual--card {
    min-height: 214px;
  }

  .product-visual--hero {
    min-height: 360px;
  }

  .product-visual__shell {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.9rem;
    min-height: inherit;
    height: 100%;
    padding: 1rem 1rem 1.05rem;
    border-radius: 17px;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 12%, rgba(255, 255, 255, 0.045), transparent 26%),
      linear-gradient(180deg, rgba(20, 24, 30, 0.98), rgba(10, 13, 17, 0.98));
  }

  .product-visual__glow,
  .product-visual__gridline,
  .product-visual__base,
  .product-visual__rail,
  .product-visual__halo {
    pointer-events: none;
  }

  .product-visual__glow {
    position: absolute;
    left: 50%;
    bottom: 12%;
    width: 74%;
    height: 46%;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(170, 186, 212, 0.12), transparent 68%);
    filter: blur(22px);
    opacity: 0.7;
  }

  .product-visual__gridline {
    position: absolute;
    left: 1rem;
    top: 3.1rem;
    right: 1rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent);
    opacity: 0.7;
  }

  .product-visual__brand {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    align-self: start;
    min-width: 0;
    color: rgba(245, 245, 247, 0.68);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: normal;
    text-wrap: balance;
  }

  .product-visual__status {
    display: inline-flex;
    align-items: center;
    min-height: 1.7rem;
    max-width: 100%;
    padding: 0 0.62rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    color: rgba(245, 245, 247, 0.66);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-visual__copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.45rem;
    align-content: end;
    justify-items: start;
    min-height: 0;
  }

  .product-visual__title {
    max-width: 11ch;
    margin: 0;
    color: #f8f8fa;
    font-size: 1.82rem;
    font-weight: 620;
    line-height: 0.94;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .product-visual--hero .product-visual__title {
    max-width: 9.5ch;
    font-size: 2.7rem;
  }

  .product-visual__status {
    color: rgba(245, 245, 247, 0.74);
  }

  .product-visual__base {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    min-height: 36px;
  }

  .product-visual__rail {
    width: 68%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.22), transparent);
  }

  .product-visual__halo {
    position: absolute;
    width: 36%;
    height: 28px;
    border-radius: 999px 999px 0 0;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-bottom: 0;
    opacity: 0.58;
  }

  @media (max-width: 720px) {
    .product-visual__shell {
      padding: 0.88rem 0.88rem 0.94rem;
    }

    .product-visual__gridline {
      left: 0.88rem;
      right: 0.88rem;
    }

    .product-visual__title {
      font-size: 1.5rem;
    }

    .product-visual--hero .product-visual__title {
      font-size: 2.05rem;
      max-width: none;
    }
  }
</style>
