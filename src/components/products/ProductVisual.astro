---
interface Props {
  brandMark: string;
  title: string;
  categoryLabel: string;
  variant?: "card" | "hero";
  statusLabel?: string | null;
  highlights?: Array<{ label: string; value: string }>;
  placeholderType?: "glasses" | "headset" | "frame" | "wordmark";
}

const {
  brandMark,
  title,
  variant = "card",
  placeholderType = "glasses",
} = Astro.props;
---

<div class:list={["product-visual", `product-visual--${variant}`, `product-visual--${placeholderType}`]}>
  <div class="product-visual__shell">
    <span class="product-visual__glow" aria-hidden="true"></span>
    <span class="product-visual__gridline" aria-hidden="true"></span>

    <span class="product-visual__brand">{brandMark}</span>

    <div class="product-visual__copy">
      <p class="product-visual__title">{title}</p>
    </div>

    <div class="product-visual__base" aria-hidden="true">
      <span class="product-visual__rail"></span>
      <span class="product-visual__halo"></span>
    </div>
  </div>
</div>

<style>
  .product-visual {
    position: relative;
    overflow: hidden;
    min-width: 0;
    min-height: 100%;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.055);
    background:
      radial-gradient(circle at 58% 10%, rgba(88, 145, 255, 0.14), transparent 32%),
      radial-gradient(circle at 12% 82%, rgba(30, 76, 166, 0.16), transparent 38%),
      linear-gradient(180deg, rgba(9, 18, 38, 0.98), rgba(4, 7, 13, 1));
    box-shadow: inset 0 1px 0 rgba(180, 210, 255, 0.055);
    isolation: isolate;
  }

  .product-visual--card {
    min-height: 214px;
  }

  .product-visual--hero {
    min-height: 360px;
  }

  .product-visual__shell {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.85rem;
    min-height: inherit;
    height: 100%;
    padding: 1rem 1rem 1.02rem;
    border-radius: 16px;
    overflow: hidden;
    background:
      radial-gradient(circle at 52% 4%, rgba(132, 174, 255, 0.11), transparent 28%),
      linear-gradient(180deg, rgba(10, 21, 45, 0.96), rgba(5, 9, 16, 0.99));
  }

  .product-visual__glow,
  .product-visual__gridline,
  .product-visual__base,
  .product-visual__rail,
  .product-visual__halo {
    pointer-events: none;
  }

  .product-visual__glow {
    position: absolute;
    left: 50%;
    bottom: 12%;
    width: 56%;
    height: 30%;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(112, 168, 255, 0.16), transparent 70%);
    filter: blur(18px);
    opacity: 0.34;
  }

  .product-visual__gridline {
    position: absolute;
    left: 1rem;
    top: 3rem;
    right: 1rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(128, 175, 255, 0.11), transparent);
    opacity: 0.5;
  }

  .product-visual__brand {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    align-self: start;
    min-width: 0;
    color: rgba(176, 203, 255, 0.58);
    font-size: 0.7rem;
    font-weight: 640;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: normal;
    text-wrap: balance;
  }

  .product-visual__copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.3rem;
    align-content: end;
    justify-items: start;
    min-height: 0;
  }

  .product-visual__title {
    max-width: 10.8ch;
    margin: 0;
    color: rgba(248, 251, 255, 0.98);
    font-size: 1.78rem;
    font-weight: 615;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .product-visual--hero .product-visual__title {
    max-width: 9ch;
    font-size: 2.85rem;
  }

  .product-visual__base {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    min-height: 32px;
  }

  .product-visual__rail {
    width: 64%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(146, 188, 255, 0.22), transparent);
  }

  .product-visual__halo {
    position: absolute;
    width: 32%;
    height: 24px;
    border-radius: 999px 999px 0 0;
    border: 1px solid rgba(132, 176, 255, 0.1);
    border-bottom: 0;
    opacity: 0.34;
  }

  @media (max-width: 720px) {
    .product-visual__shell {
      padding: 0.9rem 0.9rem 0.94rem;
    }

    .product-visual__gridline {
      left: 0.88rem;
      right: 0.88rem;
    }

    .product-visual__title {
      font-size: 1.56rem;
    }

    .product-visual--hero .product-visual__title {
      font-size: 2.14rem;
      max-width: none;
    }
  }
</style>
