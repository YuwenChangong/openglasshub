---
interface Props {
  imageUrl?: string | null;
  alt: string;
  brandMark: string;
  title: string;
  variant?: "card" | "hero";
}

const { imageUrl = null, alt, brandMark, title, variant = "card" } = Astro.props;
const hasImage = Boolean(imageUrl);
---

<div class:list={["product-visual", `product-visual--${variant}`, { "product-visual--with-image": hasImage, "product-visual--placeholder": !hasImage }]}>
  <span class="product-visual__glow product-visual__glow--top" aria-hidden="true"></span>
  <span class="product-visual__glow product-visual__glow--floor" aria-hidden="true"></span>
  <div class="product-visual__stage" aria-hidden="true">
    <span class="product-visual__mat" aria-hidden="true"></span>
    <div class="product-visual__placeholder" aria-hidden="true">
      <span class="product-visual__brand">{brandMark}</span>
      <span class="product-visual__shape product-visual__shape--left"></span>
      <span class="product-visual__shape product-visual__shape--bridge"></span>
      <span class="product-visual__shape product-visual__shape--right"></span>
    </div>
  </div>
  {imageUrl ? (
    <img
      src={imageUrl}
      alt={alt}
      loading="lazy"
      decoding="async"
      referrerpolicy="no-referrer"
      onerror="const root=this.closest('.product-visual'); if(root){root.classList.remove('product-visual--with-image'); root.classList.add('product-visual--placeholder','product-visual--image-error');} this.remove();"
    />
  ) : null}
  <span class="product-visual__title">{title}</span>
</div>

<style>
  .product-visual {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background:
      radial-gradient(circle at 50% 14%, rgba(132, 146, 178, 0.18), transparent 36%),
      radial-gradient(circle at 50% 78%, rgba(92, 103, 132, 0.12), transparent 32%),
      linear-gradient(180deg, rgba(13, 16, 20, 0.98), rgba(6, 8, 11, 1));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
    min-width: 0;
    isolation: isolate;
  }

  .product-visual--card {
    aspect-ratio: 4 / 3;
  }

  .product-visual--hero {
    aspect-ratio: 16 / 9;
  }

  .product-visual img,
  .product-visual__placeholder {
    width: 100%;
    height: 100%;
    display: block;
  }

  .product-visual__stage {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .product-visual img {
    position: absolute;
    inset: 0;
    z-index: 3;
    object-fit: contain;
    width: 82%;
    height: 82%;
    margin: auto;
    padding: 0;
    filter: drop-shadow(0 22px 40px rgba(0, 0, 0, 0.22)) brightness(1.04) contrast(1.01) saturate(1.01);
  }

  .product-visual__placeholder {
    position: relative;
    z-index: 2;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .product-visual--with-image .product-visual__placeholder {
    opacity: 0;
    transform: scale(0.985);
  }

  .product-visual__glow {
    position: absolute;
    inset: auto;
    pointer-events: none;
    z-index: 0;
  }

  .product-visual__glow--top {
    top: 0;
    left: 20%;
    width: 60%;
    height: 38%;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(208, 216, 235, 0.18), rgba(208, 216, 235, 0.05) 44%, transparent 74%);
    filter: blur(24px);
  }

  .product-visual__glow--floor {
    left: 22%;
    right: 22%;
    bottom: 10%;
    height: 12%;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(176, 186, 210, 0.16), rgba(176, 186, 210, 0.03) 46%, transparent 74%);
    filter: blur(20px);
  }

  .product-visual__mat {
    position: absolute;
    inset: 14% 17%;
    z-index: 1;
    border-radius: 24px;
    background: linear-gradient(180deg, rgba(243, 245, 248, 0.98), rgba(223, 228, 236, 0.94));
    opacity: 0.18;
    box-shadow:
      0 18px 44px rgba(0, 0, 0, 0.14),
      0 0 0 1px rgba(255, 255, 255, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.62);
  }

  .product-visual--placeholder .product-visual__mat {
    inset: 16% 18%;
    opacity: 0.16;
    box-shadow:
      0 18px 50px rgba(0, 0, 0, 0.15),
      0 0 0 1px rgba(255, 255, 255, 0.035),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .product-visual--with-image .product-visual__mat {
    opacity: 0.92;
  }

  .product-visual__brand {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 4;
    color: rgba(245, 245, 245, 0.3);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .product-visual__shape {
    position: absolute;
    top: 50%;
    height: clamp(3rem, 13%, 4rem);
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.02));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transform: translateY(-50%);
  }

  .product-visual__shape--left,
  .product-visual__shape--right {
    width: clamp(4.6rem, 24%, 7.5rem);
    border-radius: 999px;
  }

  .product-visual__shape--left {
    left: clamp(1rem, 10%, 4rem);
  }

  .product-visual__shape--right {
    right: clamp(1rem, 10%, 4rem);
  }

  .product-visual__shape--bridge {
    left: 50%;
    width: clamp(1rem, 6%, 1.5rem);
    height: 1px;
    transform: translate(-50%, -50%);
    background: rgba(255, 255, 255, 0.22);
    border: 0;
    box-shadow: none;
  }

  .product-visual__title {
    position: absolute;
    right: 1rem;
    bottom: 0.9rem;
    z-index: 4;
    color: rgba(245, 245, 245, 0.3);
    font-size: 0.74rem;
    font-weight: 600;
    text-align: right;
    max-width: 50%;
  }

  .product-visual--with-image .product-visual__title {
    color: rgba(245, 245, 245, 0.22);
  }
</style>
