---
interface Props {
  brandMark: string;
  title: string;
  categoryLabel: string;
  variant?: "card" | "hero";
  statusLabel?: string | null;
  highlights?: Array<{ label: string; value: string }>;
  placeholderType?: "glasses" | "headset" | "frame" | "wordmark";
}

const {
  brandMark,
  title,
  variant = "card",
  statusLabel = null,
  placeholderType = "glasses",
} = Astro.props;
---

<div class:list={["product-visual", `product-visual--${variant}`, `product-visual--${placeholderType}`]}>
  <div class="product-visual__shell">
    <span class="product-visual__glow" aria-hidden="true"></span>
    <span class="product-visual__gridline" aria-hidden="true"></span>

    <span class="product-visual__brand">{brandMark}</span>

    <div class="product-visual__copy">
      <p class="product-visual__title">{title}</p>
      {statusLabel ? <span class="product-visual__status">{statusLabel}</span> : null}
    </div>

    <div class="product-visual__base" aria-hidden="true">
      <span class="product-visual__rail"></span>
      <span class="product-visual__halo"></span>
    </div>
  </div>
</div>

<style>
  .product-visual {
    position: relative;
    overflow: hidden;
    min-width: 0;
    min-height: 100%;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background:
      radial-gradient(circle at 50% -10%, rgba(255, 255, 255, 0.045), transparent 34%),
      linear-gradient(180deg, rgba(15, 18, 22, 0.98), rgba(9, 11, 15, 1));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.045),
      0 18px 36px rgba(0, 0, 0, 0.18);
    isolation: isolate;
  }

  .product-visual--card {
    min-height: 204px;
  }

  .product-visual--hero {
    min-height: 360px;
  }

  .product-visual__shell {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.9rem;
    min-height: inherit;
    height: 100%;
    padding: 1rem 1rem 1.02rem;
    border-radius: 18px;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 6%, rgba(255, 255, 255, 0.03), transparent 24%),
      linear-gradient(180deg, rgba(21, 25, 31, 0.98), rgba(10, 13, 17, 0.985));
  }

  .product-visual__glow,
  .product-visual__gridline,
  .product-visual__base,
  .product-visual__rail,
  .product-visual__halo {
    pointer-events: none;
  }

  .product-visual__glow {
    position: absolute;
    left: 50%;
    bottom: 10%;
    width: 62%;
    height: 34%;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(180, 193, 214, 0.07), transparent 70%);
    filter: blur(22px);
    opacity: 0.42;
  }

  .product-visual__gridline {
    position: absolute;
    left: 1rem;
    top: 3.1rem;
    right: 1rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.07), transparent);
    opacity: 0.58;
  }

  .product-visual__brand {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    align-self: start;
    min-width: 0;
    color: rgba(245, 245, 247, 0.56);
    font-size: 0.7rem;
    font-weight: 640;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: normal;
    text-wrap: balance;
  }

  .product-visual__status {
    display: inline-flex;
    align-items: center;
    min-height: 1.7rem;
    max-width: 100%;
    padding: 0 0.62rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    color: rgba(245, 245, 247, 0.66);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-visual__copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.45rem;
    align-content: end;
    justify-items: start;
    min-height: 0;
  }

  .product-visual__title {
    max-width: 11.25ch;
    margin: 0;
    color: rgba(248, 248, 250, 0.98);
    font-size: 1.8rem;
    font-weight: 615;
    line-height: 0.92;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .product-visual--hero .product-visual__title {
    max-width: 9.5ch;
    font-size: 2.7rem;
  }

  .product-visual__status {
    color: rgba(245, 245, 247, 0.74);
  }

  .product-visual__base {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    min-height: 36px;
  }

  .product-visual__rail {
    width: 68%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  }

  .product-visual__halo {
    position: absolute;
    width: 36%;
    height: 28px;
    border-radius: 999px 999px 0 0;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 0;
    opacity: 0.46;
  }

  @media (max-width: 720px) {
    .product-visual__shell {
      padding: 0.82rem 0.82rem 0.9rem;
    }

    .product-visual__gridline {
      left: 0.88rem;
      right: 0.88rem;
    }

    .product-visual__title {
      font-size: 1.42rem;
    }

    .product-visual--hero .product-visual__title {
      font-size: 2.05rem;
      max-width: none;
    }
  }
</style>
