---
interface Props {
  brandMark: string;
  title: string;
  categoryLabel: string;
  variant?: "card" | "hero";
  statusLabel?: string | null;
  highlights?: Array<{ label: string; value: string }>;
  placeholderType?: "glasses" | "headset" | "frame" | "wordmark";
}

const {
  brandMark,
  title,
  categoryLabel,
  variant = "card",
  statusLabel = null,
  placeholderType = "glasses",
} = Astro.props;
---

<div class:list={["product-visual", `product-visual--${variant}`, `product-visual--${placeholderType}`]}>
  <div class="product-visual__shell">
    <span class="product-visual__glow" aria-hidden="true"></span>

    <div class="product-visual__topline">
      <span class="product-visual__brand">{brandMark}</span>
      <span class="product-visual__pill">{categoryLabel}</span>
    </div>

    <div class="product-visual__copy">
      <p class="product-visual__title">{title}</p>
      {statusLabel ? <span class="product-visual__status">{statusLabel}</span> : null}
    </div>

    <div class="product-visual__base" aria-hidden="true">
      <span class="product-visual__rail"></span>
      <span class="product-visual__halo"></span>
    </div>
  </div>
</div>

<style>
  .product-visual {
    position: relative;
    overflow: hidden;
    min-width: 0;
    min-height: 100%;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background:
      radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.08), transparent 34%),
      linear-gradient(180deg, rgba(18, 22, 28, 0.98), rgba(9, 11, 15, 1));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    isolation: isolate;
  }

  .product-visual--card {
    min-height: 214px;
  }

  .product-visual--hero {
    min-height: 360px;
  }

  .product-visual__shell {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1rem;
    min-height: inherit;
    height: 100%;
    padding: 1rem;
    border-radius: 22px;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 12%, rgba(255, 255, 255, 0.06), transparent 28%),
      linear-gradient(180deg, rgba(24, 29, 36, 0.98), rgba(10, 13, 17, 0.98));
  }

  .product-visual__glow,
  .product-visual__base,
  .product-visual__rail,
  .product-visual__halo {
    pointer-events: none;
  }

  .product-visual__glow {
    position: absolute;
    left: 50%;
    bottom: 12%;
    width: 70%;
    height: 50%;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(174, 194, 228, 0.14), transparent 68%);
    filter: blur(18px);
    opacity: 0.9;
  }

  .product-visual__topline {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
  }

  .product-visual__brand {
    min-width: 0;
    color: rgba(245, 245, 247, 0.76);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-visual__pill,
  .product-visual__status {
    display: inline-flex;
    align-items: center;
    min-height: 1.8rem;
    max-width: 100%;
    padding: 0 0.68rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.03);
    color: rgba(245, 245, 247, 0.7);
    font-size: 0.74rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-visual__copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.62rem;
    align-content: center;
    justify-items: start;
    min-height: 0;
  }

  .product-visual__title {
    max-width: 11ch;
    margin: 0;
    color: #f8f8fa;
    font-size: 1.82rem;
    font-weight: 600;
    line-height: 0.96;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .product-visual--hero .product-visual__title {
    max-width: 10ch;
    font-size: 2.9rem;
  }

  .product-visual__status {
    color: rgba(245, 245, 247, 0.82);
  }

  .product-visual__base {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    min-height: 48px;
  }

  .product-visual__rail {
    width: 72%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.36), transparent);
  }

  .product-visual__halo {
    position: absolute;
    width: 40%;
    height: 34px;
    border-radius: 999px 999px 0 0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 0;
    opacity: 0.75;
  }

  @media (max-width: 720px) {
    .product-visual__shell {
      padding: 0.9rem;
    }

    .product-visual__title {
      font-size: 1.58rem;
    }

    .product-visual--hero .product-visual__title {
      font-size: 2.15rem;
      max-width: none;
    }
  }
</style>
