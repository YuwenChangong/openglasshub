---
interface Props {
  brandMark: string;
  title: string;
  categoryLabel: string;
  variant?: "card" | "hero";
  statusLabel?: string | null;
  highlights?: Array<{ label: string; value: string }>;
  placeholderType?: "glasses" | "headset" | "frame" | "wordmark";
}

const {
  brandMark,
  title,
  categoryLabel,
  variant = "card",
  statusLabel = null,
  highlights = [],
  placeholderType = "glasses",
} = Astro.props;

const visibleHighlights = highlights.slice(0, variant === "hero" ? 3 : 2);
---

<div class:list={["product-visual", `product-visual--${variant}`, `product-visual--${placeholderType}`]}>
  <div class="product-visual__shell">
    <span class="product-visual__brand">{brandMark}</span>
    <div class="product-visual__copy">
      <span class="product-visual__type">{categoryLabel}</span>
      <h2>{title}</h2>
      {statusLabel && <span class="product-visual__status">{statusLabel}</span>}
    </div>
    <div class="product-visual__grid" aria-hidden="true"></div>
    <span class="product-visual__outline product-visual__outline--glasses"></span>
    <span class="product-visual__outline product-visual__outline--headset"></span>
    <span class="product-visual__outline product-visual__outline--frame"></span>
    {visibleHighlights.length > 0 && (
      <div class="product-visual__highlights">
        {visibleHighlights.map((item) => (
          <article>
            <span>{item.label}</span>
            <strong>{item.value}</strong>
          </article>
        ))}
      </div>
    )}
  </div>
</div>

<style>
  .product-visual {
    position: relative;
    overflow: hidden;
    min-width: 0;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background:
      radial-gradient(circle at top, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0) 32%),
      linear-gradient(180deg, rgba(14, 17, 21, 0.98), rgba(8, 10, 13, 1));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
    isolation: isolate;
  }

  .product-visual--card {
    aspect-ratio: 4 / 3;
  }

  .product-visual--hero {
    aspect-ratio: 16 / 9;
  }

  .product-visual__shell {
    position: absolute;
    inset: 0.95rem;
    display: grid;
    align-content: space-between;
    gap: 0.8rem;
    padding: 1rem;
    border-radius: 16px;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(22, 25, 30, 0.98), rgba(11, 13, 16, 1)),
      linear-gradient(135deg, rgba(255, 255, 255, 0.02), transparent 55%);
    border: 1px solid rgba(255, 255, 255, 0.035);
  }

  .product-visual__brand,
  .product-visual__type,
  .product-visual__status,
  .product-visual__highlights span {
    font-size: 0.76rem;
    line-height: 1.2;
  }

  .product-visual__brand {
    position: relative;
    z-index: 2;
    color: rgba(244, 244, 245, 0.68);
    font-weight: 720;
    letter-spacing: -0.025em;
  }

  .product-visual__copy {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.34rem;
    align-content: center;
    max-width: 22rem;
  }

  .product-visual__type {
    width: fit-content;
    padding: 0.2rem 0.48rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.03);
    color: rgba(244, 244, 245, 0.62);
  }

  .product-visual__copy h2 {
    margin: 0;
    color: #f5f5f5;
    font-size: 1.34rem;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .product-visual--hero .product-visual__copy h2 {
    font-size: 2rem;
  }

  .product-visual__status {
    width: fit-content;
    color: rgba(244, 244, 245, 0.72);
  }

  .product-visual__grid {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.34), transparent 70%);
    opacity: 0.22;
  }

  .product-visual__outline {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  .product-visual--glasses .product-visual__outline--glasses,
  .product-visual--frame .product-visual__outline--frame,
  .product-visual--headset .product-visual__outline--headset,
  .product-visual--wordmark .product-visual__outline--frame {
    opacity: 1;
  }

  .product-visual__outline--glasses::before,
  .product-visual__outline--glasses::after,
  .product-visual__outline--frame::before,
  .product-visual__outline--frame::after,
  .product-visual__outline--headset::before {
    content: "";
    position: absolute;
  }

  .product-visual__outline--glasses::before,
  .product-visual__outline--glasses::after,
  .product-visual__outline--frame::before,
  .product-visual__outline--frame::after {
    top: 50%;
    width: 26%;
    height: 16%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    transform: translateY(-50%);
  }

  .product-visual__outline--glasses::before,
  .product-visual__outline--frame::before {
    left: 14%;
  }

  .product-visual__outline--glasses::after,
  .product-visual__outline--frame::after {
    right: 14%;
  }

  .product-visual__outline--frame::before,
  .product-visual__outline--frame::after {
    width: 22%;
    height: 12%;
  }

  .product-visual__outline--headset::before {
    inset: 26% 18%;
    border-radius: 26px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: linear-gradient(180deg, rgba(102, 108, 120, 0.3), rgba(39, 43, 49, 0.14));
  }

  .product-visual__highlights {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(88px, 1fr));
    gap: 0.5rem;
  }

  .product-visual__highlights article {
    display: grid;
    gap: 0.18rem;
    padding-top: 0.55rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .product-visual__highlights span {
    color: rgba(244, 244, 245, 0.46);
  }

  .product-visual__highlights strong {
    color: rgba(245, 245, 245, 0.92);
    font-size: 0.92rem;
    line-height: 1.3;
  }

  @media (max-width: 720px) {
    .product-visual__shell {
      inset: 0.8rem;
      padding: 0.9rem;
    }

    .product-visual--hero .product-visual__copy h2 {
      font-size: 1.55rem;
    }

    .product-visual__highlights {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
