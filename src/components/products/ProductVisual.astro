---
interface Props {
  imageUrl?: string | null;
  alt: string;
  brandMark: string;
  title: string;
  variant?: "card" | "hero";
  imageBackground?: "light" | "dark" | "transparent";
  imageFit?: "contain" | "cover";
  placeholderType?: "glasses" | "headset" | "frame" | "wordmark";
}

const {
  imageUrl = null,
  alt,
  brandMark,
  title,
  variant = "card",
  imageBackground = "light",
  imageFit = "contain",
  placeholderType = "glasses",
} = Astro.props;
const hasImage = Boolean(imageUrl);
---

<div
  class:list={[
    "product-visual",
    `product-visual--${variant}`,
    `product-visual--${imageBackground}`,
    `product-visual--${placeholderType}`,
    { "product-visual--with-image": hasImage, "product-visual--placeholder": !hasImage },
  ]}
>
  <div class="product-visual__stage" aria-hidden="true">
    {imageUrl ? (
      <div class="product-visual__image-shell">
        <img
          src={imageUrl}
          alt={alt}
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          style={`object-fit:${imageFit};`}
          onerror="const root=this.closest('.product-visual'); if(root){root.classList.remove('product-visual--with-image'); root.classList.add('product-visual--placeholder','product-visual--image-error');} this.remove();"
        />
      </div>
    ) : null}
    <div class="product-visual__placeholder" aria-hidden="true">
      <span class="product-visual__brand">{brandMark}</span>
      <span class="product-visual__outline product-visual__outline--glasses"></span>
      <span class="product-visual__outline product-visual__outline--headset"></span>
      <span class="product-visual__outline product-visual__outline--frame"></span>
      <span class="product-visual__title">{title}</span>
    </div>
  </div>
</div>

<style>
  .product-visual {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.055);
    background: linear-gradient(180deg, rgba(11, 14, 18, 0.96), rgba(7, 9, 12, 0.98));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.025);
    min-width: 0;
    isolation: isolate;
  }

  .product-visual--card {
    aspect-ratio: 4 / 3;
  }

  .product-visual--hero {
    aspect-ratio: 16 / 9;
  }

  .product-visual img,
  .product-visual__placeholder {
    display: block;
  }

  .product-visual__stage {
    position: relative;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(9, 11, 14, 0.98), rgba(6, 8, 10, 0.98));
  }

  .product-visual__image-shell,
  .product-visual__placeholder {
    position: absolute;
    inset: 0.95rem;
    border-radius: 16px;
  }

  .product-visual__image-shell {
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.028);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.16);
    z-index: 2;
  }

  .product-visual img {
    width: auto;
    height: auto;
    max-width: 82%;
    max-height: 74%;
    margin: auto;
    filter: drop-shadow(0 12px 22px rgba(0, 0, 0, 0.14));
  }

  .product-visual--hero img {
    max-width: 70%;
    max-height: 68%;
  }

  .product-visual--light .product-visual__image-shell {
    background:
      radial-gradient(circle at 50% 36%, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.015) 52%, rgba(10, 12, 15, 0) 76%),
      linear-gradient(180deg, rgba(22, 24, 28, 0.94), rgba(10, 12, 15, 0.98));
  }

  .product-visual--dark .product-visual__image-shell {
    background: linear-gradient(180deg, rgba(28, 31, 37, 0.94), rgba(11, 13, 16, 0.98));
  }

  .product-visual--transparent .product-visual__image-shell {
    background:
      radial-gradient(circle at 50% 34%, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.015) 42%, rgba(15, 17, 22, 0.98) 84%),
      linear-gradient(180deg, rgba(20, 22, 28, 0.96), rgba(10, 12, 15, 0.99));
  }

  .product-visual__placeholder {
    z-index: 1;
    background:
      radial-gradient(circle at 50% 38%, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.01) 42%, rgba(8, 10, 13, 0.98) 82%),
      linear-gradient(180deg, rgba(11, 13, 17, 0.96), rgba(7, 9, 12, 0.99));
    border: 1px solid rgba(255, 255, 255, 0.035);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.025);
  }

  .product-visual--with-image .product-visual__placeholder {
    opacity: 0;
    pointer-events: none;
  }

  .product-visual__brand {
    position: absolute;
    top: 1.05rem;
    left: 1.05rem;
    z-index: 3;
    color: rgba(244, 244, 245, 0.5);
    font-size: 0.78rem;
    font-weight: 780;
    letter-spacing: -0.03em;
  }

  .product-visual__outline {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .product-visual--glasses .product-visual__outline--glasses,
  .product-visual--frame .product-visual__outline--frame,
  .product-visual--headset .product-visual__outline--headset,
  .product-visual--wordmark .product-visual__outline--frame {
    opacity: 1;
  }

  .product-visual__outline--glasses::before,
  .product-visual__outline--glasses::after,
  .product-visual__outline--headset::before,
  .product-visual__outline--headset::after,
  .product-visual__outline--frame::before,
  .product-visual__outline--frame::after {
    content: "";
    position: absolute;
  }

  .product-visual__outline--glasses::before,
  .product-visual__outline--glasses::after,
  .product-visual__outline--frame::before,
  .product-visual__outline--frame::after {
    top: 48%;
    width: 26%;
    height: 18%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    transform: translateY(-50%);
  }

  .product-visual__outline--glasses::before,
  .product-visual__outline--frame::before {
    left: 14%;
  }

  .product-visual__outline--glasses::after,
  .product-visual__outline--frame::after {
    right: 14%;
  }

  .product-visual--frame .product-visual__outline--frame::before,
  .product-visual--frame .product-visual__outline--frame::after {
    width: 22%;
    height: 14%;
  }

  .product-visual__outline--headset::before {
    top: 18%;
    left: 15%;
    right: 15%;
    bottom: 18%;
    border-radius: 24px;
    background: linear-gradient(180deg, rgba(115, 121, 134, 0.62), rgba(56, 61, 72, 0.72));
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 14px 28px rgba(0, 0, 0, 0.2);
  }

  .product-visual__outline--headset::after {
    left: 50%;
    top: 48%;
    width: 1.25rem;
    height: 1px;
    transform: translate(-50%, -50%);
    background: rgba(255, 255, 255, 0.18);
  }

  .product-visual__title {
    position: absolute;
    right: 1rem;
    bottom: 0.9rem;
    z-index: 3;
    color: rgba(245, 245, 245, 0.34);
    font-size: 0.74rem;
    font-weight: 600;
    text-align: right;
    max-width: 50%;
  }

  .product-visual--hero .product-visual__image-shell,
  .product-visual--hero .product-visual__placeholder {
    inset: 1.15rem;
  }

  @media (max-width: 720px) {
    .product-visual__image-shell,
    .product-visual__placeholder {
      inset: 0.78rem;
    }

    .product-visual img {
      max-width: 84%;
      max-height: 72%;
    }

    .product-visual--hero img {
      max-width: 78%;
      max-height: 66%;
    }
  }
</style>
