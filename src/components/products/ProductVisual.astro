---
interface Props {
  imageUrl?: string | null;
  alt: string;
  brandMark: string;
  title: string;
  variant?: "card" | "hero";
}

const { imageUrl = null, alt, brandMark, title, variant = "card" } = Astro.props;
---

<div class:list={["product-visual", `product-visual--${variant}`]}>
  <span class="product-visual__glow product-visual__glow--top" aria-hidden="true"></span>
  <span class="product-visual__glow product-visual__glow--floor" aria-hidden="true"></span>
  <div class="product-visual__placeholder" aria-hidden="true">
    <span class="product-visual__brand">{brandMark}</span>
    <span class="product-visual__shape product-visual__shape--left"></span>
    <span class="product-visual__shape product-visual__shape--bridge"></span>
    <span class="product-visual__shape product-visual__shape--right"></span>
  </div>
  {imageUrl ? (
    <img src={imageUrl} alt={alt} loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.opacity='0'" />
  ) : null}
  <span class="product-visual__title">{title}</span>
</div>

<style>
  .product-visual {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background:
      radial-gradient(circle at 50% 18%, rgba(120, 149, 198, 0.24), transparent 38%),
      radial-gradient(circle at 50% 78%, rgba(76, 96, 138, 0.18), transparent 34%),
      linear-gradient(180deg, rgba(13, 16, 20, 0.98), rgba(6, 8, 11, 1));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    min-width: 0;
    isolation: isolate;
  }

  .product-visual--card {
    aspect-ratio: 16 / 10;
  }

  .product-visual--hero {
    aspect-ratio: 16 / 9;
  }

  .product-visual img,
  .product-visual__placeholder {
    width: 100%;
    height: 100%;
    display: block;
  }

  .product-visual img {
    position: absolute;
    inset: 0;
    z-index: 2;
    object-fit: contain;
    padding: clamp(0.85rem, 2.2vw, 1.5rem);
    filter: drop-shadow(0 18px 32px rgba(0, 0, 0, 0.34)) brightness(1.16) contrast(1.08) saturate(1.04);
  }

  .product-visual__placeholder {
    position: relative;
    z-index: 1;
  }

  .product-visual__glow {
    position: absolute;
    inset: auto;
    pointer-events: none;
    z-index: 0;
  }

  .product-visual__glow--top {
    top: -8%;
    left: 12%;
    width: 76%;
    height: 50%;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(162, 192, 255, 0.16), rgba(162, 192, 255, 0.04) 42%, transparent 72%);
    filter: blur(24px);
  }

  .product-visual__glow--floor {
    left: 16%;
    right: 16%;
    bottom: 8%;
    height: 16%;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(136, 156, 198, 0.22), rgba(136, 156, 198, 0.05) 46%, transparent 74%);
    filter: blur(20px);
  }

  .product-visual__brand {
    position: absolute;
    top: 1rem;
    left: 1rem;
    color: rgba(245, 245, 245, 0.34);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .product-visual__shape {
    position: absolute;
    top: 50%;
    height: clamp(3rem, 13%, 4rem);
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.025));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 0 0 1px rgba(255, 255, 255, 0.01);
    transform: translateY(-50%);
  }

  .product-visual__shape--left,
  .product-visual__shape--right {
    width: clamp(4.6rem, 24%, 7.5rem);
    border-radius: 999px;
  }

  .product-visual__shape--left {
    left: clamp(1rem, 10%, 4rem);
  }

  .product-visual__shape--right {
    right: clamp(1rem, 10%, 4rem);
  }

  .product-visual__shape--bridge {
    left: 50%;
    width: clamp(1rem, 6%, 1.5rem);
    height: 1px;
    transform: translate(-50%, -50%);
    background: rgba(255, 255, 255, 0.22);
    border: 0;
    box-shadow: none;
  }

  .product-visual__title {
    position: absolute;
    right: 1rem;
    bottom: 0.9rem;
    z-index: 3;
    color: rgba(245, 245, 245, 0.34);
    font-size: 0.74rem;
    font-weight: 600;
    text-align: right;
    max-width: 50%;
  }
</style>
