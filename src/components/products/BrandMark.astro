---
interface Props {
  text?: string;
  logo?: {
    type: "image" | "wordmark";
    src?: string;
    text: string;
    alt: string;
  };
  tone?: "default" | "accent" | "neutral";
  compact?: boolean;
  brandKey?: string;
}

const { text, logo, tone = "default", compact = false, brandKey = "" } = Astro.props;
const resolvedText = logo?.text ?? text ?? "";
---

{logo?.type === "image" && logo.src ? (
  <span class:list={["brand-mark", `brand-mark--${tone}`, { "brand-mark--compact": compact, "brand-mark--image": true }]} data-brand={brandKey}>
    <img
      src={logo.src}
      alt={logo.alt}
      loading="lazy"
      decoding="async"
      referrerpolicy="no-referrer"
      onerror="const root=this.closest('.brand-mark'); if(root){root.classList.add('brand-mark--fallback');} this.remove();"
    />
    <span class="brand-mark__fallback" aria-hidden="true">{resolvedText}</span>
  </span>
) : (
  <span
    class:list={["brand-mark", `brand-mark--${tone}`, { "brand-mark--compact": compact, "brand-mark--wordmark": true }]}
    data-brand={brandKey}
    aria-label={logo?.alt ?? resolvedText}
  >
    {resolvedText}
  </span>
)}

<style>
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    width: fit-content;
    min-height: 2rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: rgba(246, 247, 249, 0.96);
    font-size: 1.2rem;
    font-weight: 780;
    letter-spacing: -0.038em;
    line-height: 1;
    white-space: nowrap;
    text-transform: none;
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.025);
  }

  .brand-mark img {
    display: block;
    max-width: 100%;
    max-height: 2rem;
    object-fit: contain;
  }

  .brand-mark__fallback {
    display: none;
  }

  .brand-mark--fallback .brand-mark__fallback {
    display: inline-flex;
    align-items: center;
  }

  .brand-mark--accent {
    color: #fafbfc;
  }

  .brand-mark--neutral {
    color: rgba(245, 245, 245, 0.9);
  }

  .brand-mark--compact {
    min-height: 1.4rem;
    font-size: 0.88rem;
    letter-spacing: -0.03em;
  }

  .brand-mark[data-brand="xreal"] {
    font-weight: 820;
    letter-spacing: -0.052em;
  }

  .brand-mark[data-brand="rayneo"] {
    font-weight: 760;
    letter-spacing: -0.05em;
  }

  .brand-mark[data-brand="rokid"] {
    font-weight: 760;
    letter-spacing: -0.04em;
  }

  .brand-mark[data-brand="viture"],
  .brand-mark[data-brand="inmo"],
  .brand-mark[data-brand="meta"],
  .brand-mark[data-brand="frame"] {
    text-transform: uppercase;
    letter-spacing: -0.028em;
  }

  .brand-mark[data-brand="viture"] {
    letter-spacing: 0.01em;
    font-weight: 760;
  }

  .brand-mark[data-brand="g1"] {
    letter-spacing: -0.055em;
    font-weight: 820;
  }

  .brand-mark[data-brand="vision"] {
    font-weight: 700;
    letter-spacing: -0.045em;
  }
</style>
