---
interface Props {
  text: string;
  tone?: "default" | "accent" | "neutral";
  compact?: boolean;
}

const { text, tone = "default", compact = false } = Astro.props;
---

<span class:list={["brand-mark", `brand-mark--${tone}`, { "brand-mark--compact": compact }]}>{text}</span>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    width: fit-content;
    min-height: 2rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: rgba(246, 247, 249, 0.96);
    font-size: 1.16rem;
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1;
    white-space: nowrap;
    text-transform: none;
    text-shadow: 0 0 18px rgba(255, 255, 255, 0.03);
  }

  .brand-mark--accent {
    color: #fafbfc;
  }

  .brand-mark--neutral {
    color: rgba(245, 245, 245, 0.9);
  }

  .brand-mark--compact {
    min-height: 1.4rem;
    font-size: 0.88rem;
    letter-spacing: -0.03em;
  }
</style>
