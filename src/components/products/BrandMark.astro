---
interface Props {
  text?: string;
  logo?: {
    type: "image" | "wordmark";
    src?: string;
    text: string;
    alt: string;
  };
  tone?: "default" | "accent" | "neutral";
  compact?: boolean;
  brandKey?: string;
}

const { text, logo, tone = "default", compact = false, brandKey = "" } = Astro.props;
const resolvedText = (logo?.text ?? text ?? "").trim();
---

<span
  class:list={["brand-mark", `brand-mark--${tone}`, { "brand-mark--compact": compact }]}
  data-brand={brandKey}
  aria-label={logo?.alt ?? resolvedText}
>
  {resolvedText}
</span>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    width: fit-content;
    min-height: 2rem;
    color: rgba(247, 247, 248, 0.96);
    font-size: 1.22rem;
    font-weight: 760;
    letter-spacing: -0.035em;
    line-height: 1;
    white-space: nowrap;
    text-transform: none;
  }

  .brand-mark--accent {
    color: #fafbfc;
  }

  .brand-mark--neutral {
    color: rgba(245, 245, 245, 0.88);
  }

  .brand-mark--compact {
    min-height: 1.3rem;
    font-size: 0.92rem;
    letter-spacing: -0.025em;
  }

  .brand-mark[data-brand="xreal"] {
    font-weight: 820;
    letter-spacing: -0.052em;
  }

  .brand-mark[data-brand="rayneo"] {
    font-weight: 740;
    letter-spacing: -0.045em;
  }

  .brand-mark[data-brand="rokid"] {
    font-weight: 760;
    letter-spacing: -0.05em;
  }

  .brand-mark[data-brand="viture"],
  .brand-mark[data-brand="inmo"] {
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-weight: 720;
  }

  .brand-mark[data-brand="meta"] {
    letter-spacing: -0.022em;
    font-weight: 720;
  }

  .brand-mark[data-brand="brilliant-labs"] {
    font-weight: 700;
    letter-spacing: -0.028em;
  }

  .brand-mark[data-brand="even-realities"] {
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .brand-mark[data-brand="apple"] {
    font-weight: 700;
    letter-spacing: -0.04em;
  }
</style>
