---
import CommunityLayout from "../../layouts/CommunityLayout.astro";
import { LEGAL_POLICY, LEGAL_POLICY_LINKS } from "../../lib/legal-policy";
import { PUBLIC_LEGAL_CONTACTS } from "../../lib/public-legal-contacts";
import { resolveDocumentLocale } from "../../lib/i18n/document-locale";
import { getUiMessages, formatUiMessage } from "../../lib/i18n/catalog";

interface Props {
  pageTitle: string;
  description: string;
  routeKey: "terms" | "privacy" | "guidelines" | "safety" | "accountDeletion" | "contact" | "consent";
  version: string;
  headingZh: string;
  headingEn: string;
  zh: string;
  en: string;
  noindex?: boolean;
  showPublicContacts?: boolean;
}

const {
  pageTitle,
  description,
  routeKey,
  version,
  headingZh,
  headingEn,
  zh,
  en,
  noindex = false,
  showPublicContacts = false,
} = Astro.props;
const uiLocale = Astro.locals.localeContext.locale;
const documentLocale = resolveDocumentLocale(Astro.url.searchParams.get("lang"), uiLocale);
const text = getUiMessages(uiLocale).documents;
function languageHref(locale: "zh-CN" | "en") {
  const url = new URL(Astro.url);
  url.searchParams.set("lang", locale);
  return url.pathname + url.search;
}
---
<CommunityLayout
  title={pageTitle}
  description={description}
  canonical={Astro.url.pathname}
  pageClass="legal-shell"
  noindex={noindex}
>
  <article class="legal-page">
    <nav class="legal-page__policy-nav" aria-label={text.policyNavigation}>
      {
        LEGAL_POLICY_LINKS.map((link) => (
          <a href={link.href} aria-current={routeKey === link.key ? "page" : undefined}>
            <span>{uiLocale === "en" ? link.labelEn : link.labelZh}</span>
          </a>
        ))
      }
    </nav>
    <div class="legal-page__meta-row">
      <p class="legal-page__meta">{formatUiMessage(text.version, { version, date: LEGAL_POLICY.effectiveDate })}</p>
    </div>
    <nav class="legal-page__language-nav" aria-label={text.languageNavigation}>
      <a href={languageHref("zh-CN")} lang="zh-CN" aria-current={documentLocale === "zh-CN" ? "true" : undefined}>中文</a>
      <a href={languageHref("en")} lang="en" aria-current={documentLocale === "en" ? "true" : undefined}>English</a>
    </nav>
    {
      showPublicContacts && (
        <aside class="legal-page__contacts" aria-label={text.publicContacts}>
          <h2>{text.publicContacts}</h2>
          <ul>
            <li><strong>{text.operator}</strong> {PUBLIC_LEGAL_CONTACTS.operator}</li>
            <li><strong>{text.support}</strong> <a href={`mailto:${PUBLIC_LEGAL_CONTACTS.support}`}>{PUBLIC_LEGAL_CONTACTS.support}</a></li>
            <li><strong>{text.abuse}</strong> <a href={`mailto:${PUBLIC_LEGAL_CONTACTS.abuse}`}>{PUBLIC_LEGAL_CONTACTS.abuse}</a></li>
            <li><strong>{text.privacyRequests}</strong> <a href={`mailto:${PUBLIC_LEGAL_CONTACTS.privacy}`}>{PUBLIC_LEGAL_CONTACTS.privacy}</a></li>
            <li><strong>{text.intellectualProperty}</strong> <a href={`mailto:${PUBLIC_LEGAL_CONTACTS.intellectualProperty}`}>{PUBLIC_LEGAL_CONTACTS.intellectualProperty}</a></li>
          </ul>
        </aside>
      )
    }
    <section id={documentLocale === "en" ? "legal-en" : "legal-zh"} class="legal-page__section" lang={documentLocale} aria-labelledby="legal-heading">
      <h1 id="legal-heading">{documentLocale === "en" ? headingEn : headingZh}</h1>
      <Fragment set:html={documentLocale === "en" ? en : zh} />
    </section>
  </article>
</CommunityLayout>
<style>
  .legal-page {
    width: min(100%, 860px);
    margin: 2rem auto 4rem;
    padding: clamp(1rem, 3vw, 2rem);
    background: rgba(18, 31, 48, 0.72);
    border: 1px solid rgba(156, 194, 231, 0.16);
    border-radius: 8px;
    line-height: 1.75;
  }

  .legal-page__policy-nav,
  .legal-page__language-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .legal-page__policy-nav a,
  .legal-page__language-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .legal-page__policy-nav a[aria-current="page"] {
    color: #f2f4f5;
  }

  .legal-page__meta-row {
    display: grid;
    gap: 0.2rem;
    margin: 1rem 0;
  }

  .legal-page__meta {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .legal-page__contacts {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid rgba(156, 194, 231, 0.16);
    background: rgba(9, 18, 30, 0.3);
  }

  .legal-page__contacts h2 {
    margin: 0 0 0.65rem;
    font-size: 1rem;
  }

  .legal-page__contacts ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .legal-page__contacts h2 + ul + h2 {
    margin-top: 1rem;
  }

  .legal-page__section + .legal-page__section {
    margin-top: 3rem;
  }

  .legal-page h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.7rem, 3vw, 2.25rem);
  }

  .legal-page h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
  }

  .legal-page h3 {
    margin-top: 1.7rem;
  }

  .legal-page :global(a) {
    color: #8fc6ff;
  }

  @media (max-width: 640px) {
    .legal-page {
      margin-top: 1.5rem;
      margin-bottom: 3rem;
      padding: 1rem;
    }
  }
</style>
