---
const updates = [
  {
    date: '2026-05-17',
    title: 'OpenGlass Hub 正式上线',
    description: 'OpenGlass Hub MVP 版本发布，包含 12 款 AR/AI 眼镜产品详情页。',
    link: '/devices',
  },
  {
    date: '2026-05-17',
    title: 'Gaze Launcher 启动',
    description: 'Gaze Launcher 定位页面上线，说明面向 AR/AI 眼镜的主入口与交互方向。',
    link: '/gaze-os',
  },
];
---

<section class="latest-updates">
  <h2>最新动态</h2>
  <div class="updates-list">
    {updates.map((item) => (
      <a href={item.link} class="update-item">
        <span class="update-date">{item.date}</span>
        <h3 class="update-title">{item.title}</h3>
        <p class="update-desc">{item.description}</p>
      </a>
    ))}
  </div>
</section>

<style>
  .latest-updates {
    margin: 2rem 0;
  }
  .latest-updates h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }
  .updates-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .update-item {
    display: block;
    padding: 1rem 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .update-item:hover {
    border-color: var(--sl-color-accent);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .update-date {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }
  .update-title {
    margin: 0.25rem 0;
    font-size: 1.1rem;
  }
  .update-desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
  }
</style>

