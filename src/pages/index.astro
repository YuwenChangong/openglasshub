---
export const prerender = false;

import CommunityLayout from "../layouts/CommunityLayout.astro";
import AuthCTA from "../components/auth/AuthCTA";
import PostCard from "../components/community/PostCard.astro";
import EmptyFeedState from "../components/community/EmptyFeedState.astro";
import NewsCard from "../components/community/NewsCard.astro";
import CircleCard from "../components/community/CircleCard.astro";
import ProductCard from "../components/community/ProductCard.astro";
import { createSSRClient, type CloudflareEnv } from "../lib/supabase-server";
import { curatedNews } from "../lib/news";
import { isPublicVisibleCircle, productLinks } from "../lib/site-navigation";

type PostRow = {
  id: string;
  title: string;
  body?: string | null;
  type?: string | null;
  created_at: string;
  last_activity_at?: string | null;
  profiles?: { display_name?: string | null; username?: string | null } | null;
  circles?: { slug?: string | null; name?: string | null } | null;
};

type CircleRow = {
  slug: string;
  name: string;
  description?: string | null;
};

const env = (Astro.locals as { runtime?: { env?: CloudflareEnv } }).runtime?.env;
const supabase = env?.SUPABASE_URL && env?.SUPABASE_ANON_KEY ? createSSRClient(env) : null;

let posts: PostRow[] = [];
let circles: CircleRow[] = [];
let loadError = "";

const circleOrder = ["xreal", "rokid", "rayneo", "meta-ai-glasses", "gaze-os", "brilliant-labs"];

if (supabase) {
  const [postResult, circleResult] = await Promise.all([
    supabase
      .from("posts")
      .select("id,title,body,type,created_at,last_activity_at,circles:circle_id(slug,name),profiles:author_id(username,display_name)")
      .eq("status", "published")
      .order("last_activity_at", { ascending: false, nullsFirst: false })
      .order("created_at", { ascending: false })
      .limit(8),
    supabase
      .from("circles")
      .select("slug,name,description")
      .in("slug", circleOrder)
      .order("name", { ascending: true }),
  ]);

  if (postResult.error) {
    loadError = postResult.error.message;
  } else {
    posts = (postResult.data ?? []) as PostRow[];
  }

  if (!circleResult.error) {
    const bySlug = new Map((circleResult.data ?? []).map((circle) => [circle.slug, circle as CircleRow]));
    circles = circleOrder.map((slug) => bySlug.get(slug)).filter(Boolean).filter((circle) => isPublicVisibleCircle(circle)) as CircleRow[];
  }
}

const postTypeLabels: Record<string, string> = {
  experience: "体验/评测",
  question: "求助",
  review: "评测",
  dev: "开发",
  news: "资讯",
  feedback: "反馈",
};

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" });
}

function excerpt(body?: string | null): string {
  if (!body) return "";
  return body.replace(/[#*_`>\n\r]+/g, " ").replace(/\s+/g, " ").trim().slice(0, 110);
}
---

<CommunityLayout
  title="OpenGlass Hub"
  description="AR/AI 眼镜玩家、开发者和早期用户的中文社区。"
  canonical="https://openglasshub.pages.dev/"
  activeSection="home"
>
  <section class="hero">
    <div class="hero-copy">
      <h1>OpenGlass Hub</h1>
      <p class="hero-lead">AR / AI 眼镜玩家、开发者和早期用户的中文社区。</p>
      <p class="hero-sub">先看讨论，再判断设备、产品路线和开发限制。</p>
      <div class="hero-actions">
        <a href="/feed/" class="secondary-btn">浏览讨论</a>
        <a href="/login/?next=/" class="secondary-btn">加入社区</a>
        <a href="/posts/new/" class="secondary-btn">发布帖子</a>
      </div>
    </div>
    <div class="hero-note">
      <strong>公开浏览，登录后互动</strong>
      <p>主页以讨论为主轴，产品资料和 Gaze Launcher 入口都收进更明确的结构里。</p>
    </div>
  </section>

  <section class="home-grid">
    <div class="community-surface">
      <div class="community-section-head">
        <div>
          <h2>正在讨论</h2>
          <p>{posts.length > 0 ? `已展示 ${posts.length} 条公开讨论，按最近活动排序。` : "社区公开讨论会优先显示在这里。"} </p>
        </div>
        <a href="/feed/" class="community-link">查看全部</a>
      </div>

      {loadError ? (
        <div class="community-empty">
          <strong>讨论加载失败</strong>
          <p>{loadError}</p>
        </div>
      ) : posts.length === 0 ? (
        <EmptyFeedState />
      ) : (
        <div class="community-feed-list">
          {posts.map((post) => (
            <PostCard
              id={post.id}
              title={post.title}
              excerpt={excerpt(post.body)}
              circleName={post.circles?.name ?? undefined}
              circleSlug={post.circles?.slug ?? undefined}
              typeLabel={post.type ? (postTypeLabels[post.type] || post.type) : undefined}
              authorName={post.profiles?.display_name || post.profiles?.username || undefined}
              timestamp={formatDate(post.last_activity_at || post.created_at)}
            />
          ))}
        </div>
      )}
    </div>

    <aside class="community-sidebar">
      <section class="community-surface community-surface--padded">
        <div class="community-meta" style="margin-bottom: 0.4rem;">加入讨论</div>
        <h2>先看，再发言</h2>
        <p>浏览公开帖子不需要登录。想发帖、评论，或者开始记录自己的 AR / AI 眼镜体验，再进入账号流程。</p>
        <AuthCTA next="/" client:only="react" />
      </section>

      <section class="community-surface">
        <div class="community-section-head">
          <h2>热点</h2>
          <span>管理员精选 / 手动更新</span>
        </div>
        <div class="community-card-list">
          {curatedNews.slice(0, 3).map((item) => (
            <NewsCard
              href={`/news/${item.slug}/`}
              category={item.category}
              title={item.title}
              summary={item.summary}
              date={new Date(item.publishedAt).toLocaleDateString("zh-CN")}
            />
          ))}
        </div>
      </section>

      <section class="community-surface">
        <div class="community-section-head">
          <h2>热门圈子</h2>
          <a href="/circles/" class="community-link">全部</a>
        </div>
        <div class="community-card-list">
          {circles.length === 0 ? (
            <div class="community-empty" style="margin: 0;">
              <strong>圈子数据暂不可用</strong>
              <p>公开圈子会按真实记录展示，不显示假活跃度。</p>
            </div>
          ) : (
            circles.map((circle) => (
              <CircleCard name={circle.name} slug={circle.slug} description={circle.description || undefined} />
            ))
          )}
        </div>
      </section>

      <section class="community-surface">
        <div class="community-section-head">
          <h2>产品入口</h2>
          <a href="/products/" class="community-link">总览</a>
        </div>
        <div class="community-card-list">
          {productLinks.map((link) => (
            <ProductCard href={link.href} title={link.label} description={link.description} />
          ))}
        </div>
      </section>
    </aside>
  </section>
</CommunityLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 290px;
    gap: 0.9rem;
    padding: 0 0 0.95rem;
    align-items: end;
  }
  .hero-copy {
    padding: 0.05rem 0 0;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.05em;
    color: #f8fafc;
  }
  .hero-lead {
    margin: 0.55rem 0 0;
    font-size: 0.98rem;
    color: #d9e2f3;
  }
  .hero-sub {
    margin: 0.32rem 0 0;
    color: #8ea0c8;
    font-size: 0.9rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.8rem;
  }
  .hero-note {
    display: grid;
    gap: 0.25rem;
    padding: 0.7rem 0.85rem;
    border-left: 1px solid #243148;
    color: #97a8c8;
  }
  .hero-note strong {
    color: #eef4ff;
    font-size: 0.92rem;
  }
  .hero-note p {
    margin: 0;
    font-size: 0.86rem;
  }
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 318px;
    gap: 0.9rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .hero,
    .home-grid {
      grid-template-columns: 1fr;
    }
    .hero-note {
      order: -1;
      border-left: 0;
      border-top: 1px solid #243148;
      padding-left: 0;
      padding-right: 0;
    }
    .hero h1 {
      font-size: 2.2rem;
    }
  }
</style>
