---
export const prerender = false;

import CommunityLayout from "../layouts/CommunityLayout.astro";
import AuthCTA from "../components/auth/AuthCTA";
import SignedOutHeroNote from "../components/auth/SignedOutHeroNote";
import PostCard from "../components/community/PostCard.astro";
import EmptyFeedState from "../components/community/EmptyFeedState.astro";
import { formatPostTime } from "../lib/format-time";
import { createSSRClient, type CloudflareEnv } from "../lib/supabase-server";
import { listPublicNewsFeed } from "../lib/news";
import { buildResolvedPostMediaMap, type PostMediaRow } from "../lib/forum-media";
import { buildPostLikeCountMap } from "../lib/post-engagement";
import { sanitizeBodyForDisplay } from "../lib/post-body";
import { isPublicVisibleCircle } from "../lib/site-navigation";

type PostRow = {
  id: string;
  author_id: string;
  title: string;
  body?: string | null;
  type?: string | null;
  created_at: string;
  last_activity_at?: string | null;
  profiles?: { display_name?: string | null; username?: string | null } | null;
  circles?: { slug?: string | null; name?: string | null } | null;
  post_media?: PostMediaRow[] | null;
};

const env = (Astro.locals as { runtime?: { env?: CloudflareEnv } }).runtime?.env;
const supabase = env?.SUPABASE_URL && env?.SUPABASE_ANON_KEY ? createSSRClient(env) : null;
const r2PublicBaseUrl = env?.R2_PUBLIC_BASE_URL || "";

let posts: PostRow[] = [];
let loadError = "";
let homeCircles: Array<{ slug?: string | null; name?: string | null; description?: string | null; status?: string | null }> = [];

if (supabase) {
  const [postResult, circleResult] = await Promise.all([
    supabase
      .from("posts")
      .select("id,author_id,title,body,type,created_at,last_activity_at,circles:circle_id(slug,name),profiles:author_id(username,display_name),post_media(*)")
      .eq("status", "published")
      .eq("moderation_status", "published")
      .order("created_at", { ascending: false })
      .limit(10),
    supabase
      .from("circles")
      .select("slug,name,description,status")
      .order("created_at", { ascending: false })
      .limit(8),
  ]);

  if (postResult.error) {
    loadError = postResult.error.message;
  } else {
    posts = (postResult.data ?? []) as PostRow[];
  }

  if (!circleResult.error) {
    homeCircles = (circleResult.data ?? []).filter((circle) => isPublicVisibleCircle(circle));
  }
}

const postMediaMap = supabase
  ? await buildResolvedPostMediaMap(supabase, posts, 60 * 60, r2PublicBaseUrl, {
      publicProxy: true,
    })
  : new Map();
const likeCountMap = supabase ? await buildPostLikeCountMap(supabase, posts.map((post) => post.id)) : new Map();
const homeNewsFeed = supabase
  ? await listPublicNewsFeed(supabase, { filter: "recommended", page: 1, limit: 3 })
  : { articles: [], featuredArticle: null, hotArticles: [], latestArticles: [], total: 0, page: 1, limit: 3, hasMore: false };

const postTypeLabels: Record<string, string> = {
  experience: "体验/评测",
  question: "求助",
  review: "评测",
  dev: "开发",
  news: "资讯",
  feedback: "反馈",
};

const quickLinks = [
  { href: "/feed/?sort=recommended", label: "推荐讨论" },
  { href: "/circles/", label: "圈子" },
  { href: "/news/", label: "热点" },
  { href: "/products/", label: "产品" },
] as const;

const heroSignals = [
  { label: "公开讨论", value: posts.length > 0 ? `${posts.length}` : "启动中" },
  { label: "产品入口", value: "按品牌" },
  { label: "社区节奏", value: homeCircles.length > 0 ? `${homeCircles.length} 个圈子` : "持续整理" },
] as const;

const featuredPost = posts[0];
const featuredCircle = homeCircles[0];

function excerpt(body?: string | null): string {
  const sanitized = sanitizeBodyForDisplay(body);
  if (!sanitized) return "";
  return sanitized.replace(/[#*_`>\n\r]+/g, " ").replace(/\s+/g, " ").trim().slice(0, 110);
}
---

<CommunityLayout
  title="OpenGlass Hub"
  description="AR/AI 眼镜玩家、开发者和早期用户的中文社区。"
  canonical="https://openglasshub.pages.dev/"
  activeSection="home"
>
  <section class="home-intro">
    <div class="home-intro__copy">
      <span class="home-intro__kicker">AR / AI 眼镜社区</span>
      <h1>OpenGlass Hub</h1>
      <p>讨论 AR / AI 眼镜的真实体验、产品选择和开发问题。</p>
      <small>给早期用户、开发者和正在做购买判断的人。</small>
      <div class="home-intro__actions">
        <a href="/feed/" class="community-button">进入论坛</a>
        <a href="/products/" class="community-button--secondary">浏览产品</a>
      </div>
    </div>

    <div class="home-intro__signal" aria-label="社区概览">
      <div class="home-signal-card home-signal-card--primary">
        <span>当前焦点</span>
        <strong>{featuredPost?.title || "从产品体验和开发问题开始"}</strong>
        <a href={featuredPost ? `/posts/${featuredPost.id}/` : "/feed/"}>查看讨论</a>
      </div>
      <div class="home-signal-grid">
        {heroSignals.map((item) => (
          <div class="home-signal-metric">
            <span>{item.label}</span>
            <strong>{item.value}</strong>
          </div>
        ))}
      </div>
      <a class="home-signal-route" href={featuredCircle?.slug ? `/circles/${featuredCircle.slug}/` : "/circles/"}>
        <span>进入圈子</span>
        <strong>{featuredCircle?.name || "查看公开圈子"}</strong>
      </a>
    </div>
  </section>

  <section class="home-channel-bar" aria-label="社区入口">
    <span class="home-channel-bar__label">浏览</span>
    <div class="community-inline-links home-channel-bar__links">
      {quickLinks.map((item) => (
        <a href={item.href} class="community-inline-link">{item.label}</a>
      ))}
    </div>
  </section>

  <section class="home-grid">
    <div class="community-feed-column">
      <div class="community-stream-head">
        <div>
          <h2>正在讨论</h2>
          <p>{posts.length > 0 ? `公开讨论会先从这里开始。` : "社区正在启动，公开讨论会先从这里开始。"}</p>
        </div>
        <div class="community-inline-links">
          <a href="/feed/" class="community-inline-link community-inline-link--active">全部讨论</a>
          <a href="/feed/?sort=latest" class="community-inline-link">最新</a>
          <a href="/feed/?sort=hot" class="community-inline-link">热门</a>
        </div>
      </div>

      {loadError ? (
        <div class="community-empty">
          <strong>讨论加载失败</strong>
          <p>{loadError}</p>
        </div>
      ) : posts.length === 0 ? (
        <EmptyFeedState />
      ) : (
        <div class="community-feed-list">
          {posts.map((post) => (
            <PostCard
              id={post.id}
              title={post.title}
              excerpt={excerpt(post.body)}
              circleName={post.circles?.name ?? undefined}
              circleSlug={post.circles?.slug ?? undefined}
              typeLabel={post.type ? (postTypeLabels[post.type] || post.type) : undefined}
              authorName={post.profiles?.display_name || post.profiles?.username || undefined}
              authorId={post.author_id}
              authorUsername={post.profiles?.username || undefined}
              timestamp={formatPostTime(post.created_at)}
              media={postMediaMap.get(post.id) ?? []}
              likeCount={likeCountMap.get(post.id) ?? 0}
            />
          ))}
        </div>
      )}
    </div>

    <aside class="community-sidebar">
      <section class="community-sidebar-block community-sidebar-block--strong">
        <div class="home-utility-block">
          <div class="community-sidebar-head">
            <h2>开始</h2>
          </div>
          <AuthCTA next="/" client:only="react" />
          <SignedOutHeroNote client:only="react" />
          <div class="community-list home-utility-list">
            <a href="/products/" class="community-list-item">
              <strong>产品</strong>
              <span>按品牌直接浏览 AR / AI 眼镜。</span>
            </a>
            <a href="/gaze-launcher/" class="community-list-item">
              <strong>Gaze Launcher</strong>
              <span>查看产品方向和当前进展。</span>
            </a>
          </div>
        </div>
      </section>

      <section class="community-sidebar-block">
        <div class="community-sidebar-head">
          <h2>热点</h2>
          <a href="/news/" class="community-link">全部</a>
        </div>
        <div class="community-list">
          {homeNewsFeed.articles.slice(0, 3).map((item) => (
            <a href={`/news/${item.slug}/`} class="community-list-item">
              <strong>{item.title}</strong>
              <span>{new Date(item.published_at ?? item.created_at).toLocaleDateString("zh-CN")}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="community-sidebar-block">
        <div class="community-sidebar-head">
          <h2>热门圈子</h2>
          <a href="/circles/" class="community-link">全部</a>
        </div>
        <div class="community-list">
          {homeCircles.slice(0, 4).map((circle) => (
            <a href={`/circles/${circle.slug}/`} class="community-list-item">
              <strong>{circle.name}</strong>
              <span>{circle.description || "进入圈子查看公开讨论。"}</span>
            </a>
          ))}
        </div>
      </section>
    </aside>
  </section>
</CommunityLayout>

<style>
  .home-intro {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 430px);
    align-items: stretch;
    gap: clamp(1.2rem, 3vw, 2.4rem);
    min-height: 0;
    padding: clamp(1.45rem, 4vw, 3rem) 0 clamp(1.2rem, 3vw, 2.2rem);
    isolation: isolate;
  }
  .home-intro::before {
    content: "";
    position: absolute;
    inset: -1.5rem -7vw auto auto;
    z-index: -1;
    width: min(56vw, 720px);
    height: min(40vw, 520px);
    border-radius: 40%;
    background:
      radial-gradient(circle at 62% 30%, rgba(58, 132, 255, 0.2), transparent 34%),
      radial-gradient(circle at 36% 58%, rgba(18, 56, 126, 0.34), transparent 44%);
    filter: blur(22px);
    opacity: 0.82;
  }
  .home-intro__copy {
    display: grid;
    align-content: center;
    min-width: 0;
    max-width: 680px;
  }
  .home-intro__kicker {
    width: fit-content;
    margin-bottom: 0.78rem;
    color: rgba(149, 184, 255, 0.88);
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.01em;
  }
  .home-intro h1 {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(3rem, 6.4vw, 5.35rem);
    line-height: 0.93;
    letter-spacing: -0.034em;
    text-wrap: balance;
  }
  .home-intro p {
    margin: 1rem 0 0;
    max-width: 30ch;
    color: rgba(241, 246, 255, 0.84);
    font-size: 1.18rem;
    line-height: 1.52;
  }
  .home-intro small {
    display: block;
    margin-top: 0.62rem;
    color: rgba(207, 219, 241, 0.62);
    font-size: 0.94rem;
    line-height: 1.55;
  }
  .home-intro__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.68rem;
    margin-top: 1.35rem;
  }
  .home-intro__signal {
    align-self: center;
    display: grid;
    gap: 0.72rem;
    min-width: 0;
    padding: 0.8rem;
    border: 1px solid rgba(91, 145, 255, 0.14);
    border-radius: 20px;
    background:
      linear-gradient(180deg, rgba(9, 22, 48, 0.72), rgba(5, 8, 14, 0.84)),
      rgba(255, 255, 255, 0.025);
    box-shadow: inset 0 1px 0 rgba(178, 206, 255, 0.08), 0 4px 8px rgba(0, 0, 0, 0.22);
  }
  .home-signal-card,
  .home-signal-metric,
  .home-signal-route {
    min-width: 0;
    border: 1px solid rgba(163, 194, 255, 0.1);
    border-radius: 15px;
    background: rgba(255, 255, 255, 0.04);
  }
  .home-signal-card {
    display: grid;
    gap: 0.42rem;
    padding: 1rem;
  }
  .home-signal-card span,
  .home-signal-metric span,
  .home-signal-route span {
    color: rgba(205, 220, 248, 0.58);
    font-size: 0.78rem;
    font-weight: 620;
  }
  .home-signal-card strong {
    color: rgba(248, 251, 255, 0.96);
    font-size: 1rem;
    line-height: 1.35;
    text-wrap: balance;
  }
  .home-signal-card a,
  .home-signal-route {
    color: rgba(185, 211, 255, 0.94);
    text-decoration: none;
    font-size: 0.84rem;
    font-weight: 650;
  }
  .home-signal-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
  }
  .home-signal-metric {
    display: grid;
    gap: 0.22rem;
    padding: 0.72rem;
  }
  .home-signal-metric strong {
    color: #f8fbff;
    font-size: 0.9rem;
    line-height: 1.25;
  }
  .home-signal-route {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    padding: 0.78rem 0.9rem;
  }
  .home-signal-route strong {
    min-width: 0;
    overflow: hidden;
    color: rgba(248, 251, 255, 0.94);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .home-channel-bar {
    display: flex;
    align-items: center;
    gap: 0.72rem;
    margin-bottom: 1.45rem;
    padding: 0.72rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.055);
    border-bottom: 1px solid rgba(255, 255, 255, 0.055);
  }
  .home-channel-bar__label {
    color: rgba(245, 245, 247, 0.44);
    font-size: 0.84rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .home-channel-bar__links {
    gap: 0.5rem;
  }
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(1.2rem, 2.6vw, 2.2rem);
    align-items: start;
  }
  .community-feed-column {
    min-width: 0;
  }
  .community-stream-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0 1.05rem;
    margin-bottom: 0.35rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .community-stream-head h2 {
    margin: 0;
    font-size: 1.18rem;
    letter-spacing: -0.018em;
  }
  .community-stream-head p {
    margin: 0.28rem 0 0;
    color: var(--text-muted);
    font-size: 0.94rem;
  }
  .home-utility-block {
    display: grid;
    gap: 0.8rem;
  }
  .home-utility-list {
    padding-top: 0.1rem;
  }
  @media (max-width: 860px) {
    .home-intro,
    .home-grid {
      grid-template-columns: 1fr;
    }
    .community-stream-head {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  @media (max-width: 720px) {
    .home-intro {
      gap: 1rem;
      min-height: 0;
      padding: 1.25rem 0 2rem;
    }
    .home-intro::before {
      inset: 0 -18vw auto auto;
      width: 80vw;
      height: 240px;
      opacity: 0.48;
    }
    .home-intro h1 {
      max-width: 9ch;
      font-size: clamp(2.75rem, 15vw, 4rem);
    }
    .home-intro p {
      font-size: 1rem;
    }
    .home-intro small {
      font-size: 0.86rem;
      line-height: 1.55;
    }
    .home-intro__actions {
      width: 100%;
    }
    .home-intro__signal {
      padding: 0.66rem;
      border-radius: 16px;
    }
    .home-signal-grid {
      grid-template-columns: 1fr;
    }
    .home-intro__actions :global(.community-button),
    .home-intro__actions :global(.community-button--secondary) {
      flex: 1 1 0;
      justify-content: center;
      min-width: 0;
    }
    .home-channel-bar {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.55rem;
      margin-bottom: 1.35rem;
      padding: 0.65rem 0;
    }
    .home-channel-bar__links {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.15rem;
      scrollbar-width: none;
    }
    .home-channel-bar__links::-webkit-scrollbar {
      display: none;
    }
    .community-stream-head {
      gap: 0.7rem;
      padding-bottom: 0.85rem;
    }
  }
  @media (max-width: 420px) {
    .home-intro__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
