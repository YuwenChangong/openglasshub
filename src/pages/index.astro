---
export const prerender = false;

import SiteLayout from "../layouts/SiteLayout.astro";
import AuthCTA from "../components/auth/AuthCTA";
import { createSSRClient, type CloudflareEnv } from "../lib/supabase-server";
import { curatedNews } from "../lib/news";
import { productLinks } from "../lib/site-navigation";

type PostRow = {
  id: string;
  title: string;
  body?: string | null;
  type?: string | null;
  created_at: string;
  last_activity_at?: string | null;
  profiles?: { display_name?: string | null; username?: string | null } | null;
  circles?: { slug?: string | null; name?: string | null } | null;
};

type CircleRow = {
  slug: string;
  name: string;
  description?: string | null;
};

const env = (Astro.locals as { runtime?: { env?: CloudflareEnv } }).runtime?.env;
const supabase = env?.SUPABASE_URL && env?.SUPABASE_ANON_KEY ? createSSRClient(env) : null;

let posts: PostRow[] = [];
let circles: CircleRow[] = [];
let loadError = "";

const circleOrder = ["xreal", "rokid", "rayneo", "meta-ai-glasses", "gaze-os", "brilliant-labs"];

if (supabase) {
  const [postResult, circleResult] = await Promise.all([
    supabase
      .from("posts")
      .select("id,title,body,type,created_at,last_activity_at,circles:circle_id(slug,name),profiles:author_id(username,display_name)")
      .eq("status", "published")
      .order("last_activity_at", { ascending: false, nullsFirst: false })
      .order("created_at", { ascending: false })
      .limit(8),
    supabase
      .from("circles")
      .select("slug,name,description")
      .in("slug", circleOrder)
      .order("name", { ascending: true }),
  ]);

  if (postResult.error) {
    loadError = postResult.error.message;
  } else {
    posts = (postResult.data ?? []) as PostRow[];
  }

  if (!circleResult.error) {
    const bySlug = new Map((circleResult.data ?? []).map((circle) => [circle.slug, circle as CircleRow]));
    circles = circleOrder.map((slug) => bySlug.get(slug)).filter(Boolean) as CircleRow[];
  }
}

const postTypeLabels: Record<string, string> = {
  experience: "体验/评测",
  question: "求助",
  review: "评测",
  dev: "开发",
  news: "资讯",
  feedback: "反馈",
};

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" });
}

function excerpt(body?: string | null): string {
  if (!body) return "";
  return body.replace(/[#*_`>\n\r]+/g, " ").replace(/\s+/g, " ").trim().slice(0, 110);
}
---

<SiteLayout
  title="OpenGlass Hub"
  description="AR/AI 眼镜玩家、开发者和早期用户的中文社区。"
  canonical="https://openglasshub.pages.dev/"
  activeSection="home"
>
  <section class="hero">
    <div class="hero-copy">
      <h1>OpenGlass Hub</h1>
      <p class="hero-lead">AR / AI 眼镜玩家、开发者和早期用户的中文社区。</p>
      <p class="hero-sub">讨论 XREAL、Rokid、RayNeo、Meta AI Glasses、Gaze Launcher 与空间计算。</p>
      <div class="hero-actions">
        <a href="/feed/" class="primary-btn">浏览讨论</a>
        <a href="/login/?next=/" class="secondary-btn">加入社区</a>
        <a href="/posts/new/" class="secondary-btn">发布帖子</a>
      </div>
    </div>
    <div class="hero-note forum-card">
      <div class="hero-note__label">社区方向</div>
      <h2>公开浏览，登录后互动</h2>
      <p>首页不再是资料目录页，而是以公开讨论为主轴。设备库、指南和开发者内容仍然保留，但被归入更清晰的“产品”结构。</p>
    </div>
  </section>

  <section class="home-grid">
    <div class="feed-panel forum-card">
      <div class="panel-head">
        <div>
          <h2>正在讨论</h2>
          <p>{posts.length > 0 ? `已展示 ${posts.length} 条公开讨论，按最近活动排序。` : "社区公开讨论会优先显示在这里。"} </p>
        </div>
        <a href="/feed/">查看全部</a>
      </div>

      {loadError ? (
        <div class="forum-empty" style="margin: 1rem;">
          <strong>讨论加载失败</strong>
          <p>{loadError}</p>
        </div>
      ) : posts.length === 0 ? (
        <div class="forum-empty" style="margin: 1rem;">
          <span class="status-tag">社区正在启动中</span>
          <strong>还没有太多公开讨论</strong>
          <p>OpenGlass Hub 正在从资料站过渡到真实社区。第一批帖子会决定这里接下来讨论什么，也会影响圈子和内容的沉淀方向。</p>
          <div class="topic-suggestions" aria-label="建议话题">
            <span>设备体验</span>
            <span>选购问题</span>
            <span>开发问题</span>
            <span>Gaze Launcher 建议</span>
          </div>
          <div class="empty-actions">
            <a href="/posts/new/" class="primary-btn">发布第一篇帖子</a>
            <a href="/circles/" class="secondary-btn">浏览圈子</a>
          </div>
        </div>
      ) : (
        <div class="post-list">
          {posts.map((post) => (
            <a href={`/posts/${post.id}/`} class="post-row">
              <div class="post-meta">
                {post.circles?.name && <span class="forum-tag forum-tag--muted">{post.circles.name}</span>}
                {post.type && <span class="forum-tag">{postTypeLabels[post.type] || post.type}</span>}
                <span class="forum-meta">{formatDate(post.last_activity_at || post.created_at)}</span>
                <span class="forum-meta">{post.profiles?.display_name || post.profiles?.username || "匿名用户"}</span>
              </div>
              <h3>{post.title}</h3>
              {excerpt(post.body) && <p>{excerpt(post.body)}</p>}
            </a>
          ))}
        </div>
      )}
    </div>

    <aside class="side-column">
      <section class="side-card forum-card">
        <div class="side-eyebrow">加入讨论</div>
        <h2>先看，再发言</h2>
        <p>浏览公开帖子不需要登录。想发帖、评论，或者开始记录自己的 AR / AI 眼镜体验，需要先加入社区。</p>
        <AuthCTA next="/" client:only="react" />
      </section>

      <section class="side-card forum-card">
        <div class="side-head">
          <h2>热点</h2>
          <span>管理员精选 / 手动更新</span>
        </div>
        <div class="side-list">
          {curatedNews.slice(0, 3).map((item) => (
            <a href={`/news/${item.slug}/`}>
              <small class="news-tag">{item.category}</small>
              <strong>{item.title}</strong>
              <span>{item.summary}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="side-card forum-card">
        <div class="side-head">
          <h2>热门圈子</h2>
          <a href="/circles/">全部</a>
        </div>
        <div class="side-list">
          {circles.length === 0 ? (
            <a href="/circles/">
              <strong>查看圈子</strong>
              <span>圈子数据会按真实记录展示，不显示假活跃度。</span>
            </a>
          ) : (
            circles.map((circle) => (
              <a href={`/circles/${circle.slug}/`}>
                <strong>{circle.name}</strong>
                <span>{circle.description || "查看这个圈子的公开讨论与后续动态。"}</span>
              </a>
            ))
          )}
        </div>
      </section>

      <section class="side-card forum-card">
        <div class="side-head">
          <h2>产品入口</h2>
          <a href="/products/">总览</a>
        </div>
        <div class="side-list">
          {productLinks.map((link) => (
            <a href={link.href}>
              <strong>{link.label}</strong>
              <span>{link.description}</span>
            </a>
          ))}
        </div>
      </section>
    </aside>
  </section>
</SiteLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 1rem;
    padding: 0.2rem 0 1.35rem;
  }
  .hero-copy {
    padding: 0.4rem 0 0;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
    color: #f8fafc;
  }
  .hero-lead {
    margin: 0.95rem 0 0;
    font-size: 1.08rem;
    color: #dbe3f3;
  }
  .hero-sub {
    margin: 0.52rem 0 0;
    color: #8ea0c8;
  }
  .hero-actions,
  .empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.15rem;
  }
  .primary-btn,
  .secondary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0.6rem 1rem;
    border-radius: 10px;
    border: 1px solid #27314a;
    text-decoration: none;
    font-weight: 600;
  }
  .primary-btn {
    background: #2563eb;
    border-color: #2563eb;
    color: #f8fafc;
    box-shadow: 0 12px 28px rgba(37, 99, 235, 0.24);
  }
  .secondary-btn {
    background: #11182a;
    color: #dce7fb;
  }
  .hero-note {
    padding: 1.15rem;
    display: grid;
    align-content: start;
    gap: 0.45rem;
  }
  .hero-note__label {
    color: #7d91bb;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .hero-note h2 {
    margin: 0;
    font-size: 1.12rem;
    color: #f8fafc;
  }
  .hero-note p {
    margin: 0;
    color: #97a8c8;
    font-size: 0.94rem;
  }
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 348px;
    gap: 1rem;
    align-items: start;
  }
  .feed-panel {
    overflow: hidden;
  }
  .panel-head,
  .side-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: start;
    padding: 1rem 1.1rem;
    border-bottom: 1px solid #20283a;
  }
  .panel-head h2,
  .side-head h2,
  .side-card h2 {
    margin: 0;
    color: #f8fafc;
    font-size: 1.12rem;
    letter-spacing: -0.02em;
  }
  .panel-head p,
  .side-head span,
  .side-card p {
    margin: 0.2rem 0 0;
    color: #8d9fbe;
    font-size: 0.86rem;
  }
  .panel-head a,
  .side-head a {
    color: #9bc2ff;
    text-decoration: none;
    font-size: 0.86rem;
    white-space: nowrap;
  }
  .post-list {
    display: grid;
    gap: 0.95rem;
    padding: 1rem;
  }
  .post-row {
    display: grid;
    gap: 0.55rem;
    padding: 1.1rem 1.08rem;
    border: 1px solid #22304a;
    border-radius: 14px;
    background: #101827;
    text-decoration: none;
  }
  .post-row:hover {
    border-color: #35507e;
    background: #132033;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.48rem;
    align-items: center;
  }
  .post-row h3 {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.42;
    color: #f4f7fd;
  }
  .post-row p {
    margin: 0;
    color: #a7b1c8;
    font-size: 0.95rem;
  }
  .status-tag {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    padding: 0.32rem 0.6rem;
    border-radius: 999px;
    background: rgba(37, 99, 235, 0.14);
    border: 1px solid rgba(90, 135, 244, 0.24);
    color: #abc2ff;
    font-size: 0.76rem;
    font-weight: 700;
  }
  .topic-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .topic-suggestions span {
    display: inline-flex;
    align-items: center;
    padding: 0.38rem 0.68rem;
    border-radius: 999px;
    background: #0f1829;
    border: 1px solid #25314a;
    color: #c4d1ea;
    font-size: 0.83rem;
  }
  .side-column {
    display: grid;
    gap: 1rem;
  }
  .side-card {
    padding: 1.05rem;
  }
  .side-eyebrow {
    margin-bottom: 0.55rem;
    color: #8ea0c8;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .side-list {
    display: grid;
  }
  .side-list a {
    display: grid;
    gap: 0.28rem;
    padding: 0.95rem 0;
    border-top: 1px solid #20283a;
    text-decoration: none;
  }
  .side-list a:first-child {
    border-top: 0;
    padding-top: 0.2rem;
  }
  .side-list strong {
    color: #f8fafc;
    font-size: 0.92rem;
  }
  .side-list span {
    color: #8a99b8;
    font-size: 0.82rem;
  }
  .news-tag {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    padding: 0.22rem 0.5rem;
    border-radius: 999px;
    background: rgba(37, 99, 235, 0.12);
    border: 1px solid rgba(86, 132, 242, 0.18);
    color: #aac2fb;
    font-size: 0.74rem;
    font-weight: 700;
  }
  @media (max-width: 900px) {
    .hero,
    .home-grid {
      grid-template-columns: 1fr;
    }
    .hero-note {
      order: -1;
    }
    .hero h1 {
      font-size: 2.7rem;
    }
  }
</style>
