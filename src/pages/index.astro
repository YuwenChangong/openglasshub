---
export const prerender = false;

import CommunityLayout from "../layouts/CommunityLayout.astro";
import AuthCTA from "../components/auth/AuthCTA";
import SignedOutHeroNote from "../components/auth/SignedOutHeroNote";
import PostCard from "../components/community/PostCard.astro";
import EmptyFeedState from "../components/community/EmptyFeedState.astro";
import { formatPostTime } from "../lib/format-time";
import { createSSRClient, type CloudflareEnv } from "../lib/supabase-server";
import { curatedNews } from "../lib/news";
import { buildResolvedPostMediaMap, type PostMediaRow } from "../lib/forum-media";
import { buildPostLikeCountMap } from "../lib/post-engagement";
import { sanitizeBodyForDisplay } from "../lib/post-body";

type PostRow = {
  id: string;
  title: string;
  body?: string | null;
  type?: string | null;
  created_at: string;
  last_activity_at?: string | null;
  profiles?: { display_name?: string | null; username?: string | null } | null;
  circles?: { slug?: string | null; name?: string | null } | null;
  post_media?: PostMediaRow[] | null;
};

const env = (Astro.locals as { runtime?: { env?: CloudflareEnv } }).runtime?.env;
const supabase = env?.SUPABASE_URL && env?.SUPABASE_ANON_KEY ? createSSRClient(env) : null;
const r2PublicBaseUrl = env?.R2_PUBLIC_BASE_URL || "";

let posts: PostRow[] = [];
let loadError = "";

if (supabase) {
  const postResult = await supabase
    .from("posts")
    .select("id,title,body,type,created_at,last_activity_at,circles:circle_id(slug,name),profiles:author_id(username,display_name),post_media(*)")
    .eq("status", "published")
    .order("created_at", { ascending: false })
    .limit(8);

  if (postResult.error) {
    loadError = postResult.error.message;
  } else {
    posts = (postResult.data ?? []) as PostRow[];
  }
}

const postMediaMap = supabase
  ? await buildResolvedPostMediaMap(supabase, posts, 60 * 60, r2PublicBaseUrl)
  : new Map();
const likeCountMap = supabase ? await buildPostLikeCountMap(supabase, posts.map((post) => post.id)) : new Map();

const postTypeLabels: Record<string, string> = {
  experience: "体验/评测",
  question: "求助",
  review: "评测",
  dev: "开发",
  news: "资讯",
  feedback: "反馈",
};

function excerpt(body?: string | null): string {
  const sanitized = sanitizeBodyForDisplay(body);
  if (!sanitized) return "";
  return sanitized.replace(/[#*_`>\n\r]+/g, " ").replace(/\s+/g, " ").trim().slice(0, 110);
}
---

<CommunityLayout
  title="OpenGlass Hub"
  description="AR/AI 眼镜玩家、开发者和早期用户的中文社区。"
  canonical="https://openglasshub.pages.dev/"
  activeSection="home"
>
  <section class="hero">
    <div class="hero-copy">
      <h1>OpenGlass Hub</h1>
      <p class="hero-lead">AR / AI 眼镜玩家、开发者和早期用户的中文社区。</p>
      <div class="hero-actions">
        <a href="/feed/" class="community-button--secondary">浏览讨论</a>
        <a href="/login/?next=/" class="community-button--secondary">加入社区</a>
        <a href="/posts/new/" class="community-button">发布帖子</a>
      </div>
    </div>
    <div class="hero-note">
      <SignedOutHeroNote client:only="react" />
      <div class="community-inline-links">
        <a href="/products/" class="community-inline-link">产品入口</a>
        <a href="/news/" class="community-inline-link">管理员精选</a>
        <a href="/gaze-launcher/" class="community-inline-link">Gaze Launcher</a>
      </div>
    </div>
  </section>

  <section class="home-grid">
    <div class="community-feed-column">
      <div class="community-stream-head">
        <div>
          <h2>正在讨论</h2>
          <p>{posts.length > 0 ? `已展示 ${posts.length} 条公开讨论。` : "社区正在启动，公开讨论会先从这里长出来。"} </p>
        </div>
        <a href="/feed/" class="community-link">查看全部</a>
      </div>

      {loadError ? (
        <div class="community-empty">
          <strong>讨论加载失败</strong>
          <p>{loadError}</p>
        </div>
      ) : posts.length === 0 ? (
        <EmptyFeedState />
      ) : (
        <div class="community-feed-list">
          {posts.map((post) => (
            <PostCard
              id={post.id}
              title={post.title}
              excerpt={excerpt(post.body)}
              circleName={post.circles?.name ?? undefined}
              circleSlug={post.circles?.slug ?? undefined}
              typeLabel={post.type ? (postTypeLabels[post.type] || post.type) : undefined}
              authorName={post.profiles?.display_name || post.profiles?.username || undefined}
              timestamp={formatPostTime(post.created_at)}
              media={postMediaMap.get(post.id) ?? []}
              likeCount={likeCountMap.get(post.id) ?? 0}
            />
          ))}
        </div>
      )}
    </div>

    <aside class="community-sidebar">
      <section class="community-sidebar-block community-sidebar-block--strong">
        <AuthCTA next="/" client:only="react" />
      </section>

      <section class="community-sidebar-block">
        <div class="community-sidebar-head">
          <h2>热点</h2>
          <span>管理员精选</span>
        </div>
        <div class="community-list">
          {curatedNews.slice(0, 3).map((item) => (
            <a href={`/news/${item.slug}/`} class="community-list-item">
              <strong>{item.title}</strong>
              <span>{item.category} · {new Date(item.publishedAt).toLocaleDateString("zh-CN")}</span>
            </a>
          ))}
        </div>
      </section>
    </aside>
  </section>
</CommunityLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 1rem;
    padding: 0.1rem 0 1rem;
    align-items: end;
  }
  .hero-copy {
    padding: 0.05rem 0 0;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(2.1rem, 4vw, 2.8rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
    color: var(--text);
  }
  .hero-lead {
    margin: 0.7rem 0 0;
    font-size: 1.02rem;
    color: var(--text);
  }
  .hero-sub {
    margin: 0.38rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.95rem;
  }
  .hero-note {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding-bottom: 0.25rem;
  }
  .hero-note strong {
    color: var(--text);
    font-size: 0.88rem;
  }
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 318px;
    gap: 1.5rem;
    align-items: start;
  }
  .community-feed-column {
    min-width: 0;
  }
  .community-stream-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0 0.8rem;
    margin-bottom: 0.2rem;
    border-bottom: 1px solid var(--border);
  }
  .community-stream-head h2 {
    margin: 0;
    font-size: 1.12rem;
  }
  .community-stream-head p {
    margin: 0.2rem 0 0;
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  @media (max-width: 900px) {
    .hero,
    .home-grid {
      grid-template-columns: 1fr;
    }
    .community-stream-head {
      align-items: flex-start;
      flex-direction: column;
    }
    .hero h1 {
      font-size: 2.2rem;
    }
  }
</style>

