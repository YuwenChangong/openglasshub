---
export const prerender = false;

import CommunityLayout from "../../../layouts/CommunityLayout.astro";
import ResetPasswordForm from "../../../components/auth/ResetPasswordForm";
---

<CommunityLayout
  title="重置密码"
  description="通过邮箱恢复链接重置 OpenGlass Hub 密码。"
  canonical="/auth/reset-password/"
  noindex={true}
>
  <section class="auth-reset-page">
    <ResetPasswordForm client:only="react" />
  </section>
</CommunityLayout>

<style>
  .auth-reset-page {
    width: min(100%, 480px);
    margin: 2rem auto 0;
  }
</style>
