---
export const prerender = false;

import CommunityLayout from "../../../layouts/CommunityLayout.astro";
import ResetPasswordForm from "../../../components/auth/ResetPasswordForm";
import { resolveLocale } from "../../../lib/i18n/locale";
import { getUiMessages } from "../../../lib/i18n/catalog";
const localeContext = Astro.locals.localeContext ?? resolveLocale({});
const text = getUiMessages(localeContext.locale).account;
---

<CommunityLayout
  title={text.resetTitle}
  description={text.resetDescription}
  canonical="/auth/reset-password/"
  noindex={true}
>
  <section class="auth-reset-page">
    <ResetPasswordForm locale={localeContext.locale} localeContext={localeContext} client:only="react" />
  </section>
</CommunityLayout>

<style>
  .auth-reset-page {
    width: min(100%, 480px);
    margin: 2rem auto 0;
  }
</style>
