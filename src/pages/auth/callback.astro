---
export const prerender = false;

import CommunityLayout from "../../layouts/CommunityLayout.astro";
import AuthCallback from "../../components/auth/AuthCallback";
import { resolveLocale } from "../../lib/i18n/locale";
import { getUiMessages } from "../../lib/i18n/catalog";
const localeContext = Astro.locals.localeContext ?? resolveLocale({});
const text = getUiMessages(localeContext.locale).account;

const next = Astro.url.searchParams.get("next") ?? "/";
---

<CommunityLayout
  title={text.callbackTitle}
  description={text.callbackDescription}
  canonical="/auth/callback/"
  noindex={true}
>
  <section class="auth-callback-page">
    <AuthCallback locale={localeContext.locale} localeContext={localeContext} next={next} client:only="react" />
  </section>
</CommunityLayout>

<style>
  .auth-callback-page {
    width: min(100%, 480px);
    margin: 2rem auto 0;
  }
</style>
