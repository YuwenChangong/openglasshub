---
import DeviceLibraryExplorer from "../../components/devices/DeviceLibraryExplorer";
import CommunityLayout from "../../layouts/CommunityLayout.astro";
import { deviceCategoryLabels, deviceLibrary, deviceStatusLabels, deviceUseCaseLabels } from "../../data/devices";

const categoryCount = new Set(deviceLibrary.map((device) => device.category)).size;
const brandCount = new Set(deviceLibrary.map((device) => device.brand)).size;
---

<CommunityLayout
  title="Device Library"
  description="OpenGlass Hub 的公开设备库 MVP，按品牌、分类、状态和用途浏览 AR / AI 眼镜与 XR 设备。"
  canonical="https://openglasshub.pages.dev/devices/"
  activeSection="devices"
>
  <section class="devices-hero">
    <div class="devices-hero__copy">
      <p class="devices-hero__eyebrow">OpenGlass Hub Device Library</p>
      <h1>公开设备库 MVP</h1>
      <p class="devices-hero__lead">
        这是一个面向用户的第一版设备库，用静态本地数据整理当前值得关注的 AR / AI 眼镜与 XR 设备。
        这一版故意保持保守，不确定的硬件细节会留空、标记 TBD，或直接不写。
      </p>
    </div>

    <div class="devices-hero__stats">
      <article class="community-surface device-hero-stat">
        <span>首批设备</span>
        <strong>{deviceLibrary.length}</strong>
      </article>
      <article class="community-surface device-hero-stat">
        <span>覆盖品牌</span>
        <strong>{brandCount}</strong>
      </article>
      <article class="community-surface device-hero-stat">
        <span>设备分类</span>
        <strong>{categoryCount}</strong>
      </article>
    </div>
  </section>

  <section class="community-surface device-library-note">
    <div>
      <h2>这版先解决什么</h2>
      <p>
        先把设备入口做得可见、可搜、可筛选，方便用户快速建立方向感。数据库、对比表、用户评测和自动化规格采集留到后续版本。
      </p>
    </div>
    <div class="community-chip-row">
      <span class="community-chip">{deviceCategoryLabels.display_glasses}</span>
      <span class="community-chip">{deviceCategoryLabels.ai_glasses}</span>
      <span class="community-chip">{deviceCategoryLabels.ar_glasses}</span>
      <span class="community-chip">{deviceCategoryLabels.xr_headset}</span>
      <span class="community-chip">{deviceCategoryLabels.developer_device}</span>
      <span class="community-chip">{deviceStatusLabels.released}</span>
      <span class="community-chip">{deviceUseCaseLabels.development}</span>
    </div>
  </section>

  <DeviceLibraryExplorer client:load devices={deviceLibrary} />
</CommunityLayout>
