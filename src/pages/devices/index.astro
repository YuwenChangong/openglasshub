---
export const prerender = false;

import CommunityLayout from "../../layouts/CommunityLayout.astro";
import ProductCard from "../../components/community/ProductCard.astro";

const brandCatalog = [
  {
    key: "xreal",
    label: "XREAL",
    devices: [
      { title: "XREAL One", description: "偏显示体验与空间显示路线，适合先判断大屏、连接体验和进阶显示需求。", href: "/devices/xreal-one/" },
      { title: "XREAL One Pro", description: "继续看显示质量、佩戴舒适度和更进阶的空间显示边界。", href: "/devices/xreal-one-pro/" },
      { title: "XREAL Air 2 Pro", description: "适合对比上一代主流显示型眼镜的佩戴与日常连接体验。", href: "/devices/xreal-air-2-pro/" },
      { title: "XREAL Air 2 Ultra", description: "更偏开发与空间计算实验路线，先核对 SDK 和输入边界。", href: "/devices/xreal-air-2-ultra/" },
    ],
  },
  {
    key: "rokid",
    label: "Rokid",
    devices: [
      { title: "Rokid Max", description: "偏显示路线，适合判断大屏观影和连接体验。", href: "/devices/rokid-max/" },
      { title: "Rokid Glasses", description: "偏 AI 眼镜日常入口，适合比较“看屏”和“智能入口”的差异。", href: "/devices/rokid-glasses/" },
    ],
  },
  {
    key: "rayneo",
    label: "RayNeo",
    devices: [{ title: "RayNeo X2", description: "更接近独立 AR 与轻量系统路线，适合研究导航、翻译和系统边界。", href: "/devices/rayneo-x2/" }],
  },
  {
    key: "inmo",
    label: "INMO",
    devices: [{ title: "INMO Air 2", description: "关注轻量 AR 佩戴、显示入口与日常系统边界。", href: "/devices/inmo-air-2/" }],
  },
  {
    key: "viture",
    label: "VITURE",
    devices: [{ title: "VITURE Pro", description: "适合对比显示型路线里的便携观影与连接体验。", href: "/devices/viture-pro/" }],
  },
  {
    key: "meta",
    label: "Meta AI Glasses",
    devices: [{ title: "Ray-Ban Meta", description: "更偏无显示智能眼镜路线，重点看语音入口、拍摄与日常佩戴。", href: "/devices/ray-ban-meta/" }],
  },
  {
    key: "brilliant-labs",
    label: "Brilliant Labs",
    devices: [{ title: "Brilliant Labs Frame", description: "开放实验方向，适合观察 AI 入口与硬件实验边界。", href: "/devices/brilliant-labs-frame/" }],
  },
] as const;

const selectedBrandKey = Astro.url.searchParams.get("brand")?.trim().toLowerCase() ?? "";
const selectedBrand = brandCatalog.find((brand) => brand.key === selectedBrandKey);
const routeCatalog = [
  {
    key: "display",
    label: "显示型",
    title: "显示型路线",
    description: "更适合观影、掌机、PC 第二屏和便携大屏。重点不是 AI，而是显示、连接和佩戴。",
    sourceLabel: "XREAL 官方连接说明",
    sourceUrl: "https://tutorials.xreal.com/docs/glasses/one-series/first-use/connect-device/",
    notes: [
      "先确认设备接口是否支持 DP 视频输出和供电，不然显示体验判断没有意义。",
      "优先比较清晰度、亮度、佩戴舒适度、连接稳定性和音频，而不是把它当独立系统。",
    ],
    devices: ["xreal-one", "xreal-one-pro", "xreal-air-2-pro", "rokid-max", "viture-pro"],
  },
  {
    key: "ai",
    label: "AI 眼镜",
    title: "AI 眼镜路线",
    description: "更适合语音入口、拍摄记录、翻译、导航和轻量 AI 助手，不要默认等同于 AR 显示设备。",
    sourceLabel: "Rokid AI Glasses Style 官方说明",
    sourceUrl: "https://global.rokid.com/products/rokid-ai-glasses-style",
    notes: [
      "日常价值主要看语音入口、拍摄边界、翻译/导航和续航，而不是纸面参数堆叠。",
      "如果产品明确写着没有 display，就不要把它拿去和显示型 AR 眼镜直接对比大屏体验。",
    ],
    devices: ["rokid-glasses", "ray-ban-meta"],
  },
  {
    key: "standalone",
    label: "独立 AR",
    title: "独立 AR / 系统型路线",
    description: "更接近系统化体验，适合研究导航、翻译、系统交互与输入方式，但风险和学习成本更高。",
    sourceLabel: "RayNeo X2 官方产品页",
    sourceUrl: "https://www.rayneo.com/products/tcl-rayneo-x2",
    notes: [
      "先看输入方式、导航/翻译等系统能力是否真能落地，再看日常佩戴与配套 app 依赖。",
      "这类产品更容易受到生态成熟度、配套手机应用、输入限制和续航的影响。",
    ],
    devices: ["rayneo-x2", "inmo-air-2"],
  },
  {
    key: "experimental",
    label: "实验路线",
    title: "开放实验 / 开发路线",
    description: "更适合研发和实验验证，重点是 SDK、蓝牙或宿主 app 关系、相机/麦克风/显示的可控边界。",
    sourceLabel: "Brilliant Frame 硬件文档",
    sourceUrl: "https://docs.brilliant.xyz/frame/hardware/",
    notes: [
      "先确认它是不是更像宿主设备配件，而不是把逻辑都跑在眼镜本体上。",
      "实验路线的价值常在开放能力，不在消费级完成度；适合开发验证，不适合拿来当成熟日常系统。",
    ],
    devices: ["brilliant-labs-frame"],
  },
] as const;
const selectedRouteKey = Astro.url.searchParams.get("route")?.trim().toLowerCase() ?? "display";
const selectedRoute = routeCatalog.find((route) => route.key === selectedRouteKey) ?? routeCatalog[0];

const featuredDevices = [
  {
    key: "xreal-one",
    title: "XREAL One / One Pro",
    description: "偏显示体验与空间显示路线，适合先判断大屏、连接体验和进阶显示需求。",
    href: "/devices/xreal-one/",
  },
  {
    key: "rokid-max",
    title: "Rokid Max / Rokid Glasses",
    description: "一条偏显示、一条偏 AI 眼镜日常入口，适合比较“看屏”和“智能入口”的差异。",
    href: "/devices/rokid-max/",
  },
  {
    key: "rayneo-x2",
    title: "RayNeo X2 / INMO Air 2",
    description: "更接近独立 AR 与轻量系统路线，适合研究导航、翻译和系统边界。",
    href: "/devices/rayneo-x2/",
  },
  {
    key: "ray-ban-meta",
    title: "Ray-Ban Meta / Brilliant Labs Frame",
    description: "更偏无显示或轻显示智能眼镜路线，适合观察 AI 入口与开放实验方向。",
    href: "/devices/ray-ban-meta/",
  },
] as const;

const brandLinks = brandCatalog.map((brand) => ({
  key: brand.key,
  label: brand.label,
  href: `/devices/?brand=${brand.key}#brand-results`,
}));

const routeDeviceCards = brandCatalog
  .flatMap((brand) => brand.devices)
  .filter((device) => selectedRoute.devices.includes(device.href.split("/").filter(Boolean).pop() ?? ""));
const visibleDevices = selectedBrand ? selectedBrand.devices : routeDeviceCards;
const visibleDevicesHeading = selectedBrand ? `${selectedBrand.label} 机型` : "重点设备";
const visibleDevicesDescription = selectedBrand
  ? `当前只显示 ${selectedBrand.label} 相关机型，便于按品牌继续缩小范围。`
  : `${selectedRoute.title}：${selectedRoute.description}`;

---

<CommunityLayout
  title="设备库"
  description="按品牌、形态和使用场景查看 AR / AI 眼镜资料。"
  canonical="https://openglasshub.pages.dev/devices/"
  activeSection="products"
>
  <section class="community-page-head">
    <div>
      <span class="devices-kicker">设备发现</span>
      <h1>设备库</h1>
      <p class="community-page-lead">按品牌、形态和使用场景查看 AR / AI 眼镜资料。当前以公开资料整理为主，待核实内容会明确标注。</p>
    </div>
  </section>

  <section class="devices-layout">
    <div class="community-surface community-surface--primary">
      <div class="devices-intro">
        <div class="devices-intro__copy">
          <strong>从路线开始，不从参数表开始。</strong>
          <p>先判断它是显示型、AI 眼镜，还是更接近独立 AR，再决定要不要继续看单机细节。</p>
        </div>
        <div class="community-inline-links">
          {routeCatalog.map((route) => (
            <a
              href={`/devices/?route=${route.key}#route-panel`}
              class:list={["community-inline-link", { "community-inline-link--active": !selectedBrand && selectedRoute.key === route.key }]}
            >
              {route.label}
            </a>
          ))}
        </div>
      </div>
      {!selectedBrand && (
        <div class="devices-route-panel" id="route-panel">
          <div>
            <span class="community-meta">路线判断</span>
            <h2>{selectedRoute.title}</h2>
            <p>{selectedRoute.description}</p>
          </div>
          <ul class="devices-route-panel__notes">
            {selectedRoute.notes.map((note) => <li>{note}</li>)}
          </ul>
          <a href={selectedRoute.sourceUrl} target="_blank" rel="noreferrer" class="community-link">
            官方参考：{selectedRoute.sourceLabel}
          </a>
        </div>
      )}
      <div class="community-section-head">
        <div>
          <h2 id="brand-results">{visibleDevicesHeading}</h2>
          <p>{visibleDevicesDescription}</p>
        </div>
        {(selectedBrand || selectedRouteKey !== "display") && <a href="/devices/" class="community-action-button community-action-button--muted">查看默认视图</a>}
      </div>
      <div class="devices-grid">
        {visibleDevices.map((item) => (
          <ProductCard label="重点设备" title={item.title} description={item.description} href={item.href} />
        ))}
      </div>
    </div>

    <div class="community-grid" style="margin-top: 1rem;">
      <section class="community-surface community-surface--primary">
        <div class="community-section-head">
          <div>
            <h2>品牌入口</h2>
            <p>按品牌先找方向，再决定要不要继续看单机详情。</p>
          </div>
        </div>
        <div class="community-list">
          {brandLinks.map((item) => (
            <a class:list={["community-list-item", "community-link-row", { "community-list-item--active": selectedBrand?.key === item.key }]} href={item.href}>
              <strong>{item.label}</strong>
              <span>查看该品牌相关机型</span>
            </a>
          ))}
        </div>
      </section>

      <aside class="community-sidebar">
        <section class="community-surface community-surface--padded community-surface--primary">
          <div class="community-page-lead" style="margin-bottom: 0.35rem;">当前路线关注点</div>
          <div class="devices-scenarios">
            {selectedRoute.notes.map((item) => (
              <article class="community-field-note">
                <strong>{selectedRoute.label}</strong>
                <span>{item}</span>
              </article>
            ))}
          </div>
        </section>
      </aside>
    </div>
  </section>
</CommunityLayout>

<style>
  .devices-kicker {
    display: inline-flex;
    margin-bottom: 0.45rem;
    color: var(--accent-hover);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .devices-intro {
    display: grid;
    gap: 0.6rem;
    padding: 1rem 1rem 0.15rem;
  }
  .devices-intro__copy {
    display: grid;
    gap: 0.25rem;
  }
  .devices-intro__copy strong {
    color: var(--text);
    font-size: 1rem;
  }
  .devices-intro__copy p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .devices-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    padding: 0.9rem 1rem 1rem;
  }
  .devices-route-panel {
    display: grid;
    gap: 0.7rem;
    padding: 0 1rem 0.9rem;
  }
  .devices-route-panel h2 {
    margin: 0.18rem 0 0.25rem;
    color: var(--text);
    font-size: 1.08rem;
  }
  .devices-route-panel p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.65;
  }
  .devices-route-panel__notes {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-muted);
    display: grid;
    gap: 0.3rem;
  }
  .community-link-row {
    text-decoration: none;
  }
  .community-list-item--active strong {
    color: var(--text);
  }
  .community-list-item--active span {
    color: rgba(242, 244, 245, 0.78);
  }
  .community-link-row:hover strong {
    color: var(--accent-hover);
  }
  .devices-scenarios {
    display: grid;
  }
  @media (max-width: 900px) {
    .devices-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

