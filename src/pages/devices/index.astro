---
export const prerender = false;

import CommunityLayout from "../../layouts/CommunityLayout.astro";
import { brandCatalog, getBrandCount, getDeviceBySlug, getRouteCount, getVisibleDevices, routeCatalog } from "../../lib/device-catalog";

type RouteKey = (typeof routeCatalog)[number]["key"];
type BrandKey = (typeof brandCatalog)[number]["key"];

const selectedRouteKey = (Astro.url.searchParams.get("route")?.trim().toLowerCase() ?? "display") as RouteKey;
const selectedBrandKey = (Astro.url.searchParams.get("brand")?.trim().toLowerCase() ?? "") as BrandKey | "";

const selectedRoute = routeCatalog.find((route) => route.key === selectedRouteKey) ?? routeCatalog[0];
const selectedBrand = brandCatalog.find((brand) => brand.key === selectedBrandKey) ?? null;

const visibleDevices = getVisibleDevices({
  brandKey: selectedBrand?.key ?? null,
  routeKey: selectedBrand ? null : selectedRoute.key,
});

const activeHeading = selectedBrand ? `${selectedBrand.label} 机型` : selectedRoute.title;
const activeDescription = selectedBrand
  ? `当前只显示 ${selectedBrand.label} 相关设备，便于按品牌快速比较。`
  : selectedRoute.description;
const activeNotes = selectedBrand
  ? [
      "同品牌设备也可能跨路线，先看每台设备的适合对象和参数总览。",
      "如果你要横向比较技术方向，回到路线筛选视图会更快。",
    ]
  : selectedRoute.notes;

function buildQueryHref(params: { route?: string; brand?: string }) {
  const query = new URLSearchParams();
  if (params.route) query.set("route", params.route);
  if (params.brand) query.set("brand", params.brand);
  const queryString = query.toString();
  return `/devices/${queryString ? `?${queryString}` : ""}`;
}
---

<CommunityLayout
  title="设备库"
  description="按路线、品牌和使用场景查看 AR / AI 眼镜资料。"
  canonical="https://openglasshub.pages.dev/devices/"
  activeSection="products"
>
  <section class="device-index-head">
    <div>
      <h1>设备库</h1>
      <p>先按路线缩小范围，再看每台设备的参数、定位和风险边界。</p>
    </div>
    <div class="device-index-head__actions">
      <a href="/guides/" class="community-button--secondary">选购指南</a>
      <a href="/developers/" class="community-button">开发者资源</a>
    </div>
  </section>

  <section class="community-surface device-toolbar">
    <div class="device-toolbar__group">
      <span class="device-toolbar__label">路线</span>
      <div class="device-toolbar__chips">
        {routeCatalog.map((route) => (
          <a
            href={buildQueryHref({ route: route.key })}
            class:list={["community-inline-link", { "community-inline-link--active": !selectedBrand && selectedRoute.key === route.key }]}
          >
            {route.label}
            <small>{getRouteCount(route.key)}</small>
          </a>
        ))}
      </div>
    </div>

    <div class="device-toolbar__group">
      <span class="device-toolbar__label">品牌</span>
      <div class="device-toolbar__chips">
        <a
          href={buildQueryHref({ route: selectedRoute.key })}
          class:list={["community-inline-link", { "community-inline-link--active": !selectedBrand }]}
        >
          当前路线
        </a>
        {brandCatalog.map((brand) => (
          <a
            href={buildQueryHref({ brand: brand.key })}
            class:list={["community-inline-link", { "community-inline-link--active": selectedBrand?.key === brand.key }]}
          >
            {brand.label}
            <small>{getBrandCount(brand.key)}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="device-overview-grid">
    <article class="community-surface device-overview">
      <span class="device-overview__eyebrow">当前视图</span>
      <h2>{activeHeading}</h2>
      <p>{activeDescription}</p>
      <div class="device-overview__meta">
        <span>{visibleDevices.length} 台设备</span>
        {!selectedBrand && <span>{selectedRoute.label}</span>}
        {selectedBrand && <span>{selectedBrand.label}</span>}
      </div>
    </article>

    <article class="community-surface device-overview device-overview--notes">
      <span class="device-overview__eyebrow">看什么</span>
      <h2>{selectedBrand ? "先看参数，再看定位" : selectedRoute.title}</h2>
      <ul>
        {activeNotes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </article>
  </section>

  <section class="device-list">
    {visibleDevices.map((device) => (
      <article class="community-surface device-row">
        <div class="device-row__main">
          <div class="device-row__head">
            <div class="device-row__title">
              <div class="device-row__badges">
                <span>{device.routeLabel}</span>
                <span>{device.brandLabel}</span>
                {device.lastCheckedLabel && <span>更新 {device.lastCheckedLabel}</span>}
              </div>
              <h2>{device.title}</h2>
              <p>{device.short}</p>
            </div>
            <div class="device-row__actions">
              <a href={`/devices/${device.slug}/`} class="community-button">查看详情</a>
              <a href={device.sourceUrl} target="_blank" rel="noreferrer" class="community-button--secondary">官方参考</a>
            </div>
          </div>

          {device.previewSpecs.length > 0 && (
            <div class="device-row__specs">
              {device.previewSpecs.map((spec) => (
                <article class="device-spec-pill">
                  <span>{spec.label}</span>
                  <strong>{spec.value}</strong>
                </article>
              ))}
            </div>
          )}

          <div class="device-row__summary">
            <article class="device-summary-block">
              <span>一句判断</span>
              <p>{device.summary}</p>
            </article>
            <article class="device-summary-block">
              <span>更适合</span>
              <p>{device.fit}</p>
            </article>
            <article class="device-summary-block">
              <span>不太适合</span>
              <p>{device.avoid}</p>
            </article>
          </div>
        </div>

        <aside class="device-row__side">
          <div class="device-row__side-box">
            <span>已整理参数</span>
            <strong>{device.knownSpecCount}</strong>
          </div>
          <div class="device-row__side-box">
            <span>数据完整度</span>
            <strong>{device.confidenceLabel ?? "待补充"}</strong>
          </div>
          {device.snapshot?.official_image_url && (
            <a href={device.snapshot.official_image_url} target="_blank" rel="noreferrer" class="device-row__image-link">
              查看官方图片参考
            </a>
          )}
        </aside>
      </article>
    ))}
  </section>
</CommunityLayout>

<style>
  .device-index-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0 1rem;
  }
  .device-index-head h1 {
    margin: 0;
    font-size: 2rem;
    letter-spacing: -0.03em;
  }
  .device-index-head p {
    margin: 0.45rem 0 0;
    color: var(--text-muted);
    max-width: 48ch;
  }
  .device-index-head__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .device-toolbar {
    display: grid;
    gap: 1rem;
    padding: 1rem;
  }
  .device-toolbar__group {
    display: grid;
    gap: 0.55rem;
  }
  .device-toolbar__label {
    color: var(--text-faint);
    font-size: 0.82rem;
  }
  .device-toolbar__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .device-toolbar__chips :global(.community-inline-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .device-toolbar__chips small {
    color: var(--text-faint);
    font-size: 0.74rem;
  }
  .device-overview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
    gap: 1rem;
    margin-top: 1rem;
  }
  .device-overview {
    display: grid;
    gap: 0.6rem;
    padding: 1rem;
  }
  .device-overview__eyebrow {
    color: var(--text-faint);
    font-size: 0.82rem;
  }
  .device-overview h2 {
    margin: 0;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }
  .device-overview p,
  .device-overview li {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.62;
  }
  .device-overview__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .device-overview__meta span {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(242, 244, 245, 0.78);
    font-size: 0.78rem;
  }
  .device-overview--notes ul {
    display: grid;
    gap: 0.5rem;
    padding-left: 1rem;
    margin: 0;
  }
  .device-list {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }
  .device-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 1rem;
    padding: 1rem;
  }
  .device-row__main {
    display: grid;
    gap: 0.9rem;
  }
  .device-row__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .device-row__title {
    display: grid;
    gap: 0.45rem;
  }
  .device-row__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .device-row__badges span {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.07);
    color: rgba(242, 244, 245, 0.72);
    font-size: 0.74rem;
    font-weight: 600;
  }
  .device-row h2 {
    margin: 0;
    font-size: 1.22rem;
    letter-spacing: -0.02em;
  }
  .device-row__title p,
  .device-summary-block p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.62;
    text-wrap: pretty;
  }
  .device-row__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: flex-end;
  }
  .device-row__specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.65rem;
  }
  .device-spec-pill,
  .device-summary-block,
  .device-row__side-box {
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.025);
  }
  .device-spec-pill {
    display: grid;
    gap: 0.25rem;
    padding: 0.8rem 0.85rem;
  }
  .device-spec-pill span,
  .device-summary-block span,
  .device-row__side-box span {
    color: var(--text-faint);
    font-size: 0.78rem;
  }
  .device-spec-pill strong,
  .device-row__side-box strong {
    color: var(--text);
    font-size: 0.96rem;
    line-height: 1.4;
  }
  .device-row__summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }
  .device-summary-block {
    display: grid;
    gap: 0.28rem;
    padding: 0.85rem;
  }
  .device-row__side {
    display: grid;
    gap: 0.65rem;
    align-content: start;
  }
  .device-row__side-box {
    display: grid;
    gap: 0.25rem;
    padding: 0.8rem;
  }
  .device-row__image-link {
    color: rgba(242, 244, 245, 0.82);
    font-size: 0.86rem;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    width: fit-content;
  }
  .device-row__image-link:hover {
    color: var(--text);
    border-color: rgba(255, 255, 255, 0.26);
  }
  @media (max-width: 980px) {
    .device-overview-grid,
    .device-row,
    .device-row__summary {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .device-index-head,
    .device-row__head {
      align-items: flex-start;
      flex-direction: column;
    }
    .device-row__actions {
      justify-content: flex-start;
    }
  }
</style>
