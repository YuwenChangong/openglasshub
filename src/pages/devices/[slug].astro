---
export const prerender = false;

import CommunityLayout from "../../layouts/CommunityLayout.astro";
import { getCollection, render } from "astro:content";
import deviceSpecCandidates from "../../data/device-spec-candidates.json";

const slug = Astro.params.slug ?? "";
const docs = await getCollection("docs", ({ slug: s }) => s === `reference/devices/${slug}`);
const entry = docs[0];

if (!entry) {
  return Astro.redirect("/devices/");
}

const { Content } = await render(entry);
const candidateItems = Array.isArray(deviceSpecCandidates?.items) ? deviceSpecCandidates.items : [];
const specEntry = candidateItems.find((item) => item?.slug === slug) ?? null;

const specLabels = {
  display_type: "显示类型",
  resolution: "分辨率",
  refresh_rate: "刷新率",
  brightness: "亮度",
  field_of_view: "视场角",
  ppd: "PPD",
  color_gamut: "色域",
  waveguide_type: "波导类型",
  lens_type: "镜片类型",
  diopter_support: "屈光 / 近视支持",
  myopia_adjustment: "近视调节",
  transparency: "透视能力",
  dimming: "调光",
  chipset: "芯片 / 平台",
  memory: "内存",
  storage: "存储",
  sensors: "传感器",
  camera: "相机",
  microphone: "麦克风",
  speakers: "扬声器",
  connectivity: "连接方式",
  ports: "接口",
  battery_life: "续航",
  battery_capacity: "电池容量",
  charging: "充电",
  power_source: "供电方式",
  weight: "重量",
  dimensions: "尺寸",
  frame_style: "框型",
  ip_rating: "防护等级",
  supported_devices: "兼容设备",
  os_compatibility: "系统兼容",
  sdk_availability: "SDK / 开发支持",
  price: "价格",
  region: "地区",
  availability: "可得性",
  release_year: "发布时间",
} as const;

const specRows = specEntry
  ? Object.entries(specLabels)
      .map(([field, label]) => ({
        field,
        label,
        value: specEntry.specs?.[field] ?? "unknown",
      }))
      .filter((item) => item.value && item.value !== "unknown")
  : [];
---

<CommunityLayout
  title={entry.data.title}
  description={entry.data.description}
  canonical={`https://openglasshub.pages.dev/devices/${slug}/`}
  activeSection="products"
>
  <section class="device-detail-hero">
    <div>
      <span class="device-detail-hero__eyebrow">设备档案</span>
      <h1>{entry.data.title}</h1>
      {entry.data.description && <p class="community-page-lead">{entry.data.description}</p>}
    </div>
    <div class="device-detail-hero__actions">
      <a href="/devices/" class="community-button--secondary">返回设备库</a>
      <a href="/feed/" class="community-button">进入论坛讨论</a>
    </div>
  </section>

  <section class="community-grid device-detail-layout">
    <article class="community-surface community-surface--padded detail-main device-detail-main">
      {specEntry && (
        <section class="device-spec-snapshot">
          <div class="device-spec-snapshot__head">
            <div>
              <span class="device-detail-hero__eyebrow">官方参数快照</span>
              <h2>结构化设备参数</h2>
            </div>
            <div class="device-spec-snapshot__meta">
              <span>confidence: {specEntry.confidence}</span>
              <span>last checked: {specEntry.last_checked_at}</span>
            </div>
          </div>

          {specEntry.short_description && <p>{specEntry.short_description}</p>}

          {specRows.length > 0 && (
            <div class="device-spec-table">
              {specRows.map((row) => (
                <div class="device-spec-table__row">
                  <span>{row.label}</span>
                  <strong>{row.value}</strong>
                </div>
              ))}
            </div>
          )}

          <div class="device-spec-links">
            <a href={specEntry.source_url} target="_blank" rel="noreferrer">官方产品页</a>
            {specEntry.official_image_url && (
              <a href={specEntry.official_image_url} target="_blank" rel="noreferrer">官方图片参考</a>
            )}
          </div>

          {specEntry.missing_fields?.length > 0 && (
            <div class="device-spec-missing">
              <strong>仍待核实</strong>
              <span>{specEntry.missing_fields.join("、")}</span>
            </div>
          )}
        </section>
      )}

      <Content />
    </article>
    <aside class="community-sidebar">
      <section class="community-surface community-surface--padded device-detail-side">
        <div class="community-page-lead" style="margin-bottom: 0.4rem;">继续浏览</div>
        <div class="community-list" style="padding: 0;">
          <a class="community-list-item community-link-row" href="/devices/">
            <strong>返回设备库</strong>
            <span>回到品牌与场景入口。</span>
          </a>
          <a class="community-list-item community-link-row" href="/guides/">
            <strong>查看选购指南</strong>
            <span>按用途继续缩小选择范围。</span>
          </a>
          <a class="community-list-item community-link-row" href="/feed/">
            <strong>进入论坛讨论</strong>
            <span>查看真实使用反馈和问题讨论。</span>
          </a>
        </div>
      </section>
    </aside>
  </section>
</CommunityLayout>

<style>
  .device-detail-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1.2rem;
    padding: 1rem 0 1.6rem;
  }
  .device-detail-hero__eyebrow {
    display: inline-flex;
    margin-bottom: 0.55rem;
    color: var(--text-faint);
    font-size: 0.84rem;
  }
  .device-detail-hero h1 {
    margin: 0;
    font-size: clamp(2.6rem, 4.8vw, 3.5rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  .device-detail-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    justify-content: flex-end;
  }
  .device-detail-layout {
    align-items: start;
  }
  .device-detail-main {
    padding: 1.5rem 1.6rem;
  }
  .device-detail-side {
    position: sticky;
    top: 92px;
  }
  .detail-main :global(h2) {
    margin: 1.8rem 0 0.7rem;
    font-size: 1.55rem;
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .detail-main :global(h3) {
    margin: 1.15rem 0 0.45rem;
    font-size: 1.08rem;
    color: var(--text);
  }
  .detail-main :global(p),
  .detail-main :global(li) {
    color: var(--text-muted);
    line-height: 1.7;
    font-size: 1rem;
  }
  .detail-main :global(ul) {
    margin: 0.55rem 0 0;
    padding-left: 1.2rem;
  }
  .detail-main :global(a) {
    color: rgba(242, 244, 245, 0.78);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    padding-bottom: 1px;
    transition: color 140ms ease, border-color 140ms ease;
  }
  .detail-main :global(a:hover) {
    color: var(--text);
    border-color: rgba(255, 255, 255, 0.32);
  }
  .device-spec-snapshot {
    margin-bottom: 1.4rem;
    padding: 1rem 1rem 1.1rem;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
  }
  .device-spec-snapshot__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: start;
  }
  .device-spec-snapshot__head h2 {
    margin: 0;
    font-size: 1.18rem;
    letter-spacing: -0.02em;
  }
  .device-spec-snapshot__meta {
    display: grid;
    gap: 0.22rem;
    text-align: right;
    color: var(--text-faint);
    font-size: 0.84rem;
  }
  .device-spec-table {
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
  }
  .device-spec-table__row {
    display: grid;
    grid-template-columns: minmax(120px, 180px) minmax(0, 1fr);
    gap: 0.9rem;
    padding: 0.68rem 0.78rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.028);
    border: 1px solid rgba(255, 255, 255, 0.07);
  }
  .device-spec-table__row span {
    color: var(--text-faint);
    font-size: 0.92rem;
  }
  .device-spec-table__row strong {
    color: var(--text);
    line-height: 1.5;
    font-size: 0.96rem;
  }
  .device-spec-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1rem;
  }
  .device-spec-links a {
    display: inline-flex;
    align-items: center;
    padding: 0.62rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
  }
  .device-spec-missing {
    display: grid;
    gap: 0.32rem;
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  @media (max-width: 900px) {
    .device-detail-hero {
      grid-template-columns: 1fr;
    }
    .device-detail-hero__actions {
      justify-content: flex-start;
    }
    .device-detail-side {
      position: static;
    }
    .device-spec-snapshot__head,
    .device-spec-table__row {
      grid-template-columns: 1fr;
    }
    .device-spec-snapshot__head {
      display: grid;
    }
    .device-spec-snapshot__meta {
      text-align: left;
    }
  }
</style>
