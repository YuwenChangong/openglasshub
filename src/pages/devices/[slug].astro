---
export const prerender = false;

import CommunityLayout from "../../layouts/CommunityLayout.astro";
import BrandMark from "../../components/products/BrandMark.astro";
import ProductVisual from "../../components/products/ProductVisual.astro";
import { getDeviceBySlug } from "../../lib/device-catalog";

const slug = Astro.params.slug ?? "";
const modules = import.meta.glob("../../content/docs/devices/*.mdx");
const loadEntry = modules[`../../content/docs/devices/${slug}.mdx`];

if (!loadEntry) {
  return Astro.redirect("/products/");
}

const entry = (await loadEntry()) as {
  default: unknown;
  frontmatter: {
    title: string;
    description?: string;
  };
};

const Content = entry.default;
const device = getDeviceBySlug(slug);

if (!device) {
  return Astro.redirect("/products/");
}

const heroLinks = device.externalLinks.slice(0, 2);
---

<CommunityLayout
  title={entry.frontmatter.title}
  description={entry.frontmatter.description}
  canonical={`https://openglasshub.pages.dev/devices/${slug}/`}
  activeSection="products"
>
  <section class="device-detail-head">
    <div class="device-detail-head__visual">
      <ProductVisual imageUrl={device.productImageUrl ?? device.officialImageUrl} alt={device.imageAlt} brandMark={device.brandMarkText} title={device.title} variant="hero" />
    </div>
    <div class="device-detail-head__copy">
      <a href={`/products/${device.brandKey}/`} class="device-detail-head__back">返回 {device.brandLabel}</a>
      <BrandMark text={device.brandMarkText} compact={true} brandKey={device.brandKey} />
      <h1>{entry.frontmatter.title}</h1>
      {entry.frontmatter.description && <p>{entry.frontmatter.description}</p>}
      <div class="device-detail-head__meta">
        <span>{device.routeLabel}</span>
        <span>{device.completenessLabel}{device.completenessPercent ? ` · ${device.completenessPercent}` : ""}</span>
        {device.lastCheckedLabel && <span>更新 {device.lastCheckedLabel}</span>}
      </div>
      {heroLinks.length > 0 && (
        <div class="device-detail-head__actions">
          {heroLinks.map((link, index) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class={index === 0 ? "community-button--secondary" : "community-link"}
            >
              {link.label}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  {device.previewSpecs.length > 0 && (
    <section class="device-key-specs">
      {device.previewSpecs.slice(0, 6).map((spec) => (
        <article class="community-surface device-key-spec">
          <span>{spec.label}</span>
          <strong>{spec.value}</strong>
        </article>
      ))}
    </section>
  )}

  <section class="device-fit-grid">
    <article class="community-surface device-fit-card">
      <h2>适合</h2>
      <ul>
        {device.bestFor.slice(0, 3).map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </article>
    <article class="community-surface device-fit-card">
      <h2>不太适合</h2>
      <ul>
        {device.notIdealFor.slice(0, 3).map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </article>
  </section>

  {device.missingFields.length > 0 && (
    <section class="device-pending-panel">
      <h2>待补充参数</h2>
      <div class="device-pending-panel__list">
        {device.pendingSpecLabels.map((item) => (
          <span>{item}</span>
        ))}
      </div>
    </section>
  )}

  {device.specGroups.length > 0 && (
    <section class="device-spec-panel">
      <h2>参数</h2>
      <div class="device-spec-groups">
        {device.specGroups.map((group) => (
          <section class="device-spec-group">
            <h3>{group.label}</h3>
            <dl>
              {group.items.map((item) => (
                <div class="device-spec-row">
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))}
      </div>
    </section>
  )}

  <section class="device-source-panel">
    <div>
      <h2>来源</h2>
      <p>{device.sourceName}</p>
    </div>
    <div class="device-source-panel__meta">
      {device.lastCheckedLabel && <span>最后核对 {device.lastCheckedLabel}</span>}
      <span>{device.completenessLabel}</span>
    </div>
  </section>

  <article class="device-intro">
    <h2>介绍</h2>
    <Content />
  </article>
</CommunityLayout>

<style>
  .device-detail-head {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: 1rem;
    padding: 0.95rem 0 1rem;
  }
  .device-detail-head__visual {
    min-width: 0;
  }
  .device-detail-head__copy {
    display: grid;
    align-content: start;
    gap: 0.62rem;
    min-width: 0;
  }
  .device-detail-head__back {
    width: fit-content;
    color: var(--text-faint);
    font-size: 0.84rem;
    text-decoration: none;
  }
  .device-detail-head__back:hover {
    color: var(--text);
  }
  .device-detail-head h1 {
    margin: 0;
    color: var(--text);
    font-size: 2.1rem;
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .device-detail-head p {
    margin: 0;
    max-width: 60ch;
    color: var(--text-muted);
    line-height: 1.62;
  }
  .device-detail-head__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .device-detail-head__meta span,
  .device-source-panel p,
  .device-source-panel__meta span {
    color: rgba(245, 245, 245, 0.64);
    font-size: 0.84rem;
  }
  .device-detail-head__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
  }
  .device-key-specs,
  .device-fit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.8rem;
    margin-top: 1rem;
  }
  .device-key-spec,
  .device-fit-card,
  .device-spec-group {
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: linear-gradient(180deg, rgba(13, 16, 20, 0.96), rgba(9, 11, 14, 0.98));
  }
  .device-key-spec {
    display: grid;
    gap: 0.2rem;
    padding: 0.8rem;
  }
  .device-key-spec span,
  .device-spec-row dt {
    color: var(--text-faint);
    font-size: 0.8rem;
  }
  .device-key-spec strong {
    color: var(--text);
    font-size: 1rem;
    line-height: 1.35;
  }
  .device-fit-card {
    padding: 0.85rem 0.95rem;
  }
  .device-fit-card h2,
  .device-spec-panel h2,
  .device-intro h2 {
    margin: 0 0 0.45rem;
    color: var(--text);
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .device-fit-card ul {
    display: grid;
    gap: 0.42rem;
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .device-pending-panel {
    display: grid;
    gap: 0.65rem;
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: linear-gradient(180deg, rgba(13, 16, 20, 0.96), rgba(9, 11, 14, 0.98));
  }
  .device-pending-panel h2 {
    margin: 0;
    color: var(--text);
    font-size: 1.05rem;
  }
  .device-pending-panel__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .device-pending-panel__list span {
    display: inline-flex;
    align-items: center;
    min-height: 1.85rem;
    padding: 0.14rem 0.48rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    color: rgba(245, 245, 245, 0.62);
    font-size: 0.78rem;
  }
  .device-spec-panel,
  .device-intro,
  .device-source-panel {
    margin-top: 1rem;
    padding: 0.95rem 1rem;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: linear-gradient(180deg, rgba(13, 16, 20, 0.96), rgba(9, 11, 14, 0.98));
  }
  .device-spec-groups {
    display: grid;
    gap: 0.8rem;
  }
  .device-spec-group {
    display: grid;
    gap: 0.65rem;
    padding: 0.75rem 0;
    border-radius: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .device-spec-group:last-child { border-bottom: 0; }
  .device-spec-group h3 {
    margin: 0;
    color: var(--text);
    font-size: 0.95rem;
  }
  .device-spec-group dl {
    display: grid;
    gap: 0.55rem;
    margin: 0;
  }
  .device-spec-row {
    display: grid;
    grid-template-columns: minmax(120px, 180px) minmax(0, 1fr);
    gap: 0.9rem;
  }
  .device-spec-row dd {
    margin: 0;
    color: rgba(242, 244, 245, 0.92);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .device-source-panel,
  .device-source-panel__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .device-source-panel h2 {
    margin: 0 0 0.2rem;
    color: var(--text);
    font-size: 1rem;
  }
  .device-intro :global(h2) {
    margin: 1.35rem 0 0.6rem;
    color: var(--text);
    font-size: 1.08rem;
    letter-spacing: -0.02em;
  }
  .device-intro :global(h3) {
    margin: 1rem 0 0.45rem;
    color: var(--text);
    font-size: 0.98rem;
  }
  .device-intro :global(p),
  .device-intro :global(li) {
    color: var(--text-muted);
    line-height: 1.68;
    text-wrap: pretty;
  }
  .device-intro :global(ul) {
    padding-left: 1.1rem;
  }
  .device-intro :global(a) {
    color: rgba(242, 244, 245, 0.82);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .device-intro :global(a:hover) {
    color: var(--text);
    border-color: rgba(255, 255, 255, 0.26);
  }
  @media (max-width: 720px) {
    .device-detail-head {
      grid-template-columns: 1fr;
    }
    .device-spec-row {
      grid-template-columns: 1fr;
      gap: 0.18rem;
    }
    .device-source-panel,
    .device-source-panel__meta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
