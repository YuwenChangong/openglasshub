---
export const prerender = false;

import CommunityLayout from "../../layouts/CommunityLayout.astro";
import { getDeviceBySlug } from "../../lib/device-catalog";

const slug = Astro.params.slug ?? "";
const modules = import.meta.glob("../../content/docs/devices/*.mdx");
const loadEntry = modules[`../../content/docs/devices/${slug}.mdx`];

if (!loadEntry) {
  return Astro.redirect("/products/");
}

const entry = (await loadEntry()) as {
  default: unknown;
  frontmatter: {
    title: string;
    description?: string;
  };
};

const Content = entry.default;
const device = getDeviceBySlug(slug);

if (!device) {
  return Astro.redirect("/products/");
}
---

<CommunityLayout
  title={entry.frontmatter.title}
  description={entry.frontmatter.description}
  canonical={`https://openglasshub.pages.dev/devices/${slug}/`}
  activeSection="products"
>
  <section class="device-detail-head">
    <div class="device-detail-head__copy">
      <a href={`/products/${device.brandKey}/`} class="device-detail-head__back">{device.brandLabel}</a>
      <h1>{entry.frontmatter.title}</h1>
      {entry.frontmatter.description && <p>{entry.frontmatter.description}</p>}
    </div>
    <a href={device.sourceUrl} target="_blank" rel="noreferrer" class="community-button--secondary">官方参考</a>
  </section>

  {device.previewSpecs.length > 0 && (
    <section class="device-key-specs">
      {device.previewSpecs.map((spec) => (
        <article class="community-surface device-key-spec">
          <span>{spec.label}</span>
          <strong>{spec.value}</strong>
        </article>
      ))}
    </section>
  )}

  <section class="device-fit-grid">
    <article class="community-surface device-fit-card">
      <h2>适合</h2>
      <p>{device.fit}</p>
    </article>
    <article class="community-surface device-fit-card">
      <h2>不太适合</h2>
      <p>{device.avoid}</p>
    </article>
  </section>

  {device.specGroups.length > 0 && (
    <section class="community-surface device-spec-panel">
      <h2>参数</h2>
      <div class="device-spec-groups">
        {device.specGroups.map((group) => (
          <section class="device-spec-group">
            <h3>{group.label}</h3>
            <dl>
              {group.items.map((item) => (
                <div class="device-spec-row">
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))}
      </div>
    </section>
  )}

  <article class="community-surface device-intro">
    <h2>介绍</h2>
    <Content />
  </article>
</CommunityLayout>

<style>
  .device-detail-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0 1rem;
  }
  .device-detail-head__copy {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }
  .device-detail-head__back {
    width: fit-content;
    color: var(--text-faint);
    font-size: 0.84rem;
    text-decoration: none;
  }
  .device-detail-head__back:hover {
    color: var(--text);
  }
  .device-detail-head h1 {
    margin: 0;
    color: var(--text);
    font-size: 2.1rem;
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .device-detail-head p {
    margin: 0;
    max-width: 60ch;
    color: var(--text-muted);
    line-height: 1.62;
  }
  .device-key-specs,
  .device-fit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.8rem;
    margin-top: 1rem;
  }
  .device-key-spec,
  .device-fit-card,
  .device-spec-group {
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.025);
  }
  .device-key-spec {
    display: grid;
    gap: 0.2rem;
    padding: 0.9rem;
  }
  .device-key-spec span,
  .device-spec-row dt {
    color: var(--text-faint);
    font-size: 0.8rem;
  }
  .device-key-spec strong {
    color: var(--text);
    font-size: 1rem;
    line-height: 1.35;
  }
  .device-fit-card {
    padding: 0.95rem 1rem;
  }
  .device-fit-card h2,
  .device-spec-panel h2,
  .device-intro h2 {
    margin: 0 0 0.45rem;
    color: var(--text);
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .device-fit-card p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .device-spec-panel,
  .device-intro {
    margin-top: 1rem;
    padding: 1rem;
  }
  .device-spec-groups {
    display: grid;
    gap: 0.8rem;
  }
  .device-spec-group {
    display: grid;
    gap: 0.65rem;
    padding: 0.9rem;
  }
  .device-spec-group h3 {
    margin: 0;
    color: var(--text);
    font-size: 0.95rem;
  }
  .device-spec-group dl {
    display: grid;
    gap: 0.55rem;
    margin: 0;
  }
  .device-spec-row {
    display: grid;
    grid-template-columns: minmax(120px, 180px) minmax(0, 1fr);
    gap: 0.9rem;
  }
  .device-spec-row dd {
    margin: 0;
    color: rgba(242, 244, 245, 0.92);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .device-intro :global(h2) {
    margin: 1.35rem 0 0.6rem;
    color: var(--text);
    font-size: 1.08rem;
    letter-spacing: -0.02em;
  }
  .device-intro :global(h3) {
    margin: 1rem 0 0.45rem;
    color: var(--text);
    font-size: 0.98rem;
  }
  .device-intro :global(p),
  .device-intro :global(li) {
    color: var(--text-muted);
    line-height: 1.68;
    text-wrap: pretty;
  }
  .device-intro :global(ul) {
    padding-left: 1.1rem;
  }
  .device-intro :global(a) {
    color: rgba(242, 244, 245, 0.82);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .device-intro :global(a:hover) {
    color: var(--text);
    border-color: rgba(255, 255, 255, 0.26);
  }
  @media (max-width: 720px) {
    .device-detail-head {
      flex-direction: column;
    }
    .device-spec-row {
      grid-template-columns: 1fr;
      gap: 0.18rem;
    }
  }
</style>
