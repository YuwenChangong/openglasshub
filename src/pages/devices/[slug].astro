---
export const prerender = false;

import CommunityLayout from "../../layouts/CommunityLayout.astro";
import {
  deviceCategoryLabels,
  deviceStatusLabels,
  deviceUseCaseLabels,
  getDeviceLibraryEntry,
} from "../../data/devices";

const slug = Astro.params.slug ?? "";
const device = getDeviceLibraryEntry(slug);

if (!device) {
  Astro.response.status = 404;
}

const title = device ? device.name : "Device Not Found";
const description = device
  ? `${device.name} 的保守版设备摘要、用途标签与来源说明。`
  : "请求的设备条目不存在，或还没有加入当前的 Device Library MVP。";

const keyFacts = device
  ? [
      { label: "品牌", value: device.brand },
      { label: "分类", value: deviceCategoryLabels[device.category] },
      { label: "状态", value: deviceStatusLabels[device.status] },
      { label: "价格", value: device.price_label ?? null },
      { label: "重量", value: device.weight_label ?? null },
      { label: "显示", value: device.display_label ?? null },
      { label: "视场角", value: device.fov_label ?? null },
      { label: "平台", value: device.platform_label ?? null },
      { label: "最后更新", value: device.updated_label ?? null },
    ].filter((item) => item.value)
  : [];
---

<CommunityLayout
  title={title}
  description={description}
  canonical={`https://openglasshub.pages.dev/devices/${slug}/`}
  noindex={!device}
  activeSection="devices"
>
  {device ? (
    <>
      <section class="device-detail-hero">
        <a href="/devices/" class="device-detail-hero__back">返回设备库</a>
        <div class="device-detail-hero__headline">
          <div class="device-detail-hero__eyebrow">
            <span>{device.brand}</span>
            <span>{deviceCategoryLabels[device.category]}</span>
            <span>{deviceStatusLabels[device.status]}</span>
          </div>
          <h1>{device.name}</h1>
          <p>{device.short_description}</p>
        </div>
      </section>

      <section class="device-detail-grid">
        <article class="community-surface community-surface--padded device-detail-panel">
          <div class="device-detail-panel__head">
            <h2>关键事实</h2>
            <span>这版只展示当前确认度较高的信息</span>
          </div>
          <dl class="device-detail-facts">
            {keyFacts.map((fact) => (
              <div class="device-detail-facts__row">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        </article>

        <aside class="device-detail-sidebar">
          <section class="community-surface community-surface--padded device-detail-panel">
            <div class="device-detail-panel__head">
              <h2>适合的用途</h2>
            </div>
            <div class="community-chip-row">
              {device.use_cases.map((useCase) => (
                <span class="community-chip">{deviceUseCaseLabels[useCase]}</span>
              ))}
            </div>
          </section>

          <section class="community-surface community-surface--padded device-detail-panel">
            <div class="device-detail-panel__head">
              <h2>来源与确认度</h2>
            </div>
            <p class="device-detail-panel__copy">
              {device.source_note ?? "当前条目来自静态本地数据，后续会替换成带来源说明的结构化数据。"}
            </p>
            {device.source_url ? (
              <a href={device.source_url} target="_blank" rel="noopener noreferrer" class="community-button--secondary device-detail-source-link">
                查看参考来源
              </a>
            ) : null}
          </section>

          <section class="community-surface community-surface--padded device-detail-panel">
            <div class="device-detail-panel__head">
              <h2>去社区讨论</h2>
            </div>
            <p class="device-detail-panel__copy">
              想看真实体验、购买建议或开发限制，可以直接去社区继续讨论。
            </p>
            <div class="device-detail-actions">
              <a href="/feed/" class="community-button">去动态</a>
              <a href="/circles/" class="community-button--secondary">看圈子</a>
            </div>
          </section>
        </aside>
      </section>
    </>
  ) : (
    <section class="community-empty device-not-found">
      <strong>没有找到这个设备</strong>
      <p>当前 Device Library MVP 还没有这个条目，或者链接 slug 不存在。</p>
      <div class="device-detail-actions">
        <a href="/devices/" class="community-button">返回设备库</a>
        <a href="/feed/" class="community-button--secondary">去社区提问</a>
      </div>
    </section>
  )}
</CommunityLayout>
