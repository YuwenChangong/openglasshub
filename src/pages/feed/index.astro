---
export const prerender = false;

import ForumLayout from "../../layouts/ForumLayout.astro";
import { createSSRClient, type CloudflareEnv } from "../../lib/supabase-server";
import PostCard from "../../components/community/PostCard.astro";
import EmptyFeedState from "../../components/community/EmptyFeedState.astro";
import CircleCard from "../../components/community/CircleCard.astro";
import { isPublicVisibleCircle } from "../../lib/site-navigation";

const env = Astro.locals.runtime.env as CloudflareEnv;
const supabase = createSSRClient(env);

const [{ data: posts, error }, { data: circles }] = await Promise.all([
  supabase
    .from("posts")
    .select("id, title, body, type, created_at, last_activity_at, profiles:author_id(display_name, username), circles:circle_id(slug, name)")
    .eq("status", "published")
    .order("last_activity_at", { ascending: false, nullsFirst: false })
    .order("created_at", { ascending: false })
    .limit(50),
  supabase
    .from("circles")
    .select("slug, name, description")
    .order("name", { ascending: true }),
]);

const visibleCircles = (circles ?? []).filter((circle) => isPublicVisibleCircle(circle)).slice(0, 5);

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
}

const postTypeLabels: Record<string, string> = {
  experience: "体验",
  question: "提问",
  review: "评测",
  dev: "开发",
  news: "资讯",
  feedback: "反馈",
};
---

<ForumLayout
  title="帖子动态"
  description="OpenGlass Hub 论坛最新公开帖子。AR/AI 眼镜社区讨论动态。"
  canonical="https://openglasshub.pages.dev/feed/"
  activeTab="feed"
>
  <h1>帖子动态</h1>
  <p class="section-lead">围绕设备体验、选购判断、开发约束和项目方向的公开讨论流。这里只显示真实公开帖子，不补假热度。</p>

  <section class="community-grid" style="margin-top: 1.1rem;">
    <div class="community-surface">
      <div class="community-section-head">
        <div>
          <h2>公开动态</h2>
          <p>按最新公开活动排序。没帖子时也会保留明确的社区启动状态和发帖入口。</p>
        </div>
        <div class="feed-head-actions">
          <span class="community-chip">文字</span>
          <span class="community-chip">求助</span>
          <span class="community-chip">体验/评测</span>
          <a href="/posts/new/" class="community-link">去发帖</a>
        </div>
      </div>

      {error ? (
        <div class="community-empty">
          <strong>加载帖子失败</strong>
          <p>{error.message}</p>
        </div>
      ) : !posts || posts.length === 0 ? (
        <EmptyFeedState />
      ) : (
        <div class="community-feed-list">
          {posts.map((post) => (
            <PostCard
              id={post.id}
              title={post.title}
              excerpt={post.body ? post.body.replace(/[#*_`>\n\r]+/g, " ").replace(/\s+/g, " ").trim().slice(0, 120) : ""}
              circleName={post.circles?.name ?? undefined}
              circleSlug={post.circles?.slug ?? undefined}
              typeLabel={post.type ? (postTypeLabels[post.type] || post.type) : undefined}
              authorName={post.profiles?.display_name || post.profiles?.username || undefined}
              timestamp={formatDate(post.last_activity_at || post.created_at)}
            />
          ))}
        </div>
      )}
    </div>

    <aside class="community-sidebar">
      <section class="community-surface community-surface--padded">
        <div class="community-page-lead" style="margin-bottom: 0.55rem;">社区入口</div>
        <h2 style="margin: 0 0 0.35rem;">准备发帖？</h2>
        <p style="margin: 0; color: #97a8c8;">先看圈子，再决定内容放在哪个主题下更清楚。设备体验、选购求助、开发限制都适合从这里开始。</p>
        <div class="community-chip-row" style="margin-top: 1rem;">
          <span class="community-chip">设备体验</span>
          <span class="community-chip">选购求助</span>
          <span class="community-chip">开发问题</span>
        </div>
        <div class="community-cta-row" style="margin-top: 1rem;">
          <a href="/posts/new/" class="community-button">发布帖子</a>
          <a href="/circles/" class="community-button--secondary">浏览圈子</a>
        </div>
      </section>

      <section class="community-surface">
        <div class="community-section-head">
          <h2>圈子推荐</h2>
          <a href="/circles/" class="community-link">全部</a>
        </div>
        <div class="community-card-list">
          {visibleCircles.map((circle) => (
            <CircleCard name={circle.name} slug={circle.slug} description={circle.description || undefined} />
          ))}
        </div>
      </section>
    </aside>
  </section>
</ForumLayout>

<style>
  .feed-head-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  @media (max-width: 900px) {
    .feed-head-actions {
      justify-content: flex-start;
    }
  }
</style>
