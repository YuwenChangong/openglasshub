---
export const prerender = false;

import ForumLayout from "../../layouts/ForumLayout.astro";
import { createSSRClient, type CloudflareEnv } from "../../lib/supabase-server";
import PostCard from "../../components/community/PostCard.astro";
import EmptyFeedState from "../../components/community/EmptyFeedState.astro";
import { formatPostTime } from "../../lib/format-time";
import { isPublicVisibleCircle } from "../../lib/site-navigation";
import { buildResolvedPostMediaMap, type PostMediaRow } from "../../lib/forum-media";
import { buildPostCommentCountMap, buildPostLikeCountMap, isMissingViewCountError } from "../../lib/post-engagement";
import { sanitizeBodyForDisplay } from "../../lib/post-body";

const env = Astro.locals.runtime.env as CloudflareEnv;
const supabase = createSSRClient(env);
const r2PublicBaseUrl = env.R2_PUBLIC_BASE_URL || "";
const sort = Astro.url.searchParams.get("sort") === "hot" ? "hot" : "latest";

const baseLimit = sort === "hot" ? 120 : 50;
const postsWithViewCountQuery = supabase
  .from("posts")
  .select("id, title, body, type, created_at, last_activity_at, view_count, profiles:author_id(display_name, username), circles:circle_id(slug, name), post_media(*)")
  .eq("status", "published")
  .order("created_at", { ascending: false })
  .limit(baseLimit);
const postsWithoutViewCountQuery = supabase
  .from("posts")
  .select("id, title, body, type, created_at, last_activity_at, profiles:author_id(display_name, username), circles:circle_id(slug, name), post_media(*)")
  .eq("status", "published")
  .order("created_at", { ascending: false })
  .limit(baseLimit);

const [{ data: fetchedPostsWithViewCount, error: viewCountQueryError }, { data: circles }] = await Promise.all([
  postsWithViewCountQuery,
  supabase
    .from("circles")
    .select("slug, name, description")
    .order("name", { ascending: true }),
]);

let fetchedPosts = fetchedPostsWithViewCount ?? [];
let error = viewCountQueryError;
let supportsViewCount = !viewCountQueryError;

if (viewCountQueryError && isMissingViewCountError(viewCountQueryError)) {
  console.warn("[feed-hot-sort] view_count unavailable, falling back", viewCountQueryError.message);
  const fallbackResult = await postsWithoutViewCountQuery;
  fetchedPosts = fallbackResult.data ?? [];
  error = fallbackResult.error;
  supportsViewCount = false;
}

const likeCountMap = fetchedPosts ? await buildPostLikeCountMap(supabase, fetchedPosts.map((post) => post.id)) : new Map();
const commentCountMap = fetchedPosts ? await buildPostCommentCountMap(supabase, fetchedPosts.map((post) => post.id)) : new Map();
const posts = [...(fetchedPosts ?? [])]
  .sort((left, right) => {
    if (sort === "latest") {
      return new Date(right.created_at).getTime() - new Date(left.created_at).getTime();
    }

    const leftScore =
      (commentCountMap.get(left.id) ?? 0) * 3 +
      (likeCountMap.get(left.id) ?? 0) * 2 +
      Number(supportsViewCount ? left.view_count ?? 0 : 0);
    const rightScore =
      (commentCountMap.get(right.id) ?? 0) * 3 +
      (likeCountMap.get(right.id) ?? 0) * 2 +
      Number(supportsViewCount ? right.view_count ?? 0 : 0);

    if (rightScore !== leftScore) {
      return rightScore - leftScore;
    }

    return new Date(right.created_at).getTime() - new Date(left.created_at).getTime();
  })
  .slice(0, 50);

const postMediaMap = posts.length > 0
  ? await buildResolvedPostMediaMap(
      supabase,
      posts as Array<{ id: string; post_media?: PostMediaRow[] | null }>,
      60 * 60,
      r2PublicBaseUrl,
    )
  : new Map();

const visibleCircles = (circles ?? []).filter((circle) => isPublicVisibleCircle(circle)).slice(0, 5);

const postTypeLabels: Record<string, string> = {
  experience: "体验",
  question: "提问",
  review: "评测",
  dev: "开发",
  news: "资讯",
  feedback: "反馈",
};
---

<ForumLayout
  title="帖子动态"
  description="OpenGlass Hub 论坛最新公开帖子。AR/AI 眼镜社区讨论动态。"
  canonical="https://openglasshub.pages.dev/feed/"
  activeTab="feed"
>
  <section class="community-grid">
    <div class="community-feed-column">
      <div class="community-stream-head">
        <div>
          <h2>帖子动态</h2>
          <p>浏览公开讨论，支持按发布时间或真实热度切换。</p>
        </div>
        <div class="feed-head-actions community-inline-links">
          <a href="/feed/?sort=latest" class={`community-inline-link${sort === "latest" ? " community-inline-link--active" : ""}`}>最新</a>
          <a href="/feed/?sort=hot" class={`community-inline-link${sort === "hot" ? " community-inline-link--active" : ""}`}>热门</a>
          <a href="/posts/new/" class="community-inline-link">发帖</a>
        </div>
      </div>

      {error ? (
        <div class="community-empty">
          <strong>加载帖子失败</strong>
          <p>{error.message}</p>
        </div>
      ) : !posts || posts.length === 0 ? (
        <EmptyFeedState />
      ) : (
        <div class="community-feed-list">
          {posts.map((post) => (
            <PostCard
              id={post.id}
              title={post.title}
              excerpt={sanitizeBodyForDisplay(post.body).replace(/[#*_`>\n\r]+/g, " ").replace(/\s+/g, " ").trim().slice(0, 120)}
              circleName={post.circles?.name ?? undefined}
              circleSlug={post.circles?.slug ?? undefined}
              typeLabel={post.type ? (postTypeLabels[post.type] || post.type) : undefined}
              authorName={post.profiles?.display_name || post.profiles?.username || undefined}
              timestamp={formatPostTime(post.created_at)}
              media={postMediaMap.get(post.id) ?? []}
              likeCount={likeCountMap.get(post.id) ?? 0}
            />
          ))}
        </div>
      )}
    </div>

    <aside class="community-sidebar">
      <section class="community-sidebar-block community-sidebar-block--strong">
        <div class="community-page-lead" style="margin-bottom: 0.4rem;">开始发帖</div>
        <h2 style="margin: 0 0 0.3rem;">有新内容想发？</h2>
        <p style="margin: 0; color: var(--text-muted);">登录后即可把问题、体验和观察发到对应圈子。</p>
        <div class="community-cta-row" style="margin-top: 0.85rem;">
          <a href="/posts/new/" class="community-button">发布帖子</a>
          <a href="/circles/" class="community-button--secondary">浏览圈子</a>
        </div>
      </section>

      <section class="community-sidebar-block">
        <div class="community-sidebar-head">
          <h2>圈子推荐</h2>
          <a href="/circles/" class="community-link">全部</a>
        </div>
        <div class="community-list">
          {visibleCircles.map((circle) => (
            <a href={`/circles/${circle.slug}/`} class="community-list-item">
              <strong>{circle.name}</strong>
              <span>{circle.description || "进入圈子查看当前公开讨论。"}</span>
            </a>
          ))}
        </div>
      </section>
    </aside>
  </section>
</ForumLayout>

<style>
  .community-feed-column {
    min-width: 0;
  }
  .community-stream-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0 0.8rem;
    margin-bottom: 0.2rem;
    border-bottom: 1px solid var(--border);
  }
  .community-stream-head h2 {
    margin: 0;
    font-size: 1.12rem;
  }
  .community-stream-head p {
    margin: 0.2rem 0 0;
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .feed-head-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  @media (max-width: 900px) {
    .community-stream-head {
      align-items: flex-start;
      flex-direction: column;
    }
    .feed-head-actions {
      justify-content: flex-start;
    }
  }
</style>

