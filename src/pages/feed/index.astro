---
export const prerender = false;

import ForumLayout from "../../layouts/ForumLayout.astro";
import { createSSRClient, type CloudflareEnv } from "../../lib/supabase-server";
import PostCard from "../../components/community/PostCard.astro";
import EmptyFeedState from "../../components/community/EmptyFeedState.astro";
import { isPublicVisibleCircle } from "../../lib/site-navigation";
import { buildResolvedPostMediaMap, type PostMediaRow } from "../../lib/forum-media";

const env = Astro.locals.runtime.env as CloudflareEnv;
const supabase = createSSRClient(env);

const [{ data: posts, error }, { data: circles }] = await Promise.all([
  supabase
    .from("posts")
    .select("id, title, body, type, created_at, last_activity_at, profiles:author_id(display_name, username), circles:circle_id(slug, name), post_media(id, post_id, kind, url, storage_path, thumbnail_url, alt_text, width, height, duration_seconds, size_bytes, mime_type, sort_order, is_cover, created_at)")
    .eq("status", "published")
    .order("last_activity_at", { ascending: false, nullsFirst: false })
    .order("created_at", { ascending: false })
    .limit(50),
  supabase
    .from("circles")
    .select("slug, name, description")
    .order("name", { ascending: true }),
]);

const postMediaMap = posts ? await buildResolvedPostMediaMap(supabase, posts as Array<{ id: string; post_media?: PostMediaRow[] | null }>) : new Map();

const visibleCircles = (circles ?? []).filter((circle) => isPublicVisibleCircle(circle)).slice(0, 5);

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
}

const postTypeLabels: Record<string, string> = {
  experience: "体验",
  question: "提问",
  review: "评测",
  dev: "开发",
  news: "资讯",
  feedback: "反馈",
};
---

<ForumLayout
  title="帖子动态"
  description="OpenGlass Hub 论坛最新公开帖子。AR/AI 眼镜社区讨论动态。"
  canonical="https://openglasshub.pages.dev/feed/"
  activeTab="feed"
>
  <section class="community-grid">
    <div class="community-surface">
      <div class="community-section-head">
        <div>
          <h2>帖子动态</h2>
          <p>按最近公开活动排序，只显示真实帖子。</p>
        </div>
        <div class="feed-head-actions community-inline-links">
          <a href="/feed/" class="community-inline-link">最新</a>
          <span class="community-meta">热门</span>
          <a href="/circles/" class="community-inline-link">圈子</a>
          <a href="/posts/new/" class="community-inline-link">发帖</a>
        </div>
      </div>

      {error ? (
        <div class="community-empty">
          <strong>加载帖子失败</strong>
          <p>{error.message}</p>
        </div>
      ) : !posts || posts.length === 0 ? (
        <EmptyFeedState />
      ) : (
        <div class="community-feed-list">
          {posts.map((post) => (
            <PostCard
              id={post.id}
              title={post.title}
              excerpt={post.body ? post.body.replace(/[#*_`>\n\r]+/g, " ").replace(/\s+/g, " ").trim().slice(0, 120) : ""}
              circleName={post.circles?.name ?? undefined}
              circleSlug={post.circles?.slug ?? undefined}
              typeLabel={post.type ? (postTypeLabels[post.type] || post.type) : undefined}
              authorName={post.profiles?.display_name || post.profiles?.username || undefined}
              timestamp={formatDate(post.last_activity_at || post.created_at)}
              media={postMediaMap.get(post.id) ?? []}
            />
          ))}
        </div>
      )}
    </div>

    <aside class="community-sidebar">
      <section class="community-surface community-surface--padded">
        <div class="community-page-lead" style="margin-bottom: 0.4rem;">发帖入口</div>
        <h2 style="margin: 0 0 0.3rem;">准备发帖？</h2>
        <p style="margin: 0; color: var(--text-muted);">先看圈子，再决定内容放到哪里更清楚。</p>
        <div class="community-cta-row" style="margin-top: 0.85rem;">
          <a href="/posts/new/" class="community-button">发布帖子</a>
          <a href="/circles/" class="community-button--secondary">浏览圈子</a>
        </div>
      </section>

      <section class="community-surface">
        <div class="community-section-head">
          <h2>圈子推荐</h2>
          <a href="/circles/" class="community-link">全部</a>
        </div>
        <div class="community-list">
          {visibleCircles.map((circle) => (
            <a href={`/circles/${circle.slug}/`} class="community-list-item">
              <strong>{circle.name}</strong>
              <span>{circle.description || "进入圈子查看当前公开讨论。"}</span>
            </a>
          ))}
        </div>
      </section>
    </aside>
  </section>
</ForumLayout>

<style>
  .feed-head-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  @media (max-width: 900px) {
    .feed-head-actions {
      justify-content: flex-start;
    }
  }
</style>
