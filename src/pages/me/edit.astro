---
export const prerender = false;

import CommunityLayout from "../../layouts/CommunityLayout.astro";
import EditProfileForm from "../../components/profile/EditProfileForm";
---

<CommunityLayout title="编辑资料" activeSection="forum" noindex={true}>
  <main class="community-main community-main--narrow">
    <nav class="community-inline-links" aria-label="资料导航">
      <a href="/me/" class="community-inline-link">我的主页</a>
      <a href="/me/edit/" class="community-inline-link community-inline-link--active">编辑资料</a>
      <a href="/feed/" class="community-inline-link">返回论坛</a>
    </nav>
    <EditProfileForm client:load />
  </main>
</CommunityLayout>
