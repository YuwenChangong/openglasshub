---
import CommunityLayout from "../../layouts/CommunityLayout.astro";
import ProductCard from "../../components/community/ProductCard.astro";

const decisionPaths = [
  {
    title: "看电影 / 大屏",
    description: "先看显示型眼镜。重点是显示效果、连接方式、佩戴舒适度，而不是营销里的 AI 标签。",
    href: "/guides/ar-ai-glasses-buying-guide-2026/",
  },
  {
    title: "拍摄 / 语音 / AI",
    description: "先看智能眼镜路线，重点确认摄像头边界、语音入口和日常佩戴价值。",
    href: "/guides/ar-ai-xr-glasses-difference/",
  },
  {
    title: "空间计算 / 开发",
    description: "先判断是不是独立 AR 设备，再核对 SDK、输入权限和安装路径。",
    href: "/guides/best-ar-ai-glasses-for-developers/",
  },
] as const;

const guideSections = [
  {
    title: "显示型眼镜",
    description: "适合观影、掌机、PC 第二屏和移动办公，重点不是独立系统。",
  },
  {
    title: "AI 眼镜",
    description: "适合拍摄、语音、消息处理和轻量 AI 入口，不应误当成 AR 显示设备。",
  },
  {
    title: "独立 AR",
    description: "更适合研究导航、翻译和系统边界，但风险通常也更高。",
  },
  {
    title: "开发 / 实验用途",
    description: "先看开发限制，再谈“最适合”或“最开放”，不要直接套消费逻辑。",
  },
] as const;
---

<CommunityLayout
  title="选购指南"
  description="先判断用途，再看设备参数。"
  canonical="https://openglasshub.pages.dev/guides/"
  activeSection="products"
>
  <section class="community-page-head">
    <div>
      <span class="guides-kicker">选购判断</span>
      <h1>选购指南</h1>
      <p class="community-page-lead">先判断用途，再看设备参数。这里不做假榜单，只帮助你更快缩小方向。</p>
    </div>
  </section>

  <section class="community-surface community-surface--primary">
    <div class="guides-visual">
      <div class="guides-visual__step">
        <strong>观影 / 大屏</strong>
        <span>先看显示型眼镜</span>
      </div>
      <div class="guides-visual__step">
        <strong>拍摄 / 语音 / AI</strong>
        <span>先看智能眼镜路线</span>
      </div>
      <div class="guides-visual__step">
        <strong>空间计算 / 开发</strong>
        <span>再核对独立 AR 与 SDK 限制</span>
      </div>
    </div>
    <div class="community-section-head">
      <div>
        <h2>先做用途判断</h2>
        <p>不要先问“哪台最好”，先问你到底想拿它做什么。</p>
      </div>
      <a href="/reference/guides-docs/" class="community-link">查看技术索引</a>
    </div>
    <div class="guides-grid">
      {decisionPaths.map((item) => (
        <ProductCard label="决策路径" title={item.title} description={item.description} href={item.href} />
      ))}
    </div>
  </section>

  <section class="community-grid" style="margin-top: 1rem;">
    <section class="community-surface community-surface--primary">
      <div class="community-section-head">
        <div>
          <h2>路线判断</h2>
          <p>四类常见路线，帮助你先做方向上的过滤。</p>
        </div>
      </div>
      <div class="community-list">
        {guideSections.map((item) => (
          <article class="community-list-item">
            <strong>{item.title}</strong>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <aside class="community-sidebar">
      <section class="community-surface community-surface--padded community-surface--primary">
        <div class="community-page-lead" style="margin-bottom: 0.35rem;">继续往下看</div>
        <div class="community-list" style="padding: 0;">
          <a class="community-list-item community-link-row" href="/devices/">
            <strong>去设备库</strong>
            <span>看具体设备定位与待核实边界</span>
          </a>
          <a class="community-list-item community-link-row" href="/developers/">
            <strong>去开发者入口</strong>
            <span>先确认 SDK、权限和部署限制</span>
          </a>
        </div>
      </section>
    </aside>
  </section>
</CommunityLayout>

<style>
  .guides-kicker {
    display: inline-flex;
    margin-bottom: 0.45rem;
    color: var(--accent-hover);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .guides-visual {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
    padding: 1rem 1rem 0.2rem;
  }
  .guides-visual__step {
    display: grid;
    gap: 0.18rem;
    padding: 0.8rem 0.85rem;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(255,255,255,0.025), transparent);
  }
  .guides-visual__step strong {
    color: var(--text);
    font-size: 0.9rem;
  }
  .guides-visual__step span {
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .guides-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    padding: 0.9rem 1rem 1rem;
  }
  .community-link-row {
    text-decoration: none;
  }
  .community-link-row:hover strong {
    color: var(--accent-hover);
  }
  @media (max-width: 900px) {
    .guides-visual,
    .guides-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
