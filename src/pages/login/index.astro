---
export const prerender = false;

import ForumLayout from "../../layouts/ForumLayout.astro";
import AuthPanel from "../../components/forum/AuthPanel";
import { getSafeNext } from "../../lib/auth-redirect";

const next = getSafeNext(Astro.url.searchParams.get("next"));
---

<ForumLayout
  title="登录"
  description="登录 OpenGlass Hub。浏览内容无需登录，发帖和评论等互动操作需要认证。"
  canonical="https://openglasshub.pages.dev/login/"
>
  <header class="page-intro">
    <h1>登录 / 注册</h1>
    <p class="page-lead">
      OpenGlass Hub 采用全站级登录。浏览设备、指南、动态和帖子无需登录，只有发帖、评论等互动操作才需要认证。
    </p>
  </header>
  <AuthPanel next={next} client:only="react" />
</ForumLayout>
