---
export const prerender = false;

import { env as runtimeEnv } from "cloudflare:workers";
import CommunityLayout from "../../layouts/CommunityLayout.astro";
import AuthPanel from "../../components/forum/AuthPanel";
import { getSafeNext } from "../../lib/auth-redirect";
import { configureAuthLoginResponse } from "../../lib/server/auth-login-response";
import { resolveLocale } from "../../lib/i18n/locale";
import { getUiMessages } from "../../lib/i18n/catalog";
const localeContext = Astro.locals.localeContext ?? resolveLocale({});
const text = getUiMessages(localeContext.locale).account;

const captchaMode = configureAuthLoginResponse(Astro.response, runtimeEnv);
const next = getSafeNext(Astro.url.searchParams.get("next"));
const modeParam = Astro.url.searchParams.get("mode");
const initialMode = modeParam === "register" || modeParam === "signup" ? "signup" : "login";
---

<CommunityLayout
  title={text.loginTitle}
  description={text.loginDescription}
  canonical="/login/"
  noindex={true}
>
  <section class="auth-page">
    <div class="auth-page__intro">
      <h1>{text.loginHeading}</h1>
    </div>
    <AuthPanel locale={localeContext.locale} localeContext={localeContext} next={next} initialMode={initialMode} captchaMode={captchaMode} authTurnstileSiteKey={runtimeEnv.PUBLIC_AUTH_TURNSTILE_SITE_KEY} client:only="react" />
  </section>
</CommunityLayout>

<style>
  .auth-page {
    width: min(100%, 480px);
    margin: 2rem auto 0;
    display: grid;
    gap: 1rem;
  }
  .auth-page__intro {
    display: grid;
    gap: 0.4rem;
    text-align: center;
  }
  .auth-page__intro h1 {
    margin: 0;
    font-size: 1.9rem;
    letter-spacing: -0.04em;
  }
</style>
