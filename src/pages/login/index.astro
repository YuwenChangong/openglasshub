---
export const prerender = false;

import ForumLayout from "../../layouts/ForumLayout.astro";
import AuthPanel from "../../components/forum/AuthPanel";

const next = Astro.url.searchParams.get("next") ?? "/";
---

<ForumLayout
  title="登录"
  description="登录 OpenGlass Hub。浏览内容无需登录，发帖和评论等互动操作需要认证。"
  canonical="https://openglasshub.pages.dev/login/"
>
  <h1>登录 / 注册</h1>
  <p style="color: #8892b0; margin-top: -0.5rem;">
    OpenGlass Hub 采用全站级登录。浏览设备、指南、动态和帖子无需登录，互动操作才需要认证。
  </p>
  <AuthPanel next={next} client:only="react" />
</ForumLayout>
