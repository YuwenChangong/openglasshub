---
export const prerender = false;

import { env as runtimeEnv } from "cloudflare:workers";
import CommunityLayout from "../../layouts/CommunityLayout.astro";
import MyProfilePage from "../../components/profile/MyProfilePage";
import { createSSRClient, type CloudflareEnv } from "../../lib/supabase-server";
import {
  getProfileByUsername,
  getRequestedProfileTab,
  loadProfilePageData,
} from "../../lib/profile-data";
import { buildProfileHref } from "../../lib/profile-links";
import { resolveLocale } from "../../lib/i18n/locale";
import { getUiMessages } from "../../lib/i18n/catalog";
const localeContext = Astro.locals.localeContext ?? resolveLocale({});
const text = getUiMessages(localeContext.locale).account;

const env = runtimeEnv as CloudflareEnv & { R2_PUBLIC_BASE_URL?: string };
const supabase = createSSRClient(env);
const username = Astro.params.username?.trim() ?? "";
const tab = getRequestedProfileTab(Astro.url);

const profile = username ? await getProfileByUsername(supabase, username) : null;
if (profile?.username) {
  const canonicalUsernamePath = `/u/${encodeURIComponent(profile.username)}/`;
  const canonicalUsernameHref = `${canonicalUsernamePath}${Astro.url.search}`;
  if (Astro.url.pathname !== canonicalUsernamePath) {
    return Astro.redirect(canonicalUsernameHref);
  }
}

const pageData = profile ? await loadProfilePageData(supabase, profile, env.R2_PUBLIC_BASE_URL) : null;
const displayName = pageData?.profile.display_name || pageData?.profile.username || text.member;
const canonicalProfileHref = pageData ? buildProfileHref(pageData.profile) : null;
---

<CommunityLayout
  title={pageData ? displayName : text.notFound}
  activeSection="forum"
  canonical={canonicalProfileHref ?? undefined}
  noindex={!pageData}
>
  {!pageData ? (
    <section class="community-surface community-surface--padded profile-shell">
      <h1>{text.notFound}</h1>
      <p class="community-meta">{text.notFoundDetail}</p>
      <a href="/feed/" class="community-action-button community-action-button--muted">{text.backForum}</a>
    </section>
  ) : (
    <MyProfilePage localeContext={localeContext} client:load profileId={pageData.profile.id} initialPageData={pageData} initialTab={tab} />
  )}
</CommunityLayout>
