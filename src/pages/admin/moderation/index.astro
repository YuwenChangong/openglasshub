---
export const prerender = false;

import CommunityLayout from "../../../layouts/CommunityLayout.astro";
import AdminModerationQueue from "../../../components/admin/AdminModerationQueue";
import { getUiMessages } from "../../../lib/i18n/catalog";
const text = getUiMessages(Astro.locals.localeContext.locale).admin;
---

<CommunityLayout
  title={text.pages.moderation.title}
  description={text.pages.moderation.description}
  noindex={true}
  activeSection="forum"
>
  <section class="community-section" style="padding-top: 1rem;">
    <h1 class="community-page-title">/admin/moderation</h1>
    <p class="community-page-subtitle">{text.pages.moderation.lead}</p>
    <p class="community-page-subtitle"><a href="/admin/forum/" class="community-link">{text.copy.forumGovernance}</a> · <a href="/admin/reports/" class="community-link">{text.copy.reports}</a> · <a href="/admin/users/" class="community-link">{text.copy.userSafetyConsole}</a></p>
    <AdminModerationQueue localeContext={Astro.locals.localeContext} client:load />
  </section>
</CommunityLayout>
