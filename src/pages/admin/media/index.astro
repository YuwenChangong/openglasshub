---
export const prerender = false;

import CommunityLayout from "../../../layouts/CommunityLayout.astro";
import AdminMediaDashboard from "../../../components/admin/AdminMediaDashboard";
---

<CommunityLayout
  title="管理员媒体审计"
  description="OpenGlass Hub 管理员媒体审计页。"
  noindex={true}
  activeSection="forum"
>
  <section class="community-section" style="padding-top: 1rem;">
    <h1 class="community-page-title">/admin/media</h1>
    <p class="community-page-subtitle">筛选视频、大文件、未绑定媒体，并执行单条媒体删除。</p>
    <AdminMediaDashboard client:load />
  </section>
</CommunityLayout>
