---
export const prerender = false;

import CommunityLayout from "../../../layouts/CommunityLayout.astro";
import AdminForumDashboard from "../../../components/admin/AdminForumDashboard";
import { getUiMessages } from "../../../lib/i18n/catalog";
const text = getUiMessages(Astro.locals.localeContext.locale).admin;
---

<CommunityLayout
  title={text.pages.forum.title}
  description={text.pages.forum.description}
  noindex={true}
  activeSection="forum"
>
  <section class="community-section" style="padding-top: 1rem;">
    <h1 class="community-page-title">/admin/forum</h1>
    <p class="community-page-subtitle">{text.pages.forum.lead}</p>
    <p class="community-page-subtitle"><a href="/admin/moderation/" class="community-link">{text.copy.moderationQueue}</a> · <a href="/admin/reports/" class="community-link">{text.copy.reports}</a> · <a href="/admin/users/" class="community-link">{text.copy.userSafetyConsole}</a></p>
    <AdminForumDashboard localeContext={Astro.locals.localeContext} client:load />
  </section>
</CommunityLayout>
