---
export const prerender = false;

import CommunityLayout from "../../../layouts/CommunityLayout.astro";
import AdminNewsDashboard from "../../../components/admin/AdminNewsDashboard";
import { getUiMessages } from "../../../lib/i18n/catalog";
const text = getUiMessages(Astro.locals.localeContext.locale).admin;
---

<CommunityLayout
  title={text.pages.news.title}
  description={text.pages.news.description}
  noindex={true}
  activeSection="news"
>
  <section class="community-section" style="padding-top: 1rem;">
    <h1 class="community-page-title">/admin/news</h1>
    <p class="community-page-subtitle">{text.pages.news.lead}</p>
    <AdminNewsDashboard localeContext={Astro.locals.localeContext} client:load />
  </section>
</CommunityLayout>
