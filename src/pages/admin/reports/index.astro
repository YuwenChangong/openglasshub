---
export const prerender = false;

import CommunityLayout from "../../../layouts/CommunityLayout.astro";
import AdminReportsPanel from "../../../components/admin/AdminReportsPanel";
---

<CommunityLayout
  title="管理员举报列表"
  description="OpenGlass Hub 管理员举报队列。"
  noindex={true}
  activeSection="forum"
>
  <section class="community-section" style="padding-top: 1rem;">
    <h1 class="community-page-title">/admin/reports</h1>
    <p class="community-page-subtitle">查看 post / comment / circle / user 举报，并联动内容治理与用户安全动作。</p>
    <p class="community-page-subtitle"><a href="/admin/moderation/" class="community-link">前往审核队列</a> · <a href="/admin/forum/" class="community-link">查看论坛治理</a> · <a href="/admin/users/" class="community-link">查看用户安全</a></p>
    <AdminReportsPanel client:load />
  </section>
</CommunityLayout>
