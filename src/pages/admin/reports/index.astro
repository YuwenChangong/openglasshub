---
export const prerender = false;

import CommunityLayout from "../../../layouts/CommunityLayout.astro";
import AdminReportsPanel from "../../../components/admin/AdminReportsPanel";
import { getUiMessages } from "../../../lib/i18n/catalog";
const text = getUiMessages(Astro.locals.localeContext.locale).admin;
---

<CommunityLayout
  title={text.pages.reports.title}
  description={text.pages.reports.description}
  noindex={true}
  activeSection="forum"
>
  <section class="community-section" style="padding-top: 1rem;">
    <h1 class="community-page-title">/admin/reports</h1>
    <p class="community-page-subtitle">{text.pages.reports.lead}</p>
    <p class="community-page-subtitle"><a href="/admin/moderation/" class="community-link">{text.copy.moderationQueue}</a> · <a href="/admin/forum/" class="community-link">{text.copy.forumGovernance}</a> · <a href="/admin/users/" class="community-link">{text.copy.userSafetyConsole}</a></p>
    <AdminReportsPanel localeContext={Astro.locals.localeContext} client:load />
  </section>
</CommunityLayout>
