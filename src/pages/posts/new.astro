---
export const prerender = false;

import ForumLayout from "../../layouts/ForumLayout.astro";
import CreatePostForm from "../../components/forum/CreatePostForm";
import { getDeviceDiscussionContext } from "../../lib/device-discussion";
import { resolveLocale } from "../../lib/i18n/locale";
import { getUiMessages } from "../../lib/i18n/catalog";

const discussionContext = getDeviceDiscussionContext(Astro.url.searchParams.get("device"));
const localeContext = Astro.locals.localeContext ?? resolveLocale({});
const text = getUiMessages(localeContext.locale).community;
const nextPath = discussionContext ? discussionContext.startPostHref : "/posts/new/";
---

<ForumLayout
  title={text.newPostTitle}
  description={text.newPostDescription}
  canonical="/posts/new/"
  noindex={true}
  activeTab="new-post"
>
  <h1>{text.newPostTitle}</h1>
  {discussionContext ? (
    <section class="community-surface community-surface--padded post-prefill-note">
      <strong>{text.draftReady}</strong>
      <p>
        {text.draftFrom} <a href={discussionContext.productHref}>{discussionContext.device.name}</a> {text.productPage}
        {text.draftEditable}
      </p>
    </section>
  ) : null}
  <CreatePostForm
    localeContext={localeContext}
    client:only="react"
    initialTitle={discussionContext?.suggestedTitle}
    initialBody={discussionContext?.suggestedBody}
    nextPath={nextPath}
    discussionDeviceName={discussionContext?.device.name}
  />
</ForumLayout>

<style>
  .post-prefill-note {
    margin-bottom: 1rem;
  }
  .post-prefill-note strong {
    display: block;
    margin-bottom: 0.35rem;
  }
  .post-prefill-note p {
    margin: 0;
    color: var(--text-muted);
  }
</style>
