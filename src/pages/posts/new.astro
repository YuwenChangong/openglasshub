---
export const prerender = false;

import ForumLayout from "../../layouts/ForumLayout.astro";
import CreatePostForm from "../../components/forum/CreatePostForm";
---

<ForumLayout
  title="发布帖子"
  description="登录后在 OpenGlass Hub 社区发布新帖子。"
  canonical="https://openglasshub.pages.dev/posts/new/"
>
  <h1>发布帖子</h1>
  <p style="color: #8892b0; margin-top: -0.5rem;">
    发帖是受登录保护的互动能力。未登录用户会被引导到全站登录页，登录后返回这里继续。
  </p>
  <CreatePostForm client:only="react" />
</ForumLayout>
