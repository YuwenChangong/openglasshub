---
export const prerender = false;

import ForumLayout from "../../layouts/ForumLayout.astro";
import CreatePostForm from "../../components/forum/CreatePostForm";
import { getDeviceDiscussionContext } from "../../lib/device-discussion";

const discussionContext = getDeviceDiscussionContext(Astro.url.searchParams.get("device"));
const nextPath = discussionContext ? discussionContext.startPostHref : "/posts/new/";
---

<ForumLayout
  title="新建帖子"
  description="登录后在 OpenGlass Hub 社区创建新帖子。"
  canonical="https://openglasshub.pages.dev/posts/new/"
  noindex={true}
  activeTab="new-post"
>
  <h1>新建帖子</h1>
  {discussionContext ? (
    <section class="community-surface community-surface--padded post-prefill-note">
      <strong>已带入设备讨论草稿</strong>
      <p>
        当前草稿来自 <a href={discussionContext.productHref}>{discussionContext.device.name}</a> 产品页。
        你可以自由修改标题和正文，只有点击提交后才会真正发帖。
      </p>
    </section>
  ) : null}
  <CreatePostForm
    client:only="react"
    initialTitle={discussionContext?.suggestedTitle}
    initialBody={discussionContext?.suggestedBody}
    nextPath={nextPath}
    discussionDeviceName={discussionContext?.device.name}
  />
</ForumLayout>

<style>
  .post-prefill-note {
    margin-bottom: 1rem;
  }
  .post-prefill-note strong {
    display: block;
    margin-bottom: 0.35rem;
  }
  .post-prefill-note p {
    margin: 0;
    color: var(--text-muted);
  }
</style>
