---
export const prerender = false;

import ForumLayout from "../../layouts/ForumLayout.astro";
import { createSSRClient, type CloudflareEnv } from "../../lib/supabase-server";
import CommentForm from "../../components/forum/CommentForm";
import CommentsSection from "../../components/forum/CommentsSection";
import PostModerationActions from "../../components/forum/PostModerationActions";
import PostMediaGallery from "../../components/forum/PostMediaGallery";
import { buildLoginHref } from "../../lib/auth-redirect";
import { resolveSignedPostMedia, type PostMediaRow } from "../../lib/forum-media";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/feed/");
}

const env = Astro.locals.runtime.env as CloudflareEnv;
const supabase = createSSRClient(env);

const { data: post, error } = await supabase
  .from("posts")
  .select("id, author_id, title, body, type, status, created_at, updated_at, profiles:author_id(display_name), circles:circle_id(slug, name)")
  .eq("id", id)
  .eq("status", "published")
  .single();

const { data: mediaRows } = !error && post
  ? await supabase
      .from("post_media")
      .select("*")
      .eq("post_id", id)
      .order("sort_order", { ascending: true })
      .order("created_at", { ascending: true })
  : { data: [] as Array<{
      id: string;
      kind: "image" | "video" | "video_link";
      url: string | null;
      storage_path: string | null;
      thumbnail_url: string | null;
      alt_text: string | null;
      width: number | null;
      height: number | null;
      duration_seconds: number | null;
      size_bytes: number | null;
      mime_type: string | null;
      sort_order: number;
      is_cover: boolean | null;
    }> };

if (error || !post) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const postTypeLabels: Record<string, string> = {
  experience: "体验",
  question: "提问",
  review: "评测",
  dev: "开发",
  news: "资讯",
  feedback: "反馈",
};

const circle = post?.circles ?? null;
const canonicalUrl = post ? `https://openglasshub.pages.dev/posts/${post.id}/` : undefined;
const commentLoginHref = buildLoginHref(post ? `/posts/${post.id}/#comments` : "/feed/");
const postMedia = await resolveSignedPostMedia(supabase, (mediaRows ?? []) as PostMediaRow[]);
---

{!post ? (
  <ForumLayout title="帖子未找到" noindex={true}>
    <div class="forum-empty">
      <strong>帖子未找到</strong>
      <p>该帖子可能已被删除、尚未公开，或者当前链接无效。</p>
      <a href="/feed/" class="forum-btn">返回动态</a>
    </div>
  </ForumLayout>
) : (
  <ForumLayout
    title={post.title}
    description={post.body ? post.body.substring(0, 160).replace(/[#*\n]/g, ' ').trim() : undefined}
    canonical={canonicalUrl}
    activeTab="feed"
  >
    <nav class="breadcrumb">
      <a href="/">首页</a>
      <span>/</span>
      <a href="/feed/">论坛</a>
      <span>/</span>
      {circle && (
        <>
          <a href={`/circles/${circle.slug}/`}>{circle.name}</a>
          <span>/</span>
        </>
      )}
      <span style="color: var(--text);">{post.title}</span>
    </nav>

    <article class="post-detail">
      <header class="post-detail__header">
        <div class="post-detail__meta-row">
          {post.type && (
            <span class="forum-tag">{postTypeLabels[post.type] || post.type}</span>
          )}
          {circle && (
            <a href={`/circles/${circle.slug}/`} class="forum-tag forum-tag--muted post-detail__circle-link">
              {circle.name}
            </a>
          )}
        </div>
        <h1 class="post-detail__title">{post.title}</h1>
        <div class="forum-meta post-detail__meta">
          <span>{post.profiles?.display_name || "匿名"}</span>
          <span>{formatDate(post.created_at)}</span>
          {post.updated_at && post.updated_at !== post.created_at && (
            <span>更新于 {formatDate(post.updated_at)}</span>
          )}
        </div>
      </header>

      <section class="post-body-card">
        {post.body ? (
          <div class="post-body-card__content">{post.body}</div>
        ) : (
          <p class="post-body-card__empty">此帖子没有正文内容。</p>
        )}
      </section>

      {postMedia.length > 0 && <PostMediaGallery media={postMedia} postTitle={post.title} client:load />}

      <div class="post-detail__actions">
        <a href="/feed/" class="community-action-button">返回动态</a>
        <a href="/community/" class="community-action-button">加入社区讨论</a>
        <a href="/posts/new/" class="community-action-button community-action-button--primary">发帖</a>
      </div>
      <PostModerationActions postId={post.id} authorId={post.author_id} client:visible />
    </article>

    <section id="comments">
      <CommentForm postId={post.id} loginHref={commentLoginHref} client:visible />
      <CommentsSection postId={post.id} client:visible />
    </section>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": post.title,
      "description": post.body ? post.body.substring(0, 160).replace(/[#*\n]/g, ' ').trim() : "",
      "author": { "@type": "Person", "name": post.profiles?.display_name || "匿名" },
      "datePublished": post.created_at,
      "dateModified": post.updated_at || post.created_at,
      "url": canonicalUrl,
      "publisher": { "@type": "Organization", "name": "OpenGlass Hub" },
    })} />
  </ForumLayout>
)}

<style>
  .post-detail {
    max-width: 860px;
  }
  .post-detail__header {
    margin-bottom: 1.35rem;
  }
  .post-detail__meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.7rem;
    flex-wrap: wrap;
  }
  .post-detail__circle-link {
    text-decoration: none;
  }
  .post-detail__title {
    margin: 0 0 0.7rem;
    font-size: clamp(1.65rem, 3vw, 2rem);
    line-height: 1.24;
  }
  .post-detail__meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.84rem;
  }
  .post-body-card {
    padding: 0 0 0.2rem;
  }
  .post-body-card__content {
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.78;
    font-size: 1rem;
    color: var(--text);
  }
  .post-body-card__empty {
    color: var(--text-muted);
    font-style: italic;
  }
  .post-moderation-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .post-detail__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }
</style>
