---
export const prerender = false;

import ForumLayout from "../../layouts/ForumLayout.astro";
import { createSSRClient, type CloudflareEnv } from "../../lib/supabase-server";
import CommentForm from "../../components/forum/CommentForm";
import CommentsSection from "../../components/forum/CommentsSection";
import { buildLoginHref } from "../../lib/auth-redirect";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/feed/");
}

const env = Astro.locals.runtime.env as CloudflareEnv;
const supabase = createSSRClient(env);

const { data: post, error } = await supabase
  .from("posts")
  .select("id, title, body, type, status, created_at, updated_at, profiles:author_id(display_name), circles:circle_id(slug, name)")
  .eq("id", id)
  .eq("status", "published")
  .single();

const { data: mediaRows } = !error && post
  ? await supabase
      .from("post_media")
      .select("id, kind, url, storage_path, thumbnail_url, alt_text, sort_order")
      .eq("post_id", id)
      .order("sort_order", { ascending: true })
      .order("created_at", { ascending: true })
  : { data: [] as Array<{
      id: string;
      kind: "image" | "video_link";
      url: string | null;
      storage_path: string | null;
      thumbnail_url: string | null;
      alt_text: string | null;
      sort_order: number;
    }> };

if (error || !post) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const postTypeLabels: Record<string, string> = {
  experience: "体验",
  question: "提问",
  review: "评测",
  dev: "开发",
  news: "资讯",
  feedback: "反馈",
};

const circle = post?.circles ?? null;
const canonicalUrl = post ? `https://openglasshub.pages.dev/posts/${post.id}/` : undefined;
const commentLoginHref = buildLoginHref(post ? `/posts/${post.id}/#comments` : "/feed/");
const imagePaths = (mediaRows ?? [])
  .filter((item) => item.kind === "image" && item.storage_path)
  .map((item) => item.storage_path as string);
const { data: signedImages } = imagePaths.length
  ? await supabase.storage.from("post-media").createSignedUrls(imagePaths, 60 * 60)
  : { data: [] as Array<{ signedUrl?: string }> };
const imageUrlMap = new Map(
  imagePaths.map((path, index) => [path, signedImages?.[index]?.signedUrl ?? ""]),
);
const postMedia = (mediaRows ?? []).map((item) => ({
  ...item,
  displayUrl:
    item.kind === "image" && item.storage_path
      ? imageUrlMap.get(item.storage_path) ?? ""
      : item.url ?? "",
}));
---

{!post ? (
  <ForumLayout title="帖子未找到" noindex={true}>
    <div class="forum-empty">
      <strong>帖子未找到</strong>
      <p>该帖子可能已被删除、尚未公开，或者当前链接无效。</p>
      <a href="/feed/" class="forum-btn">返回动态</a>
    </div>
  </ForumLayout>
) : (
  <ForumLayout
    title={post.title}
    description={post.body ? post.body.substring(0, 160).replace(/[#*\n]/g, ' ').trim() : undefined}
    canonical={canonicalUrl}
    activeTab="feed"
  >
    <nav class="breadcrumb">
      <a href="/">首页</a>
      <span>/</span>
      <a href="/feed/">论坛</a>
      <span>/</span>
      {circle && (
        <>
          <a href={`/circles/${circle.slug}/`}>{circle.name}</a>
          <span>/</span>
        </>
      )}
      <span style="color: #e8edf8;">{post.title}</span>
    </nav>

    <article>
      <header style="margin-bottom: 2rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; flex-wrap: wrap;">
          {post.type && (
            <span class="forum-tag">{postTypeLabels[post.type] || post.type}</span>
          )}
          {circle && (
            <a href={`/circles/${circle.slug}/`} class="forum-tag forum-tag--muted" style="text-decoration: none;">
              {circle.name}
            </a>
          )}
        </div>
        <h1 style="margin: 0 0 0.75rem 0; font-size: 1.75rem; line-height: 1.3;">{post.title}</h1>
        <div class="forum-meta" style="display: flex; gap: 1.5rem; flex-wrap: wrap; font-size: 0.9rem;">
          <span>{post.profiles?.display_name || "匿名"}</span>
          <span>{formatDate(post.created_at)}</span>
          {post.updated_at && post.updated_at !== post.created_at && (
            <span>更新于 {formatDate(post.updated_at)}</span>
          )}
        </div>
      </header>

      <section class="forum-card" style="padding: 1.6rem; line-height: 1.8; font-size: 1rem;">
        {post.body ? (
          <div style="white-space: pre-wrap; word-break: break-word;">{post.body}</div>
        ) : (
          <p style="color: #7f91b2; font-style: italic;">此帖子没有正文内容。</p>
        )}
      </section>

      {postMedia.length > 0 && (
        <section class="post-media-block">
          {postMedia.some((item) => item.kind === "image") && (
            <div class="post-media-gallery">
              {postMedia
                .filter((item) => item.kind === "image" && item.displayUrl)
                .map((item) => (
                  <a href={item.displayUrl} target="_blank" rel="noreferrer" class="post-media-gallery__item">
                    <img src={item.displayUrl} alt={item.alt_text || post.title} loading="lazy" />
                  </a>
                ))}
            </div>
          )}

          {postMedia
            .filter((item) => item.kind === "video_link" && item.displayUrl)
            .map((item) => (
              <a href={item.displayUrl} target="_blank" rel="noreferrer" class="post-video-card">
                <span class="forum-tag">视频链接</span>
                <strong>{item.alt_text || "打开外部视频"}</strong>
                <span class="forum-meta">当前阶段不做站内原生视频上传，只提供外部视频入口。</span>
              </a>
            ))}
        </section>
      )}

      <div class="footer" style="margin-top: 1.25rem;">
        <a href="/feed/">返回动态</a>
        {" · "}
        <a href="/community/">加入社区讨论</a>
        {" · "}
        <a href="/posts/new/">发帖</a>
      </div>
    </article>

    <section id="comments">
      <CommentForm postId={post.id} loginHref={commentLoginHref} client:visible />
      <CommentsSection postId={post.id} client:visible />
    </section>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": post.title,
      "description": post.body ? post.body.substring(0, 160).replace(/[#*\n]/g, ' ').trim() : "",
      "author": { "@type": "Person", "name": post.profiles?.display_name || "匿名" },
      "datePublished": post.created_at,
      "dateModified": post.updated_at || post.created_at,
      "url": canonicalUrl,
      "publisher": { "@type": "Organization", "name": "OpenGlass Hub" },
    })} />
  </ForumLayout>
)}

<style>
  .post-media-block {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }
  .post-media-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.85rem;
  }
  .post-media-gallery__item {
    display: block;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.035);
  }
  .post-media-gallery__item img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .post-video-card {
    display: grid;
    gap: 0.45rem;
    padding: 1rem 1.05rem;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.045);
    color: var(--text);
    text-decoration: none;
    backdrop-filter: blur(14px) saturate(120%);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    box-shadow: var(--glass-shadow-soft);
  }
  .post-video-card strong {
    font-size: 1rem;
  }
</style>
