---
import CommunityLayout from "../../layouts/CommunityLayout.astro";
import BrandMark from "../../components/products/BrandMark.astro";
import { getBrandSummaries } from "../../lib/device-catalog";

const brands = getBrandSummaries();
---

<CommunityLayout
  title="产品"
  description="按品牌浏览 AR / AI 眼镜设备。"
  canonical="https://openglasshub.pages.dev/products/"
  activeSection="products"
>
  <section class="products-page-head">
    <h1>产品</h1>
    <p>按品牌浏览 AR / AI 眼镜设备。</p>
  </section>

  <section class="products-brand-grid">
    {brands.map((brand) => (
      <a href={`/products/${brand.key}/`} class="brand-tile">
        <div class="brand-tile__top">
          <BrandMark logo={brand.brandLogo} tone="accent" brandKey={brand.key} />
          <span>{brand.productCount} 款</span>
        </div>
        <h2>{brand.displayName}</h2>
        <div class="brand-tile__products">
          {brand.representativeNames.map((name) => (
            <span>{name}</span>
          ))}
        </div>
        <span class="brand-tile__cta">查看产品</span>
      </a>
    ))}
  </section>
</CommunityLayout>

<style>
  .products-page-head {
    display: grid;
    gap: 0.32rem;
    padding: 0.95rem 0 1.1rem;
  }
  .products-page-head h1 {
    margin: 0;
    color: var(--text);
    font-size: 2rem;
    letter-spacing: -0.03em;
  }
  .products-page-head p {
    margin: 0;
    max-width: 38rem;
    color: rgba(245, 245, 245, 0.68);
    line-height: 1.55;
  }
  .products-brand-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .brand-tile {
    display: grid;
    align-content: start;
    gap: 0.82rem;
    padding: 1.15rem;
    text-decoration: none;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: linear-gradient(180deg, rgba(13, 16, 20, 0.96), rgba(9, 11, 14, 0.98));
    transition: border-color 160ms ease, transform 160ms ease, background 160ms ease;
  }
  .brand-tile:hover {
    border-color: rgba(255, 255, 255, 0.1);
    background: linear-gradient(180deg, rgba(15, 18, 22, 0.98), rgba(10, 12, 15, 1));
    transform: translateY(-1px);
  }
  .brand-tile__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }
  .brand-tile__top :global(.brand-mark) {
    font-size: 1.52rem;
  }
  .brand-tile__top span,
  .brand-tile__cta {
    color: rgba(245, 245, 245, 0.72);
    font-size: 0.84rem;
    font-weight: 600;
  }
  .brand-tile h2 {
    margin: 0;
    color: var(--text);
    font-size: 1.28rem;
    letter-spacing: -0.02em;
  }
  .brand-tile__products {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .brand-tile__products span {
    display: inline-flex;
    align-items: center;
    min-height: 1.8rem;
    padding: 0.16rem 0.5rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    color: rgba(245, 245, 245, 0.62);
    font-size: 0.78rem;
  }
  .brand-tile__cta {
    color: #f5f5f5;
  }
  @media (max-width: 1100px) {
    .products-brand-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .products-brand-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
