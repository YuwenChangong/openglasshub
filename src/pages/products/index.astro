---
import CommunityLayout from "../../layouts/CommunityLayout.astro";
import { brandCatalog, getBrandCount } from "../../lib/device-catalog";
---

<CommunityLayout
  title="产品"
  description="按品牌查看 AR / AI 眼镜产品。"
  canonical="https://openglasshub.pages.dev/products/"
  activeSection="products"
>
  <section class="products-page-head">
    <h1>产品</h1>
  </section>

  <section class="products-brand-grid">
    {brandCatalog.map((brand) => (
      <a href={`/products/${brand.key}/`} class="community-surface brand-tile">
        <h2>{brand.label}</h2>
        <span>{getBrandCount(brand.key)} 款</span>
      </a>
    ))}
  </section>
</CommunityLayout>

<style>
  .products-page-head {
    padding: 0.85rem 0 1rem;
  }
  .products-page-head h1 {
    margin: 0;
    color: var(--text);
    font-size: 2rem;
    letter-spacing: -0.03em;
  }
  .products-brand-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.9rem;
  }
  .brand-tile {
    display: grid;
    gap: 0.5rem;
    padding: 1rem;
    text-decoration: none;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.025);
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
  }
  .brand-tile:hover {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.04);
    transform: translateY(-1px);
  }
  .brand-tile h2 {
    margin: 0;
    color: var(--text);
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .brand-tile span,
  .product-device-card__head span,
  .product-device-card__spec span {
    color: var(--text-faint);
    font-size: 0.8rem;
  }
</style>
