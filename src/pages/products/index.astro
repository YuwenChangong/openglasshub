---
import CommunityLayout from "../../layouts/CommunityLayout.astro";
import BrandMark from "../../components/products/BrandMark.astro";
import { getBrandSummaries } from "../../lib/device-catalog";

const brands = getBrandSummaries();
---

<CommunityLayout
  title="产品"
  description="按品牌查看 AR / AI 眼镜产品资料。"
  canonical="https://openglasshub.pages.dev/products/"
  activeSection="products"
>
  <section class="products-page-head">
    <h1>产品</h1>
    <p>按品牌进入，再看对应产品的参数、介绍和定位。</p>
  </section>

  <section class="products-brand-grid">
    {brands.map((brand) => (
      <a href={`/products/${brand.key}/`} class="brand-tile">
        <div class="brand-tile__top">
          <BrandMark text={brand.brandMarkText} tone="accent" />
          <span>{brand.productCount} 款</span>
        </div>
        <div class="brand-tile__copy">
          <h2>{brand.displayName}</h2>
          <p>{brand.shortIntro}</p>
        </div>
        <div class="brand-tile__meta">
          <strong>{brand.positioning}</strong>
          <div class="brand-tile__products">
            {brand.representativeNames.map((name) => (
              <span>{name}</span>
            ))}
          </div>
        </div>
        <span class="brand-tile__cta">查看产品</span>
      </a>
    ))}
  </section>
</CommunityLayout>

<style>
  .products-page-head {
    display: grid;
    gap: 0.38rem;
    padding: 0.95rem 0 1.2rem;
  }
  .products-page-head h1 {
    margin: 0;
    color: var(--text);
    font-size: 2rem;
    letter-spacing: -0.03em;
  }
  .products-page-head p {
    margin: 0;
    max-width: 42rem;
    color: rgba(245, 245, 245, 0.68);
    line-height: 1.6;
  }
  .products-brand-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1rem;
  }
  .brand-tile {
    display: grid;
    gap: 1rem;
    padding: 1.2rem;
    text-decoration: none;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, rgba(15, 18, 22, 0.98), rgba(9, 11, 14, 1));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease, box-shadow 160ms ease;
  }
  .brand-tile:hover {
    border-color: rgba(255, 255, 255, 0.14);
    background: linear-gradient(180deg, rgba(18, 22, 27, 0.99), rgba(10, 12, 15, 1));
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transform: translateY(-2px);
  }
  .brand-tile__top,
  .brand-tile__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }
  .brand-tile__top span,
  .brand-tile__cta {
    color: rgba(245, 245, 245, 0.72);
    font-size: 0.84rem;
    font-weight: 600;
  }
  .brand-tile__copy {
    display: grid;
    gap: 0.45rem;
  }
  .brand-tile__copy h2 {
    margin: 0;
    color: var(--text);
    font-size: 1.34rem;
    letter-spacing: -0.02em;
  }
  .brand-tile__copy p {
    margin: 0;
    color: rgba(245, 245, 245, 0.68);
    line-height: 1.62;
  }
  .brand-tile__meta {
    align-items: flex-start;
    flex-direction: column;
  }
  .brand-tile__meta strong {
    color: rgba(245, 245, 245, 0.82);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .brand-tile__products {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .brand-tile__products span {
    display: inline-flex;
    align-items: center;
    min-height: 1.8rem;
    padding: 0.2rem 0.58rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: rgba(245, 245, 245, 0.7);
    font-size: 0.78rem;
  }
  .brand-tile__cta {
    color: #f5f5f5;
  }
  @media (max-width: 720px) {
    .products-brand-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
