---
import CommunityLayout from "../../layouts/CommunityLayout.astro";
import { productLinks } from "../../lib/site-navigation";
import ProductCard from "../../components/community/ProductCard.astro";
---

<CommunityLayout
  title="产品"
  description="OpenGlass Hub 的产品内容入口，汇总设备库、选购指南和开发者资源。"
  canonical="https://openglasshub.pages.dev/products/"
  activeSection="products"
>
  <section class="community-page-head">
    <div>
      <h1>产品</h1>
      <p class="community-page-lead">看设备、做选购判断、查开发限制。这里是产品内容的直接入口，不是文档封面页。</p>
    </div>
  </section>

  <section class="products-page">
    <div class="community-surface community-surface--primary">
      <div class="community-section-head">
        <div>
          <h2>从这里开始</h2>
          <p>按你当前的问题进入对应入口，不用先读长说明。</p>
        </div>
      </div>

      <div class="products-grid">
        {productLinks.map((item) => (
          <ProductCard href={item.href} title={item.label} description={item.description} />
        ))}
      </div>

      <div class="products-secondary">
        <div class="products-secondary__text">
          <span class="community-meta">补充入口</span>
          <h3>对比与路线判断</h3>
          <p>后续会补更多横向对比和路线判断入口，但不会在这个阶段伪造榜单、评分或结论。</p>
        </div>
        <a href="/guides/" class="community-button--secondary">查看指南</a>
      </div>
    </div>
  </section>
</CommunityLayout>

<style>
  .products-page {
    display: block;
  }
  .products-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    padding: 0.9rem 1rem;
  }
  .products-secondary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem;
    margin: 0 1rem 1rem;
    padding: 0.9rem 0.95rem;
    border-top: 1px solid #22304a;
    background: transparent;
  }
  .products-secondary h3 {
    margin: 0.2rem 0 0.35rem;
    color: #f8fafc;
    font-size: 1.02rem;
  }
  .products-secondary p {
    margin: 0;
    color: #9aaccc;
  }
  @media (max-width: 900px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
    .products-secondary {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
