---
import CommunityLayout from "../../layouts/CommunityLayout.astro";
import BrandMark from "../../components/products/BrandMark.astro";
import { getBrandSummaries } from "../../lib/device-catalog";

const brands = getBrandSummaries().map((brand) => {
  const searchText = [
    brand.displayName,
    ...brand.representativeNames,
    ...brand.featuredProducts.flatMap((product) => product.bestFor ?? []),
  ]
    .join(" ")
    .toLowerCase();

  return {
    key: brand.key,
    displayName: brand.displayName,
    productCount: brand.productCount,
    representativeNames: brand.representativeNames,
    brandLogo: brand.brandLogo,
    href: `/products/${brand.key}/`,
    searchText,
  };
});
---

<CommunityLayout
  title="产品"
  description="按品牌查看 AR / AI 眼镜。"
  canonical="https://openglasshub.pages.dev/products/"
  activeSection="products"
  showHeaderSearch={false}
>
  <section class="products-page-head">
    <div>
      <h1>产品</h1>
      <p>按品牌查看 AR / AI 眼镜。</p>
    </div>
  </section>

  <section class="products-toolbar">
    <label class="products-toolbar__search" for="products-search">
      <span>搜索</span>
      <input
        id="products-search"
        class="glass-input"
        type="search"
        placeholder="搜索品牌、产品名或用途"
        autocomplete="off"
      />
    </label>
    <p class="products-toolbar__meta" id="products-result-count">{brands.length} 个品牌</p>
  </section>

  <section class="products-brand-grid" id="products-brand-grid">
    {brands.map((brand) => (
      <a
        href={brand.href}
        class="brand-module"
        data-brand-module
        data-search={brand.searchText}
      >
        <div class="brand-module__top">
          <BrandMark logo={brand.brandLogo} tone="accent" brandKey={brand.key} />
          <span class="brand-module__count">{brand.productCount} 款</span>
        </div>

        <div class="brand-module__products" aria-label={`${brand.displayName} 产品预览`}>
          {brand.representativeNames.map((name) => (
            <span class="brand-module__pill">{name}</span>
          ))}
        </div>

        <span class="brand-module__cta">查看产品</span>
      </a>
    ))}
  </section>

  <p class="products-empty-state" id="products-empty-state" hidden>
    没有找到匹配品牌。
  </p>

  <script
    id="products-brand-data"
    type="application/json"
    set:html={JSON.stringify({ brands })}
  />

  <script type="module">
    const searchInput = document.getElementById("products-search");
    const resultCount = document.getElementById("products-result-count");
    const modules = Array.from(document.querySelectorAll("[data-brand-module]"));
    const brandsDataElement = document.getElementById("products-brand-data");
    const brandsPayload = brandsDataElement?.textContent ? JSON.parse(brandsDataElement.textContent) : { brands: [] };
    const totalBrands = Array.isArray(brandsPayload.brands) ? brandsPayload.brands.length : modules.length;
    const emptyState = document.getElementById("products-empty-state");

    function normalize(value) {
      return String(value || "")
        .trim()
        .toLowerCase();
    }

    function updateListing() {
      const query = normalize(searchInput?.value);
      let visibleCount = 0;

      modules.forEach((module) => {
        const haystack = module.getAttribute("data-search") || "";
        const matches = !query || haystack.includes(query);
        module.hidden = !matches;
        if (matches) visibleCount += 1;
      });

      if (resultCount) {
        resultCount.textContent = query ? `${visibleCount} 个匹配品牌` : `${totalBrands} 个品牌`;
      }

      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }
    }

    searchInput?.addEventListener("input", updateListing);
    updateListing();
  </script>
</CommunityLayout>

<style>
  .products-page-head {
    padding: 0.95rem 0 0.65rem;
  }

  .products-page-head h1 {
    margin: 0;
    color: #f8f8fa;
    font-size: 2.15rem;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .products-page-head p {
    margin: 0.34rem 0 0;
    color: rgba(245, 245, 247, 0.7);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .products-toolbar {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .products-toolbar__search {
    display: grid;
    gap: 0.42rem;
    flex: 1 1 auto;
    min-width: 0;
  }

  .products-toolbar__search span,
  .products-toolbar__meta {
    margin: 0;
    color: rgba(245, 245, 247, 0.56);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .products-toolbar :global(.glass-input) {
    min-height: 44px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    transition: border-color 160ms ease, background 160ms ease, box-shadow 160ms ease;
  }

  .products-toolbar :global(.glass-input:hover) {
    border-color: rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.045);
  }

  .products-toolbar :global(.glass-input:focus-visible),
  .brand-module:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08);
  }

  .products-brand-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 0.95rem;
  }

  .products-empty-state {
    margin: 0.9rem 0 0;
    padding: 0.95rem 1rem;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.025);
    color: rgba(245, 245, 247, 0.62);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .brand-module {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.95rem;
    min-height: 224px;
    padding: 1.05rem;
    text-decoration: none;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: linear-gradient(180deg, rgba(16, 18, 22, 0.92), rgba(10, 12, 15, 0.98));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
  }

  .brand-module:hover {
    border-color: rgba(255, 255, 255, 0.12);
    background: linear-gradient(180deg, rgba(18, 21, 25, 0.94), rgba(11, 13, 17, 1));
    transform: translateY(-1px);
  }

  .brand-module__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .brand-module__top :global(.brand-mark) {
    min-width: 0;
    font-size: 1.35rem;
  }

  .brand-module__count,
  .brand-module__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 1.95rem;
    max-width: 100%;
    padding: 0 0.72rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(248, 248, 250, 0.84);
    font-size: 0.79rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .brand-module__count {
    flex: 0 0 auto;
    min-width: 3.45rem;
  }

  .brand-module__products {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 0.5rem;
  }

  .brand-module__pill {
    justify-content: flex-start;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .brand-module__cta {
    color: #f8f8fa;
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.3;
  }

  @media (prefers-reduced-motion: reduce) {
    .products-toolbar :global(.glass-input),
    .brand-module {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .products-toolbar {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (max-width: 720px) {
    .products-page-head h1 {
      font-size: 1.95rem;
    }

    .brand-module {
      min-height: 208px;
    }
  }

  @media (max-width: 420px) {
    .brand-module {
      padding: 0.92rem;
      border-radius: 16px;
    }

    .brand-module__top :global(.brand-mark) {
      max-width: calc(100% - 4.6rem);
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
