---
export const prerender = true;

import CommunityLayout from "../../layouts/CommunityLayout.astro";
import BrandMark from "../../components/products/BrandMark.astro";
import ProductVisual from "../../components/products/ProductVisual.astro";
import { brandCatalog, getBrandByKey, getDevicesByBrand } from "../../lib/device-catalog";

export function getStaticPaths() {
  return brandCatalog.map((brand) => ({
    params: { brand: brand.key },
  }));
}

const brandKey = Astro.params.brand?.trim().toLowerCase() ?? "";
const brand = getBrandByKey(brandKey);

if (!brand) {
  return Astro.redirect("/products/");
}

const devices = getDevicesByBrand(brand.key);
---

<CommunityLayout
  title={`${brand.displayName} | 产品`}
  description={`查看 ${brand.displayName} 的产品参数与介绍。`}
  canonical={`https://openglasshub.pages.dev/products/${brand.key}/`}
  activeSection="products"
>
  <section class="products-brand-strip">
    {brandCatalog.map((item) => (
      <a
        href={`/products/${item.key}/`}
        class:list={["community-inline-link", "products-brand-strip__link", { "community-inline-link--active": item.key === brand.key }]}
      >
        {item.displayName}
      </a>
    ))}
  </section>

  <section class="products-brand-head">
    <div class="products-brand-head__copy">
      <BrandMark text={brand.brandMarkText} tone="accent" />
      <div>
        <h1>{brand.displayName}</h1>
        <p>{brand.shortIntro}</p>
      </div>
    </div>
    <div class="products-brand-head__meta">
      <span>{devices.length} 款产品</span>
      <a href={brand.websiteUrl} target="_blank" rel="noreferrer" class="community-link">官网</a>
      <a href="/products/" class="community-link">全部品牌</a>
    </div>
  </section>

  <section class="products-device-grid">
    {devices.map((device) => (
      <a href={`/devices/${device.slug}/`} class="product-device-card">
        <ProductVisual imageUrl={device.productImageUrl ?? device.officialImageUrl} alt={device.imageAlt} brandMark={brand.brandMarkText} title={device.name} />

        <div class="product-device-card__head">
          <h2>{device.title}</h2>
          <span>{device.routeLabel}</span>
        </div>

        <p class="product-device-card__summary">{device.shortDescription}</p>

        {device.previewSpecs.length > 0 && (
          <div class="product-device-card__specs">
            {device.previewSpecs.map((spec) => (
              <article class="product-device-card__spec">
                <span>{spec.label}</span>
                <strong>{spec.value}</strong>
              </article>
            ))}
          </div>
        )}

        <div class="product-device-card__foot">
          <div class="product-device-card__fit">
            {device.bestFor.slice(0, 2).map((item) => (
              <span>{item}</span>
            ))}
          </div>
          <div class="product-device-card__state">
            <strong>{device.completenessLabel}</strong>
            {device.lastCheckedLabel && <span>{device.lastCheckedLabel}</span>}
          </div>
        </div>
      </a>
    ))}
  </section>
</CommunityLayout>

<style>
  .products-brand-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0.85rem 0 1rem;
  }
  .products-brand-strip__link {
    min-height: 36px;
  }
  .products-brand-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.2rem;
    margin-bottom: 1rem;
  }
  .products-brand-head__copy {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
  }
  .products-brand-head__copy > div {
    display: grid;
    gap: 0.35rem;
  }
  .products-brand-head h1 {
    margin: 0;
    color: var(--text);
    font-size: 2rem;
    letter-spacing: -0.03em;
  }
  .products-brand-head p {
    margin: 0;
    max-width: 42rem;
    color: rgba(245, 245, 245, 0.68);
    line-height: 1.6;
  }
  .products-brand-head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.7rem;
  }
  .products-brand-head__meta span {
    color: rgba(245, 245, 245, 0.62);
    font-size: 0.86rem;
  }
  .products-device-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }
  .product-device-card {
    display: grid;
    gap: 0.85rem;
    padding: 1rem;
    text-decoration: none;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, rgba(15, 18, 22, 0.98), rgba(9, 11, 14, 1));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease, box-shadow 160ms ease;
  }
  .product-device-card:hover {
    border-color: rgba(255, 255, 255, 0.14);
    background: linear-gradient(180deg, rgba(18, 22, 27, 0.99), rgba(10, 12, 15, 1));
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transform: translateY(-2px);
  }
  .product-device-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .product-device-card__head h2 {
    margin: 0;
    color: var(--text);
    font-size: 1.08rem;
    line-height: 1.38;
    letter-spacing: -0.02em;
  }
  .product-device-card__summary {
    margin: 0;
    color: rgba(245, 245, 245, 0.68);
    line-height: 1.6;
  }
  .product-device-card__head span,
  .product-device-card__spec span {
    color: var(--text-faint);
    font-size: 0.8rem;
  }
  .product-device-card__specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
  }
  .product-device-card__spec {
    display: grid;
    gap: 0.18rem;
    padding: 0.7rem 0.75rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
  }
  .product-device-card__spec strong {
    color: var(--text);
    font-size: 0.92rem;
    line-height: 1.35;
  }
  .product-device-card__foot,
  .product-device-card__state {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .product-device-card__fit {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .product-device-card__fit span {
    display: inline-flex;
    align-items: center;
    min-height: 1.7rem;
    padding: 0.14rem 0.48rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: rgba(245, 245, 245, 0.68);
    font-size: 0.76rem;
  }
  .product-device-card__state {
    justify-content: space-between;
  }
  .product-device-card__state strong,
  .product-device-card__state span {
    color: rgba(245, 245, 245, 0.66);
    font-size: 0.8rem;
  }
  @media (max-width: 720px) {
    .products-brand-head,
    .product-device-card__head {
      align-items: flex-start;
      flex-direction: column;
    }
    .products-brand-head__copy {
      flex-direction: column;
    }
    .products-brand-head h1 {
      font-size: 1.65rem;
    }
    .product-device-card__foot,
    .product-device-card__state {
      align-items: flex-start;
      flex-direction: column;
    }
    .product-device-card__specs {
      grid-template-columns: 1fr;
    }
  }
</style>
