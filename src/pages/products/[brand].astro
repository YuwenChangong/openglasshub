---
export const prerender = true;

import CommunityLayout from "../../layouts/CommunityLayout.astro";
import BrandMark from "../../components/products/BrandMark.astro";
import ProductVisual from "../../components/products/ProductVisual.astro";
import { brandCatalog, getBrandByKey, getDevicesByBrand } from "../../lib/device-catalog";

export function getStaticPaths() {
  return brandCatalog.map((brand) => ({
    params: { brand: brand.key },
  }));
}

const brandKey = Astro.params.brand?.trim().toLowerCase() ?? "";
const brand = getBrandByKey(brandKey);

if (!brand) {
  return Astro.redirect("/products/");
}

const devices = getDevicesByBrand(brand.key);
---

<CommunityLayout
  title={`${brand.displayName} | 产品`}
  description={`查看 ${brand.displayName} 的产品参数与介绍。`}
  canonical={`https://openglasshub.pages.dev/products/${brand.key}/`}
  activeSection="products"
>
  <section class="products-brand-head">
    <div class="products-brand-head__copy">
      <BrandMark text={brand.brandMarkText} tone="accent" brandKey={brand.key} />
      <div>
        {brand.displayName !== brand.brandMarkText ? <h1>{brand.displayName}</h1> : <h1 class="products-brand-head__sr-only">{brand.displayName}</h1>}
        <p>{brand.shortIntro}</p>
      </div>
    </div>
    <div class="products-brand-head__meta">
      <a href={brand.websiteUrl} target="_blank" rel="noopener noreferrer" class="community-link">官网</a>
    </div>
  </section>

  <section class="products-device-grid">
    {devices.map((device) => (
      <a href={`/devices/${device.slug}/`} class="product-device-card">
        <ProductVisual imageUrl={device.productImageUrl ?? device.officialImageUrl} alt={device.imageAlt} brandMark={brand.brandMarkText} title={device.name} />

        <div class="product-device-card__head">
          <h2>{device.title}</h2>
          <span>{device.routeLabel}</span>
        </div>

        {device.previewSpecs.length > 0 && (
          <div class="product-device-card__specs">
            {device.previewSpecs.slice(0, 4).map((spec) => (
              <article class="product-device-card__spec">
                <span>{spec.label}</span>
                <strong>{spec.value}</strong>
              </article>
            ))}
          </div>
        )}

        <div class="product-device-card__foot">
          <div class="product-device-card__state">
            <strong>{device.completenessLabel}</strong>
            <span>查看详情</span>
          </div>
        </div>
      </a>
    ))}
  </section>
</CommunityLayout>

<style>
  .products-brand-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.95rem 0 1rem;
  }
  .products-brand-head__copy {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
  }
  .products-brand-head__copy :global(.brand-mark) {
    font-size: 1.5rem;
  }
  .products-brand-head__copy > div {
    display: grid;
    gap: 0.35rem;
  }
  .products-brand-head h1 {
    margin: 0;
    color: var(--text);
    font-size: 2rem;
    letter-spacing: -0.03em;
  }
  .products-brand-head__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .products-brand-head p {
    margin: 0;
    max-width: 30rem;
    color: rgba(245, 245, 245, 0.68);
    line-height: 1.55;
  }
  .products-brand-head__meta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  .products-device-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 0.95rem;
  }
  .product-device-card {
    display: grid;
    gap: 0.7rem;
    padding: 0.85rem;
    text-decoration: none;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: linear-gradient(180deg, rgba(13, 16, 20, 0.96), rgba(9, 11, 14, 0.98));
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
  }
  .product-device-card:hover {
    border-color: rgba(255, 255, 255, 0.1);
    background: linear-gradient(180deg, rgba(15, 18, 22, 0.98), rgba(10, 12, 15, 1));
    transform: translateY(-1px);
  }
  .product-device-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .product-device-card__head h2 {
    margin: 0;
    color: var(--text);
    font-size: 1.08rem;
    line-height: 1.38;
    letter-spacing: -0.02em;
  }
  .product-device-card__head span,
  .product-device-card__spec span {
    color: var(--text-faint);
    font-size: 0.8rem;
  }
  .product-device-card__specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem;
  }
  .product-device-card__spec {
    display: grid;
    gap: 0.18rem;
    padding: 0.55rem 0.62rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.022);
    border: 1px solid rgba(255, 255, 255, 0.045);
  }
  .product-device-card__spec strong {
    color: var(--text);
    font-size: 0.92rem;
    line-height: 1.35;
  }
  .product-device-card__foot,
  .product-device-card__state {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.55rem;
  }
  .product-device-card__state {
    justify-content: space-between;
  }
  .product-device-card__state strong,
  .product-device-card__state span {
    color: rgba(245, 245, 245, 0.66);
    font-size: 0.8rem;
  }
  @media (max-width: 720px) {
    .products-brand-head,
    .product-device-card__head {
      align-items: flex-start;
      flex-direction: column;
    }
    .products-brand-head__copy {
      flex-direction: column;
    }
    .products-brand-head h1 {
      font-size: 1.65rem;
    }
    .product-device-card__foot,
    .product-device-card__state {
      align-items: flex-start;
      flex-direction: column;
    }
    .product-device-card__specs {
      grid-template-columns: 1fr;
    }
  }
</style>
