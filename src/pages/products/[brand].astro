---
export const prerender = true;

import CommunityLayout from "../../layouts/CommunityLayout.astro";
import BrandMark from "../../components/products/BrandMark.astro";
import ProductVisual from "../../components/products/ProductVisual.astro";
import { brandCatalog, getBrandByKey, getDevicesByBrand } from "../../lib/device-catalog";

function getSpecValue(
  product: NonNullable<ReturnType<typeof getDevicesByBrand>[number]>,
  field: string,
) {
  for (const group of product.specGroups ?? []) {
    const match = group.items.find((item) => item.field === field);
    if (match?.value) return match.value;
  }
  return null;
}

function buildCardFacts(product: NonNullable<ReturnType<typeof getDevicesByBrand>[number]>) {
  const candidates = [
    { label: "显示", value: getSpecValue(product, "display_type") ?? getSpecValue(product, "resolution") },
    { label: "刷新", value: getSpecValue(product, "refresh_rate") },
    { label: "亮度", value: getSpecValue(product, "brightness") },
    { label: "FOV", value: getSpecValue(product, "field_of_view") },
    { label: "重量", value: getSpecValue(product, "weight") },
    { label: "平台", value: getSpecValue(product, "chipset") ?? getSpecValue(product, "platform") },
  ];

  return candidates.filter((item) => item.value).slice(0, 3);
}

export function getStaticPaths() {
  return brandCatalog.map((brand) => ({
    params: { brand: brand.key },
  }));
}

const brandKey = Astro.params.brand?.trim().toLowerCase() ?? "";
const brand = getBrandByKey(brandKey);

if (!brand) {
  return Astro.redirect("/products/");
}

const devices = getDevicesByBrand(brand.key).map((product) => ({
  slug: product.slug,
  name: product.name,
  brandLabel: product.brandLabel,
  brandMarkText: product.brandMarkText,
  typeLabel: product.typeLabel,
  availability: product.availability ?? product.infoStatusLabel ?? product.statusLabel ?? null,
  cardFacts: buildCardFacts(product),
  detailHref: `/devices/${product.slug}/`,
  placeholderType: product.cardMedia.placeholderType,
}));
---

<CommunityLayout
  title={`${brand.displayName} | 产品`}
  description={`查看 ${brand.displayName} 当前收录的产品。`}
  canonical={`https://openglasshub.pages.dev/products/${brand.key}/`}
  activeSection="products"
>
  <section class="products-brand-head">
    <div class="products-brand-head__identity">
      <BrandMark logo={brand.brandLogo} tone="accent" brandKey={brand.key} />
      <span class="products-brand-head__count">{devices.length} 款</span>
    </div>

    <div class="products-brand-head__meta">
      <div class="products-brand-head__links">
        <a href="/products/" class="community-link">全部产品</a>
        <a href={brand.websiteUrl} target="_blank" rel="noopener noreferrer" class="community-link">官网</a>
      </div>
    </div>
  </section>

  <section class="products-device-grid">
    {devices.map((device) => (
      <article class="product-device-card">
        <ProductVisual
          brandMark={device.brandMarkText}
          title={device.name}
          categoryLabel={device.typeLabel}
          highlights={[]}
          placeholderType={device.placeholderType}
        />

        <div class="product-device-card__body">
          <div class="product-device-card__head">
            <div>
              <h2>{device.name}</h2>
              <p>{device.brandLabel}</p>
            </div>
          </div>

          <div class="product-device-card__chips">
            <span class="product-chip">{device.typeLabel}</span>
            {device.availability ? <span class="product-chip product-chip--muted">{device.availability}</span> : null}
          </div>

          <dl class="product-device-card__facts">
            {device.cardFacts.map((fact) => (
              <div class="product-device-card__fact">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>

          <div class="product-device-card__footer">
            <a href={device.detailHref} class="product-device-card__detail-link">完整资料</a>
          </div>
        </div>
      </article>
    ))}
  </section>
</CommunityLayout>

<style>
  .products-brand-head,
  .product-device-card {
    --products-panel-bg: linear-gradient(180deg, rgba(14, 17, 22, 0.94), rgba(9, 11, 15, 0.98));
    --products-panel-border: rgba(255, 255, 255, 0.07);
    --products-panel-highlight: rgba(255, 255, 255, 0.04);
    --products-chip-bg: rgba(255, 255, 255, 0.04);
    --products-chip-border: rgba(255, 255, 255, 0.08);
    --products-chip-text: rgba(248, 248, 250, 0.84);
    --products-muted-text: rgba(245, 245, 245, 0.58);
    --products-focus-ring: 0 0 0 3px rgba(255, 255, 255, 0.08);
  }

  .products-brand-head,
  .product-device-card {
    border-radius: 18px;
    border: 1px solid var(--products-panel-border);
    background: var(--products-panel-bg);
    box-shadow: inset 0 1px 0 var(--products-panel-highlight);
  }

  .products-brand-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin: 1rem 0 1.2rem;
    padding: 1.1rem 1.15rem;
  }

  .products-brand-head__identity,
  .products-brand-head__links,
  .product-device-card__head,
  .product-device-card__footer {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .products-brand-head__identity {
    min-width: 0;
    flex-wrap: wrap;
    row-gap: 0.55rem;
  }

  .products-brand-head__identity :global(.brand-mark) {
    min-width: 0;
    font-size: 1.38rem;
  }

  .products-brand-head__count,
  .product-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 1.95rem;
    max-width: 100%;
    padding: 0 0.76rem;
    border-radius: 999px;
    border: 1px solid var(--products-chip-border);
    background: var(--products-chip-bg);
    color: var(--products-chip-text);
    font-size: 0.79rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .product-chip--muted {
    color: rgba(245, 245, 245, 0.7);
  }

  .products-brand-head__meta {
    display: flex;
    align-items: center;
    justify-items: end;
  }

  .product-device-card__head p,
  .product-device-card__fact dt {
    margin: 0;
    color: var(--products-muted-text);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .products-brand-head__links {
    flex-wrap: wrap;
  }

  .products-device-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 264px), 1fr));
    gap: 1rem;
  }

  .product-device-card {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0.9rem;
    padding: 0.9rem;
  }

  .product-device-card :global(.product-visual) {
    min-height: 240px;
    height: 240px;
  }

  .product-device-card__body {
    display: grid;
    align-content: start;
    gap: 0.8rem;
  }

  .product-device-card__head {
    align-items: start;
    justify-content: space-between;
  }

  .product-device-card__head h2 {
    margin: 0;
    color: #f8f8fa;
    font-size: 1.12rem;
    letter-spacing: -0.03em;
    line-height: 1.18;
    text-wrap: balance;
  }

  .product-device-card__head p {
    margin-top: 0.18rem;
  }

  .product-device-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .product-device-card__facts {
    display: grid;
    gap: 0.42rem;
    margin: 0;
  }

  .product-device-card__fact {
    display: grid;
    grid-template-columns: minmax(0, 72px) minmax(0, 1fr);
    gap: 0.7rem;
    padding-top: 0.46rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .product-device-card__fact dd {
    margin: 0;
    color: rgba(248, 248, 250, 0.9);
    font-size: 0.88rem;
    line-height: 1.35;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .product-device-card__detail-link {
    color: rgba(248, 248, 250, 0.8);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .product-device-card__detail-link:hover,
  .product-device-card__detail-link:focus-visible {
    color: #ffffff;
  }

  .product-device-card__footer {
    margin-top: auto;
    padding-top: 0.2rem;
  }

  .products-brand-head :global(.community-link:focus-visible),
  .product-device-card__detail-link:focus-visible {
    outline: none;
    box-shadow: var(--products-focus-ring);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-device-card__detail-link {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .products-brand-head {
      align-items: start;
      flex-direction: column;
    }

    .products-brand-head__meta {
      justify-items: start;
    }
  }

  @media (max-width: 720px) {
    .products-device-grid {
      grid-template-columns: 1fr;
    }

    .product-device-card :global(.product-visual) {
      min-height: 214px;
      height: 214px;
    }
  }

  @media (max-width: 420px) {
    .products-brand-head,
    .product-device-card {
      padding: 0.84rem;
      border-radius: 16px;
    }

    .products-brand-head__identity {
      width: 100%;
    }

    .products-brand-head__identity :global(.brand-mark) {
      max-width: calc(100% - 4.5rem);
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
