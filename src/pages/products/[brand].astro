---
export const prerender = true;

import CommunityLayout from "../../layouts/CommunityLayout.astro";
import BrandMark from "../../components/products/BrandMark.astro";
import ProductVisual from "../../components/products/ProductVisual.astro";
import { brandCatalog, getAllDevices, getBrandByKey, getDevicesByBrand } from "../../lib/device-catalog";

const compareFieldOrder = [
  ["name", "产品"],
  ["category", "类别"],
  ["display_type", "显示"],
  ["resolution", "分辨率"],
  ["refresh_rate", "刷新率"],
  ["brightness", "亮度"],
  ["field_of_view", "FOV"],
  ["weight", "重量"],
  ["chipset", "平台 / 芯片"],
  ["camera", "相机"],
  ["battery_life", "续航"],
] as const;

type DeviceRecord = NonNullable<ReturnType<typeof getAllDevices>[number]>;

function getSpecValue(product: DeviceRecord, field: string) {
  for (const group of product.specGroups ?? []) {
    const match = group.items.find((item) => item.field === field);
    if (match?.value) return match.value;
  }
  return null;
}

function buildCardFacts(product: DeviceRecord) {
  const candidates = [
    { label: "显示", value: getSpecValue(product, "display_type") ?? getSpecValue(product, "resolution") },
    { label: "重量", value: getSpecValue(product, "weight") },
    { label: "平台", value: getSpecValue(product, "chipset") ?? getSpecValue(product, "platform") },
  ];

  return candidates.filter((item) => item.value).slice(0, 3);
}

function stripLeadingBrandName(name: string, brandLabel: string) {
  const normalizedName = name.trim();
  const normalizedBrand = brandLabel.trim();
  if (!normalizedBrand) return normalizedName;

  const escapedBrand = normalizedBrand.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  return normalizedName.replace(new RegExp(`^${escapedBrand}[\\s-]*`, "i"), "").trim() || normalizedName;
}

function stripLeadingBrandSlug(slug: string, brandKey: string) {
  return slug.replace(new RegExp(`^${brandKey.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}-?`, "i"), "").trim() || slug;
}

function stripBrandTerms(value: string | null | undefined, brandLabel: string, brandKey: string) {
  const variants = [brandLabel, brandKey, brandKey.replaceAll("-", " ")]
    .map((item) => item?.trim())
    .filter((item): item is string => Boolean(item));

  let result = String(value || "");
  for (const variant of new Set(variants)) {
    result = result.replace(new RegExp(variant.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "ig"), " ");
  }

  return result.replace(/\s+/g, " ").trim();
}

function serializeCompareProduct(product: DeviceRecord) {
  const bareName = stripLeadingBrandName(product.name, product.brandLabel);
  const bareSlug = stripLeadingBrandSlug(product.slug, product.brandKey).replaceAll("-", " ");
  const modelSearchText = [bareName, bareSlug]
    .join(" ")
    .toLowerCase();
  const detailSearchText = [
    bareName,
    product.typeLabel,
    product.availability ?? product.infoStatusLabel ?? product.statusLabel ?? "",
    stripBrandTerms(product.positioning ?? "", product.brandLabel, product.brandKey),
    ...(product.bestFor ?? []).map((item) => stripBrandTerms(item, product.brandLabel, product.brandKey)),
    ...buildCardFacts(product).flatMap((fact) => [fact.label, fact.value]),
  ]
    .join(" ")
    .toLowerCase();

  const compareValues = Object.fromEntries(
    compareFieldOrder.map(([field]) => {
      switch (field) {
        case "name":
          return [field, product.name];
        case "category":
          return [field, product.typeLabel];
        default:
          return [field, getSpecValue(product, field) ?? "TBD"];
      }
    }),
  );

  return {
    slug: product.slug,
    name: product.name,
    brandKey: product.brandKey,
    brandLabel: product.brandLabel,
    brandMarkText: product.brandMarkText,
    typeLabel: product.typeLabel,
    availability: product.availability ?? product.infoStatusLabel ?? product.statusLabel ?? null,
    cardFacts: buildCardFacts(product),
    placeholderType: product.cardMedia.placeholderType,
    detailHref: `/products/${product.brandKey}/#product-${product.slug}`,
    officialHref: product.officialProductUrl ?? product.buyUrl ?? product.brandWebsiteUrl ?? "/products/",
    modelSearchText,
    detailSearchText,
    searchText: [
      product.name,
      bareName,
      product.slug,
      product.brandKey,
      product.brandLabel,
      product.typeLabel,
      product.positioning ?? "",
      ...(product.bestFor ?? []),
    ]
      .join(" ")
      .toLowerCase(),
    compareValues,
  };
}

export function getStaticPaths() {
  return brandCatalog.map((brand) => ({
    params: { brand: brand.key },
  }));
}

const brandKey = Astro.params.brand?.trim().toLowerCase() ?? "";
const brand = getBrandByKey(brandKey);

if (!brand) {
  return Astro.redirect("/products/");
}

const brandProducts = getDevicesByBrand(brand.key).map((product) => serializeCompareProduct(product));
const compareProducts = getAllDevices().map((product) => serializeCompareProduct(product));
---

<CommunityLayout
  title={`${brand.displayName} | 产品`}
  description={`查看 ${brand.displayName} 当前收录的产品。`}
  canonical={`https://openglasshub.pages.dev/products/${brand.key}/`}
  activeSection="products"
  showHeaderSearch={false}
>
  <section class="brand-page-head">
    <div class="brand-page-head__identity">
      <BrandMark logo={brand.brandLogo} tone="accent" brandKey={brand.key} />
      <div class="brand-page-head__copy">
        <h1>{brand.displayName}</h1>
        <span class="brand-page-head__count">{brandProducts.length} 款</span>
      </div>
    </div>

    <div class="brand-page-head__actions">
      <a href="/products/" class="community-link">全部品牌</a>
      <a href={brand.websiteUrl} target="_blank" rel="noopener noreferrer" class="community-link">官网</a>
    </div>
  </section>

  <section class="brand-toolbar">
    <label class="brand-toolbar__search" for="brand-products-search">
      <span>搜索</span>
      <div class="brand-toolbar__search-field">
        <input
          id="brand-products-search"
          class="glass-input"
          type="search"
          placeholder={`搜索 ${brand.displayName} 产品，或加入其他品牌对比`}
          autocomplete="off"
          aria-describedby="brand-products-count"
          aria-expanded="false"
          aria-controls="brand-search-dropdown"
        />

        <div class="brand-search-dropdown" id="brand-search-dropdown" hidden>
          <div class="brand-search-dropdown__list" id="brand-search-results-list"></div>
          <p class="brand-search-dropdown__empty" id="brand-search-empty" hidden>
            没有找到可加入对比的产品。
          </p>
        </div>
      </div>
    </label>
    <p class="brand-toolbar__meta" id="brand-products-count">{brandProducts.length} 款产品</p>
  </section>

  <section class="brand-compare" id="brand-compare" hidden>
    <div class="brand-compare__head">
      <div>
        <h2>对比</h2>
        <p id="brand-compare-summary">选择产品进行对比，最多 3 款。</p>
      </div>
      <button type="button" class="brand-compare__clear" id="brand-compare-clear">
        清空
      </button>
    </div>

    <div class="brand-compare__selected" id="brand-compare-selected"></div>
    <p class="brand-compare__feedback" id="brand-compare-feedback" aria-live="polite"></p>

    <div class="brand-compare__table-wrap" id="brand-compare-table-wrap" hidden>
      <table class="brand-compare__table">
        <thead id="brand-compare-table-head"></thead>
        <tbody id="brand-compare-table-body"></tbody>
      </table>
    </div>
  </section>

  <section class="brand-product-grid" id="brand-product-grid">
    {brandProducts.map((product) => (
      <article
        class="brand-product-card"
        id={`product-${product.slug}`}
        data-product-card
        data-product-slug={product.slug}
        data-search={`${product.modelSearchText} ${product.detailSearchText}`.trim()}
      >
        <ProductVisual
          brandMark={product.brandMarkText}
          title={product.name}
          categoryLabel={product.typeLabel}
          placeholderType={product.placeholderType}
        />

        <div class="brand-product-card__body">
          <div class="brand-product-card__head">
            <div>
              <h2>{product.name}</h2>
              <p>{product.brandLabel}</p>
            </div>
          </div>

          <div class="brand-product-card__chips">
            <span class="product-chip">{product.typeLabel}</span>
            {product.availability ? <span class="product-chip product-chip--muted">{product.availability}</span> : null}
          </div>

          <dl class="brand-product-card__facts">
            {product.cardFacts.map((fact) => (
              <div class="brand-product-card__fact">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>

          <div class="brand-product-card__footer">
            <div class="brand-product-card__links">
              <a href={product.detailHref} class="brand-product-card__link">查看产品</a>
              <a href={product.officialHref} target="_blank" rel="noopener noreferrer" class="brand-product-card__link">官网</a>
            </div>
            <button
              type="button"
              class="brand-product-card__compare-button"
              data-compare-button
              data-product-slug={product.slug}
              aria-label={`添加 ${product.name} 到对比`}
              title="添加到对比"
            >
              <span aria-hidden="true">+</span>
            </button>
          </div>
        </div>
      </article>
    ))}
  </section>

  <p class="brand-products-empty-state" id="brand-products-empty-state" hidden>
    没有找到匹配结果。
  </p>

  <script
    id="brand-products-data"
    type="application/json"
    set:html={JSON.stringify({
      brandKey: brand.key,
      compareFields: compareFieldOrder.map(([key, label]) => ({ key, label })),
      brandProducts: brandProducts.map((product) => ({
        slug: product.slug,
        searchText: product.searchText,
        modelSearchText: product.modelSearchText,
        detailSearchText: product.detailSearchText,
      })),
      compareProducts: compareProducts.map((product) => ({
        slug: product.slug,
        name: product.name,
        brandKey: product.brandKey,
        brandLabel: product.brandLabel,
        typeLabel: product.typeLabel,
        searchText: product.searchText,
        detailHref: product.detailHref,
        compareValues: product.compareValues,
      })),
    })}
  />

  <script type="module">
    const dataElement = document.getElementById("brand-products-data");
    const parsed = dataElement?.textContent
      ? JSON.parse(dataElement.textContent)
      : { brandKey: "", brandProducts: [], compareProducts: [], compareFields: [] };
    const currentBrandKey = typeof parsed.brandKey === "string" ? parsed.brandKey : "";
    const brandProducts = Array.isArray(parsed.brandProducts) ? parsed.brandProducts : [];
    const compareProducts = Array.isArray(parsed.compareProducts) ? parsed.compareProducts : [];
    const compareFields = Array.isArray(parsed.compareFields) ? parsed.compareFields : [];
    const productMap = new Map(compareProducts.map((product) => [product.slug, product]));
    const brandProductMap = new Map(brandProducts.map((product) => [product.slug, product]));
    const selected = [];
    const maxCompareCount = 3;

    const searchInput = document.getElementById("brand-products-search");
    const searchField = document.querySelector(".brand-toolbar__search-field");
    const countLabel = document.getElementById("brand-products-count");
    const cards = Array.from(document.querySelectorAll("[data-product-card]"));
    const searchDropdown = document.getElementById("brand-search-dropdown");
    const searchResultsList = document.getElementById("brand-search-results-list");
    const searchEmpty = document.getElementById("brand-search-empty");
    const compareSurface = document.getElementById("brand-compare");
    const compareSelected = document.getElementById("brand-compare-selected");
    const compareFeedback = document.getElementById("brand-compare-feedback");
    const compareClear = document.getElementById("brand-compare-clear");
    const compareSummary = document.getElementById("brand-compare-summary");
    const compareTableWrap = document.getElementById("brand-compare-table-wrap");
    const compareTableHead = document.getElementById("brand-compare-table-head");
    const compareTableBody = document.getElementById("brand-compare-table-body");
    const emptyState = document.getElementById("brand-products-empty-state");
    let searchDropdownOpen = false;

    function normalize(value) {
      return String(value || "")
        .trim()
        .toLowerCase();
    }

    function shouldMatchBrandCard(product, query) {
      if (!query) return true;
      if (!product) return false;

      const normalizedQuery = normalize(query);
      if (!normalizedQuery) return true;
      const modelSearchText = normalize(product.modelSearchText);
      const detailSearchText = normalize(product.detailSearchText);
      if (normalizedQuery.length <= 1) {
        return modelSearchText
          .split(/\s+/)
          .some((token) => token.length > 1 && token.startsWith(normalizedQuery));
      }

      return modelSearchText.includes(normalizedQuery) || detailSearchText.includes(normalizedQuery);
    }

    function isSelected(slug) {
      return selected.includes(slug);
    }

    function setFeedback(message = "") {
      if (compareFeedback) compareFeedback.textContent = message;
    }

    function renderCompareButtons() {
      const compareButtons = Array.from(document.querySelectorAll("[data-compare-button]"));
      compareButtons.forEach((button) => {
        const slug = button.getAttribute("data-product-slug");
        const active = slug ? isSelected(slug) : false;
        const product = slug ? productMap.get(slug) : null;
        const inDropdown = Boolean(button.closest(".brand-search-result"));
        button.classList.toggle("is-selected", active);

        if (inDropdown) {
          button.disabled = active;
          button.setAttribute("aria-label", active ? `已添加 ${product?.name || "产品"}` : `添加 ${product?.name || "产品"} 到对比`);
          button.setAttribute("aria-disabled", active ? "true" : "false");
          button.setAttribute("title", active ? "已加入对比" : "添加到对比");
          button.closest(".brand-search-result")?.classList.toggle("is-selected", active);
          button.innerHTML = active
            ? '<span class="brand-search-result__compare-state" aria-hidden="true">✓</span>'
            : '<span aria-hidden="true">+</span>';
          return;
        }

        button.removeAttribute("aria-disabled");
        button.disabled = false;
        button.setAttribute("aria-label", active ? `移除 ${product?.name || "产品"}` : `添加 ${product?.name || "产品"} 到对比`);
        button.setAttribute("title", active ? "已加入对比" : "添加到对比");
        button.innerHTML = `<span aria-hidden="true">${active ? "−" : "+"}</span>`;
      });
    }

    function renderCompareSelected() {
      if (!compareSelected) return;
      compareSelected.innerHTML = "";

      selected.forEach((slug) => {
        const product = productMap.get(slug);
        if (!product) return;

        const pill = document.createElement("div");
        pill.className = "brand-compare__pill";
        pill.dataset.productSlug = slug;

        const label = document.createElement("span");
        label.className = "brand-compare__pill-label";
        label.textContent = product.name;

        const removeButton = document.createElement("button");
        removeButton.type = "button";
        removeButton.className = "brand-compare__pill-remove";
        removeButton.setAttribute("aria-label", `移除 ${product.name}`);
        removeButton.innerHTML = '<span aria-hidden="true">×</span>';
        removeButton.addEventListener("click", () => removeFromCompare(slug));

        pill.append(label, removeButton);
        compareSelected.appendChild(pill);
      });
    }

    function renderCompareTable() {
      if (!compareTableWrap || !compareTableHead || !compareTableBody) return;
      if (selected.length < 2) {
        compareTableWrap.hidden = true;
        compareTableHead.innerHTML = "";
        compareTableBody.innerHTML = "";
        return;
      }

      compareTableWrap.hidden = false;
      const selectedProducts = selected.map((slug) => productMap.get(slug)).filter(Boolean);
      const visibleFields = compareFields.filter((field) =>
        selectedProducts.some((product) => {
          const value = product.compareValues?.[field.key];
          return value && value !== "TBD";
        }),
      );

      const headerCells = selectedProducts
        .map(
          (product) =>
            `<th scope="col"><div class="brand-compare__column-heading"><strong>${product.name}</strong><span>${product.brandLabel}</span></div></th>`,
        )
        .join("");

      compareTableHead.innerHTML = `<tr><th scope="col">项目</th>${headerCells}</tr>`;
      compareTableBody.innerHTML = visibleFields
        .map((field) => {
          const cells = selectedProducts
            .map((product) => `<td>${product.compareValues?.[field.key] || "TBD"}</td>`)
            .join("");
          return `<tr><th scope="row">${field.label}</th>${cells}</tr>`;
        })
        .join("");
    }

    function renderCompareSurface() {
      if (compareSurface) compareSurface.hidden = false;
      if (compareClear) {
        compareClear.disabled = selected.length === 0;
        compareClear.hidden = selected.length === 0;
      }

      if (compareSummary) {
        compareSummary.textContent =
          selected.length === 0
            ? "选择产品进行对比，最多 3 款。"
            : selected.length === 1
              ? "已选 1 款，再添加 1 款开始对比。"
              : `已选 ${selected.length} 款，向右查看完整对比。`;
      }

      renderCompareButtons();
      renderCompareSelected();
      renderCompareTable();
    }

    function setSearchDropdownOpen(open) {
      if (!searchDropdown || !searchInput) return;
      const shouldOpen = Boolean(open && normalize(searchInput.value));
      searchDropdownOpen = shouldOpen;
      searchDropdown.hidden = !shouldOpen;
      searchInput.setAttribute("aria-expanded", shouldOpen ? "true" : "false");
      if (!shouldOpen && searchEmpty) {
        searchEmpty.hidden = true;
      }
    }

    function renderSearchResults(query, matches) {
      if (!searchDropdown || !searchResultsList || !searchEmpty || !searchInput) return;

      if (!query) {
        searchResultsList.innerHTML = "";
        setSearchDropdownOpen(false);
        return;
      }

      searchResultsList.innerHTML = "";
      setSearchDropdownOpen(true);

      if (matches.length === 0) {
        searchEmpty.hidden = false;
        return;
      }

      searchEmpty.hidden = true;

      matches.forEach((product) => {
        const item = document.createElement("article");
        item.className = "brand-search-result";
        item.setAttribute("role", "option");

        const copy = document.createElement("div");
        copy.className = "brand-search-result__copy";

        const title = document.createElement("a");
        title.className = "brand-search-result__title";
        title.href = product.detailHref;
        title.textContent = product.name;

        const meta = document.createElement("div");
        meta.className = "brand-search-result__meta";

        const brandPill = document.createElement("span");
        brandPill.className = "product-chip";
        brandPill.textContent = product.brandLabel;

        const typePill = document.createElement("span");
        typePill.className = "product-chip product-chip--muted";
        typePill.textContent = product.typeLabel;

        const button = document.createElement("button");
        button.type = "button";
        button.className = "brand-search-result__compare-button";
        button.dataset.compareButton = "";
        button.dataset.productSlug = product.slug;
        button.setAttribute("aria-label", `加入对比 ${product.name}`);
        button.addEventListener("click", () => addToCompare(product.slug));

        meta.append(brandPill, typePill);
        copy.append(title, meta);
        item.append(copy, button);
        searchResultsList.appendChild(item);
      });

      renderCompareButtons();
    }

    function getCrossBrandMatches(query) {
      return query
        ? compareProducts
            .filter((product) => product.brandKey !== currentBrandKey && product.searchText.includes(query))
            .slice(0, 6)
        : [];
    }

    function refreshSearchResultsFromInput() {
      const query = normalize(searchInput?.value);
      renderSearchResults(query, getCrossBrandMatches(query));
    }

    function addToCompare(slug) {
      if (!productMap.has(slug)) return;
      if (isSelected(slug)) {
        removeFromCompare(slug);
        return;
      }
      if (selected.length >= maxCompareCount) {
        setFeedback("最多同时比较 3 款产品。");
        renderCompareSurface();
        return;
      }

      selected.push(slug);
      setFeedback("");
      renderCompareSurface();
      refreshSearchResultsFromInput();
    }

    function removeFromCompare(slug) {
      const index = selected.indexOf(slug);
      if (index === -1) return;
      selected.splice(index, 1);
      setFeedback("");
      renderCompareSurface();
    }

    function clearCompare() {
      selected.splice(0, selected.length);
      setFeedback("");
      renderCompareSurface();
    }

    function updateListing() {
      const query = normalize(searchInput?.value);
      let visibleCount = 0;
      const crossBrandMatches = getCrossBrandMatches(query);

      cards.forEach((card) => {
        const product = brandProductMap.get(card.getAttribute("data-product-slug"));
        const matches = shouldMatchBrandCard(product, query);
        card.hidden = !matches;
        if (matches) visibleCount += 1;
      });

      renderSearchResults(query, crossBrandMatches);

      if (countLabel) {
        countLabel.textContent = query ? `当前品牌 ${visibleCount} 款匹配` : `${brandProducts.length} 款产品`;
      }

      if (emptyState) {
        emptyState.hidden = visibleCount > 0 || crossBrandMatches.length > 0;
      }
    }

    searchInput?.addEventListener("input", updateListing);
    searchInput?.addEventListener("focus", () => {
      if (normalize(searchInput.value)) {
        refreshSearchResultsFromInput();
      }
    });
    searchInput?.addEventListener("click", () => {
      if (!searchDropdownOpen && normalize(searchInput.value)) {
        refreshSearchResultsFromInput();
      }
    });
    searchInput?.addEventListener("blur", () => {
      window.setTimeout(() => {
        const activeElement = document.activeElement;
        if (searchField && activeElement instanceof Node && searchField.contains(activeElement)) {
          return;
        }
        setSearchDropdownOpen(false);
      }, 120);
    });
    document.addEventListener("pointerdown", (event) => {
      if (!(event.target instanceof Node) || !searchField?.contains(event.target)) {
        setSearchDropdownOpen(false);
      }
    });
    compareClear?.addEventListener("click", clearCompare);

    Array.from(document.querySelectorAll("[data-compare-button]")).forEach((button) => {
      button.addEventListener("click", () => {
        const slug = button.getAttribute("data-product-slug");
        if (!slug) return;
        addToCompare(slug);
      });
    });

    updateListing();
    renderCompareSurface();
  </script>
</CommunityLayout>

<style>
  .brand-page-head,
  .brand-toolbar,
  .brand-compare,
  .brand-product-card {
    --products-panel-bg: linear-gradient(180deg, rgba(16, 18, 22, 0.92), rgba(10, 12, 15, 0.98));
    --products-panel-border: rgba(255, 255, 255, 0.07);
    --products-panel-highlight: rgba(255, 255, 255, 0.04);
    --products-chip-bg: rgba(255, 255, 255, 0.04);
    --products-chip-border: rgba(255, 255, 255, 0.08);
    --products-chip-text: rgba(248, 248, 250, 0.84);
    --products-muted-text: rgba(245, 245, 245, 0.56);
    --products-focus-ring: 0 0 0 3px rgba(255, 255, 255, 0.08);
  }

  .brand-page-head,
  .brand-toolbar,
  .brand-compare,
  .brand-product-card {
    border-radius: 18px;
    border: 1px solid var(--products-panel-border);
    background: var(--products-panel-bg);
    box-shadow: inset 0 1px 0 var(--products-panel-highlight);
  }

  .brand-page-head,
  .brand-toolbar,
  .brand-compare {
    padding: 1rem 1.05rem;
  }

  .brand-page-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.95rem 0 1rem;
  }

  .brand-page-head__identity,
  .brand-page-head__actions,
  .brand-compare__head,
  .brand-product-card__footer {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .brand-page-head__identity {
    min-width: 0;
    align-items: center;
  }

  .brand-page-head__identity :global(.brand-mark) {
    min-width: 0;
    font-size: 1.34rem;
  }

  .brand-page-head__copy {
    display: grid;
    gap: 0.28rem;
    min-width: 0;
  }

  .brand-page-head__copy h1 {
    margin: 0;
    color: #f8f8fa;
    font-size: 1.16rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .brand-page-head__count,
  .product-chip,
