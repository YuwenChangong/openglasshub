---
import { getUiMessages, formatUiMessage } from "../../lib/i18n/catalog";
const localeContext = Astro.locals.localeContext;
const text = getUiMessages(localeContext.locale).catalog;
export const prerender = false;

import { env as runtimeEnv } from "cloudflare:workers";
import CommunityLayout from "../../layouts/CommunityLayout.astro";
import { createSSRClient, type CloudflareEnv } from "../../lib/supabase-server";
import {
  getPublicNewsArticleBySlug,
  incrementPublishedNewsViewCount,
  listRelatedPublicNews,
  NEWS_CATEGORY_LABELS,
} from "../../lib/news";
import {
  filterDuplicateCoverImageBlocks,
  parseNewsContent,
  resolveNewsContentBlocks,
} from "../../lib/news-content";

const env = runtimeEnv as CloudflareEnv;
const supabase = createSSRClient(env);
const slug = String(Astro.params.slug ?? "").trim();
const article = slug ? await getPublicNewsArticleBySlug(supabase, slug) : null;

if (article) {
  await incrementPublishedNewsViewCount(supabase, article.slug);
}

if (!article) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

const relatedArticles = article
  ? await listRelatedPublicNews(supabase, {
      category: article.category,
      excludeSlug: article.slug,
      limit: 4,
    })
  : [];

const contentBlocks = article
  ? filterDuplicateCoverImageBlocks(
      await resolveNewsContentBlocks(supabase, parseNewsContent(article.content)),
      article.cover_image_url,
    )
  : [];
const publishedDate = article
  ? new Date(article.published_at ?? article.created_at).toLocaleDateString(localeContext.locale, {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";
const discussionHref = article ? `/search/?q=${encodeURIComponent(article.title)}` : "/search/";
---

{!article ? (
  <CommunityLayout title={text.newsMissing} noindex={true} activeSection="news">
    <section class="news-empty">
      <strong>{text.articleMissing}</strong>
      <p>{text.articleMissingHint}</p>
      <a href="/news/" class="community-button--secondary">{text.backNewsList}</a>
    </section>
  </CommunityLayout>
) : (
  <CommunityLayout
    title={article.title}
    description={article.summary}
    canonical={`/news/${article.slug}/`}
    ogType="article"
    activeSection="news"
  >
    <article class="news-article-layout">
      <div class="news-article-main">
        <header class="news-article-page__head">
          <div class="news-article-page__meta">
            <span class="community-meta">{text.newsCategory[article.category]}</span>
            <span class="community-meta">{publishedDate}</span>
            {article.source_name ? <span class="community-meta">{article.source_name}</span> : null}
          </div>
          <h1>{article.title}</h1>
          {article.summary ? <p class="news-article-page__summary">{article.summary}</p> : null}
        </header>

        <div class="news-article-page__body">
          {contentBlocks.map((block) => {
            if (block.type === "heading") {
              const Tag = `h${block.level}` as keyof astroHTML.JSX.IntrinsicElements;
              return (
                <Tag class={`news-article-page__heading news-article-page__heading--h${block.level}`}>
                  {block.segments.map((segment) =>
                    segment.type === "link" ? (
                      <a href={segment.href} target={segment.href.startsWith("/") ? undefined : "_blank"} rel={segment.href.startsWith("/") ? undefined : "noopener noreferrer"} class="community-inline-link">
                        {segment.text}
                      </a>
                    ) : (
                      segment.text
                    ),
                  )}
                </Tag>
              );
            }

            if (block.type === "list") {
              return (
                <ul class="news-article-page__list">
                  {block.items.map((item) => (
                    <li>
                      {item.map((segment) =>
                        segment.type === "link" ? (
                          <a href={segment.href} target={segment.href.startsWith("/") ? undefined : "_blank"} rel={segment.href.startsWith("/") ? undefined : "noopener noreferrer"} class="community-inline-link">
                            {segment.text}
                          </a>
                        ) : (
                          segment.text
                        ),
                      )}
                    </li>
                  ))}
                </ul>
              );
            }

            if (block.type === "image") {
              return (
                <figure class="news-article-page__image">
                  <img src={block.src} alt={block.alt} loading="lazy" decoding="async" />
                  {block.alt ? <figcaption>{block.alt}</figcaption> : null}
                </figure>
              );
            }

            return (
              <p>
                {block.segments.map((segment) =>
                  segment.type === "link" ? (
                    <a href={segment.href} target={segment.href.startsWith("/") ? undefined : "_blank"} rel={segment.href.startsWith("/") ? undefined : "noopener noreferrer"} class="community-inline-link">
                      {segment.text}
                    </a>
                  ) : (
                    segment.text
                  ),
                )}
              </p>
            );
          })}
        </div>

        <footer class="news-article-page__footer">
          <div class="community-inline-meta">
            <span>{formatUiMessage(text.publishedAt, { date: publishedDate })}</span>
            {article.source_url ? (
              <a href={article.source_url} target="_blank" rel="noopener noreferrer" class="community-inline-link">
                {text.viewSource}
              </a>
            ) : null}
          </div>
          <div class="community-cta-row">
            <a href="/news/" class="community-button--secondary">{text.backNews}</a>
            <a href={discussionHref} class="community-button">{text.joinDiscussion}</a>
          </div>
        </footer>
      </div>

      <aside class="news-article-sidebar">
        <section class="community-surface news-side-panel">
          <div class="community-section-head">
            <h2>{text.relatedArticles}</h2>
          </div>
          <div class="news-side-list">
            {relatedArticles.map((item) => (
              <a href={`/news/${item.slug}/`} class="news-side-list__item news-side-list__item--compact">
                <span class="news-side-list__copy">
                  <strong>{item.title}</strong>
                  <small>{text.newsCategory[item.category]}</small>
                </span>
              </a>
            ))}
          </div>
        </section>

        <section class="community-surface news-side-panel">
          <div class="community-section-head">
            <h2>{text.continueReading}</h2>
          </div>
          <div class="news-side-list">
            <a href={discussionHref} class="news-side-list__item news-side-list__item--compact">
              <span class="news-side-list__copy">
                <strong>{text.joinDiscussion}</strong>
                <small>{text.discussionHint}</small>
              </span>
            </a>
            <a href="/feed/?sort=hot" class="news-side-list__item news-side-list__item--compact">
              <span class="news-side-list__copy">
                <strong>{text.viewHotDiscussion}</strong>
                <small>{text.backHotFeed}</small>
              </span>
            </a>
          </div>
        </section>
      </aside>
    </article>
  </CommunityLayout>
)}
