---
import CommunityLayout from "../../layouts/CommunityLayout.astro";
import { curatedNews, getNewsEntry } from "../../lib/news";

export function getStaticPaths() {
  return curatedNews.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const item = Astro.props.item ?? getNewsEntry(Astro.params.slug ?? "");

if (!item) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

const publishedDate = item
  ? new Date(item.publishedAt).toLocaleDateString("zh-CN", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";
---

{!item ? (
  <CommunityLayout title="热点未找到" noindex={true} activeSection="news">
    <section class="news-empty">
      <strong>热点内容未找到</strong>
      <p>该条目可能不存在，或当前还没有发布到公开热点页。</p>
      <a href="/news/" class="community-button--secondary">返回热点列表</a>
    </section>
  </CommunityLayout>
) : (
  <CommunityLayout
    title={item.title}
    description={item.summary}
    canonical={`https://openglasshub.pages.dev/news/${item.slug}/`}
    activeSection="news"
  >
    <article class="news-article-page">
      <header class="news-article-page__head">
        <div class="news-article-page__meta">
          <span class="community-tag">{item.category}</span>
          <span class="community-meta">{publishedDate}</span>
          <span class="community-meta">{item.sourceLabel ?? "管理员精选"}</span>
        </div>
        <h1>{item.title}</h1>
        <p class="news-article-page__summary">{item.summary}</p>
      </header>

      {item.mediaType !== "none" && (
        <section class="news-cover">
          {item.mediaType === "image" && item.coverImageUrl ? (
            <img src={item.coverImageUrl} alt={item.coverAlt ?? item.title} loading="eager" />
          ) : item.mediaType === "video" && item.mediaUrl ? (
            <a
              href={item.mediaUrl}
              target="_blank"
              rel="noreferrer"
              class="news-video-card"
            >
              <span class="community-tag community-tag--muted">视频</span>
              <strong>查看相关视频</strong>
              <span class="community-meta">当前阶段只提供外部视频链接，不在站内伪装播放器。</span>
            </a>
          ) : null}
        </section>
      )}

      <div class="news-article-page__body">
        {item.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <footer class="news-article-page__footer">
        <div class="community-inline-meta">
          <span>{item.sourceLabel ?? "管理员精选"}</span>
          <span>发布时间：{publishedDate}</span>
          {item.sourceUrl && (
            <a href={item.sourceUrl} target="_blank" rel="noreferrer" class="community-inline-link">
              查看来源
            </a>
          )}
        </div>
        <div class="community-cta-row">
          <a href="/news/" class="community-button--secondary">返回热点</a>
          <a href="/feed/" class="community-button">进入社区讨论</a>
        </div>
      </footer>
    </article>
  </CommunityLayout>
)}

<style>
  .news-article-page {
    width: min(100%, 760px);
    margin: 0 auto;
    padding: 0.35rem 0 1rem;
  }
  .news-article-page__head {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.2rem;
  }
  .news-article-page__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }
  .news-article-page__head h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.12;
    letter-spacing: -0.04em;
  }
  .news-article-page__summary {
    margin: 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.75;
  }
  .news-cover {
    margin-bottom: 1.4rem;
  }
  .news-cover img {
    display: block;
    width: 100%;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.03);
  }
  .news-video-card {
    display: grid;
    gap: 0.45rem;
    padding: 1rem 1.05rem;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: var(--surface);
    text-decoration: none;
    color: var(--text);
    backdrop-filter: blur(14px) saturate(120%);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    box-shadow: var(--glass-shadow-soft);
  }
  .news-video-card strong {
    font-size: 1rem;
  }
  .news-article-page__body {
    display: grid;
    gap: 1rem;
  }
  .news-article-page__body p {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.75;
  }
  .news-article-page__footer {
    display: grid;
    gap: 1rem;
    padding-top: 1.2rem;
    margin-top: 1.4rem;
    border-top: 1px solid var(--border);
  }
  .news-empty {
    display: grid;
    gap: 0.8rem;
    width: min(100%, 760px);
    padding: 1rem 0 1.2rem;
  }
</style>
