---
import { getUiMessages, formatUiMessage } from "../../lib/i18n/catalog";
const localeContext = Astro.locals.localeContext;
const text = getUiMessages(localeContext.locale).catalog;
export const prerender = false;

import { env as runtimeEnv } from "cloudflare:workers";
import CommunityLayout from "../../layouts/CommunityLayout.astro";
import { createSSRClient, type CloudflareEnv } from "../../lib/supabase-server";
import {
  listPublicNewsFeed,
  NEWS_FILTERS,
  NEWS_CATEGORY_LABELS,
  parseNewsFilter,
} from "../../lib/news";
import { resolveNewsMediaUrls } from "../../lib/news-media";
import NewsPagination from "../../components/news/NewsPagination";

const env = runtimeEnv as CloudflareEnv;
const supabase = createSSRClient(env);
const filter = parseNewsFilter(Astro.url.searchParams.get("category"));
const pageParam = Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
const page = Number.isFinite(pageParam) ? Math.max(1, pageParam) : 1;

const newsFeed = await listPublicNewsFeed(supabase, { filter, page, limit: 5 });
const coverUrlMap = await resolveNewsMediaUrls(
  supabase,
  newsFeed.articles.map((article) => article.cover_image_url).concat(newsFeed.featuredArticle?.cover_image_url ?? null),
);

const featuredArticle = page === 1 ? newsFeed.featuredArticle : null;
const articles = newsFeed.articles;
const buildCategoryHref = (nextFilter: string) =>
  nextFilter === "recommended" ? "/news/" : `/news/?category=${encodeURIComponent(nextFilter)}`;
---

<CommunityLayout
  title={text.news}
  description={text.newsLead}
  canonical="/news/"
  activeSection="news"
>
  <section class="community-page-head news-page-head">
    <div>
      <h1>{text.news}</h1>
      <p class="community-page-lead">{text.newsLead}</p>
    </div>
  </section>

  <section class="news-filter-bar" aria-label={text.newsCategories}>
    {NEWS_FILTERS.map((item) => (
      <a
        href={buildCategoryHref(item.key)}
        class:list={["news-filter-pill", { "is-active": filter === item.key }]}
      >
        {text.newsCategory[item.key]}
      </a>
    ))}
  </section>

  <section class="news-feed-layout">
    <div class="news-feed-main">
      {featuredArticle ? (
        <a href={`/news/${featuredArticle.slug}/`} class="news-featured-card">
          <div class="news-featured-card__copy">
            <div class="community-inline-meta">
              <span class="community-meta">{text.newsCategory[featuredArticle.category]}</span>
              {featuredArticle.pinned ? <span class="news-state-pill">{text.pinned}</span> : null}
              {featuredArticle.featured ? <span class="news-state-pill news-state-pill--featured">{text.featured}</span> : null}
              <span class="community-meta">
                {new Date(featuredArticle.published_at ?? featuredArticle.created_at).toLocaleDateString(localeContext.locale)}
              </span>
            </div>
            <h2>{featuredArticle.title}</h2>
            {featuredArticle.summary ? <p>{featuredArticle.summary}</p> : null}
          </div>
          {featuredArticle.cover_image_url && coverUrlMap.get(featuredArticle.cover_image_url) ? (
            <div class="news-featured-card__media">
              <img
                src={coverUrlMap.get(featuredArticle.cover_image_url)!}
                alt={featuredArticle.title}
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </div>
          ) : null}
        </a>
      ) : null}

      <div class="news-feed-list">
        {articles.map((article) => (
          <a href={`/news/${article.slug}/`} class="news-feed-card">
            <div class="news-feed-card__copy">
              <div class="community-inline-meta">
                <span class="community-meta">{text.newsCategory[article.category]}</span>
                {article.pinned ? <span class="news-state-pill">{text.pinned}</span> : null}
                {article.featured ? <span class="news-state-pill news-state-pill--featured">{text.featured}</span> : null}
                <span class="community-meta">{new Date(article.published_at ?? article.created_at).toLocaleDateString(localeContext.locale)}</span>
                {article.source_name ? <span class="community-meta">{article.source_name}</span> : null}
              </div>
              <h3>{article.title}</h3>
              {article.summary ? <p>{article.summary}</p> : null}
            </div>
            {article.cover_image_url && coverUrlMap.get(article.cover_image_url) ? (
              <div class="news-feed-card__thumb">
                <img src={coverUrlMap.get(article.cover_image_url)!} alt={article.title} loading="lazy" decoding="async" />
              </div>
            ) : null}
          </a>
        ))}
      </div>

      {newsFeed.articles.length === 0 ? (
        <section class="community-empty">
          <strong>{text.noNews}</strong>
          <p>{text.noNewsHint}</p>
        </section>
      ) : null}

      {newsFeed.total > 5 ? (
        <NewsPagination localeContext={localeContext} currentPage={newsFeed.page} totalPages={newsFeed.total_pages} category={filter} client:load />
      ) : null}
    </div>

    <aside class="news-feed-sidebar">
      <section class="community-surface news-side-panel">
        <div class="community-section-head">
          <h2>{text.todayHot}</h2>
        </div>
        <div class="news-side-list">
          {newsFeed.hotArticles.slice(0, 5).map((article, index) => (
            <a href={`/news/${article.slug}/`} class="news-side-list__item">
              <span class="news-side-list__rank">{index + 1}</span>
              <span class="news-side-list__copy">
                <strong>{article.title}</strong>
                <small>{text.newsCategory[article.category]} · {article.view_count > 0 ? formatUiMessage(text.reads, { count: article.view_count.toLocaleString(localeContext.locale) }) : text.newlyPublished}</small>
              </span>
            </a>
          ))}
        </div>
      </section>
    </aside>
  </section>
</CommunityLayout>
