---
import CommunityLayout from "../../layouts/CommunityLayout.astro";
import { curatedNews } from "../../lib/news";
import NewsCard from "../../components/community/NewsCard.astro";
---

<CommunityLayout
  title="热点"
  description="OpenGlass Hub 的热点内容。"
  canonical="https://openglasshub.pages.dev/news/"
  activeSection="news"
>
  <section class="community-page-head">
    <div>
      <h1>热点</h1>
    </div>
  </section>

  <section class="news-layout">
    <div class="community-surface community-surface--primary">
      <div class="news-stream news-stream--compact">
        {curatedNews.map((item) => (
          <NewsCard
            href={`/news/${item.slug}/`}
            category={item.category}
            title={item.title}
            summary={item.summary}
            date={new Date(item.publishedAt).toLocaleDateString("zh-CN")}
            coverImageUrl={item.coverImageUrl}
            coverAlt={item.coverAlt}
          />
        ))}
      </div>
    </div>
  </section>
</CommunityLayout>

<style>
  .news-layout {
    display: block;
  }
  .news-stream {
    display: grid;
    gap: 0.75rem;
    padding: 0.85rem 1rem 1rem;
  }
  .news-stream--compact .community-news-card {
    border-radius: 0;
    border-left: 0;
    border-right: 0;
    border-top: 0;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    padding-left: 0;
    padding-right: 0;
  }
</style>

