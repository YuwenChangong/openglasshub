---
export const prerender = false;

import CommunityLayout from "../../layouts/CommunityLayout.astro";
import { createSSRClient, type CloudflareEnv } from "../../lib/supabase-server";
import {
  listPublicNewsFeed,
  NEWS_FILTERS,
  NEWS_CATEGORY_LABELS,
  parseNewsFilter,
} from "../../lib/news";
import { listForumFeed } from "../../lib/forum-feed";
import { formatPostTime } from "../../lib/format-time";

const env = Astro.locals.runtime.env as CloudflareEnv;
const supabase = createSSRClient(env);
const filter = parseNewsFilter(Astro.url.searchParams.get("category"));
const pageParam = Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
const page = Number.isFinite(pageParam) ? Math.max(1, pageParam) : 1;

const [newsFeed, hotDiscussions] = await Promise.all([
  listPublicNewsFeed(supabase, { filter, page, limit: 12 }),
  listForumFeed({ client: supabase, sort: "hot", limit: 5, page: 1 }),
]);

const featuredArticle = newsFeed.featuredArticle;
const articles = newsFeed.articles.filter((article) => article.slug !== featuredArticle?.slug);
const buildCategoryHref = (nextFilter: string) =>
  nextFilter === "recommended" ? "/news/" : `/news/?category=${encodeURIComponent(nextFilter)}`;
const buildPageHref = (nextPage: number) => {
  const base = filter === "recommended" ? "/news/" : `/news/?category=${encodeURIComponent(filter)}`;
  return nextPage > 1
    ? `${base}${base.includes("?") ? "&" : "?"}page=${nextPage}`
    : base;
};
---

<CommunityLayout
  title="热点"
  description="AR / AI 眼镜、空间计算与智能硬件动态。"
  canonical="https://openglasshub.pages.dev/news/"
  activeSection="news"
>
  <section class="community-page-head news-page-head">
    <div>
      <h1>热点</h1>
      <p class="community-page-lead">AR / AI 眼镜、空间计算与智能硬件动态</p>
    </div>
  </section>

  <section class="news-filter-bar" aria-label="热点分类">
    {NEWS_FILTERS.map((item) => (
      <a
        href={buildCategoryHref(item.key)}
        class:list={["news-filter-pill", { "is-active": filter === item.key }]}
      >
        {item.label}
      </a>
    ))}
  </section>

  <section class="news-feed-layout">
    <div class="news-feed-main">
      {featuredArticle ? (
        <a href={`/news/${featuredArticle.slug}/`} class="news-featured-card">
          <div class="news-featured-card__copy">
            <div class="community-inline-meta">
              <span class="community-tag">{NEWS_CATEGORY_LABELS[featuredArticle.category]}</span>
              {featuredArticle.pinned ? <span class="community-meta">置顶</span> : null}
              <span class="community-meta">
                {new Date(featuredArticle.published_at ?? featuredArticle.created_at).toLocaleDateString("zh-CN")}
              </span>
            </div>
            <h2>{featuredArticle.title}</h2>
            {featuredArticle.summary ? <p>{featuredArticle.summary}</p> : null}
          </div>
          {featuredArticle.cover_image_url ? (
            <div class="news-featured-card__media">
              <img src={featuredArticle.cover_image_url} alt={featuredArticle.title} loading="eager" />
            </div>
          ) : null}
        </a>
      ) : null}

      <div class="news-feed-list">
        {articles.map((article) => (
          <a href={`/news/${article.slug}/`} class="news-feed-card">
            <div class="news-feed-card__copy">
              <div class="community-inline-meta">
                <span class="community-tag">{NEWS_CATEGORY_LABELS[article.category]}</span>
                <span class="community-meta">{new Date(article.published_at ?? article.created_at).toLocaleDateString("zh-CN")}</span>
                {article.source_name ? <span class="community-meta">{article.source_name}</span> : null}
              </div>
              <h3>{article.title}</h3>
              {article.summary ? <p>{article.summary}</p> : null}
            </div>
            {article.cover_image_url ? (
              <div class="news-feed-card__thumb">
                <img src={article.cover_image_url} alt={article.title} loading="lazy" />
              </div>
            ) : null}
          </a>
        ))}
      </div>

      {newsFeed.articles.length === 0 ? (
        <section class="community-empty">
          <strong>当前分类暂无已发布内容</strong>
          <p>管理员发布后，这里会自动展示最新热点。</p>
        </section>
      ) : null}

      <div class="news-feed-pagination">
        {newsFeed.page > 1 ? (
          <a href={buildPageHref(newsFeed.page - 1)} class="community-action-button community-action-button--muted">上一页</a>
        ) : (
          <span class="community-action-button community-action-button--muted is-disabled" aria-disabled="true">上一页</span>
        )}
        {newsFeed.hasMore ? (
          <a href={buildPageHref(newsFeed.page + 1)} class="community-action-button community-action-button--muted">下一页</a>
        ) : (
          <span class="community-action-button community-action-button--muted is-disabled" aria-disabled="true">下一页</span>
        )}
      </div>
    </div>

    <aside class="news-feed-sidebar">
      <section class="community-surface news-side-panel">
        <div class="community-section-head">
          <h2>今日热门</h2>
        </div>
        <div class="news-side-list">
          {newsFeed.hotArticles.slice(0, 6).map((article, index) => (
            <a href={`/news/${article.slug}/`} class="news-side-list__item">
              <span class="news-side-list__rank">{index + 1}</span>
              <span class="news-side-list__copy">
                <strong>{article.title}</strong>
                <small>{NEWS_CATEGORY_LABELS[article.category]}</small>
              </span>
            </a>
          ))}
        </div>
      </section>

      <section class="community-surface news-side-panel">
        <div class="community-section-head">
          <h2>最新发布</h2>
        </div>
        <div class="news-side-list">
          {newsFeed.latestArticles.slice(0, 6).map((article) => (
            <a href={`/news/${article.slug}/`} class="news-side-list__item news-side-list__item--compact">
              <span class="news-side-list__copy">
                <strong>{article.title}</strong>
                <small>{new Date(article.published_at ?? article.created_at).toLocaleDateString("zh-CN")}</small>
              </span>
            </a>
          ))}
        </div>
      </section>

      <section class="community-surface news-side-panel">
        <div class="community-section-head">
          <h2>热门讨论</h2>
          <a href="/feed/?sort=hot" class="community-link">更多</a>
        </div>
        <div class="news-side-list">
          {hotDiscussions.posts.map((post) => (
            <a href={`/posts/${post.id}/`} class="news-side-list__item news-side-list__item--compact">
              <span class="news-side-list__copy">
                <strong>{post.title}</strong>
                <small>{formatPostTime(post.created_at)}</small>
              </span>
            </a>
          ))}
        </div>
      </section>
    </aside>
  </section>
</CommunityLayout>
