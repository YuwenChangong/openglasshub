---
import CommunityLayout from "../../layouts/CommunityLayout.astro";
import { curatedNews } from "../../lib/news";
import NewsCard from "../../components/community/NewsCard.astro";
---

<CommunityLayout
  title="热点"
  description="OpenGlass Hub 的热点内容入口，由管理员手动整理和更新。"
  canonical="https://openglasshub.pages.dev/news/"
  activeSection="news"
>
  <section class="community-page-head">
    <div>
      <h1>热点</h1>
      <p class="community-page-lead">管理员精选、手动更新、偏内容流形态的公开入口。这里不是抓取聚合流，也不会假装实时。</p>
    </div>
  </section>

  <section class="news-stream">
    {curatedNews.map((item) => (
      <NewsCard
        href={`/news/${item.slug}/`}
        category={item.category}
        title={item.title}
        summary={item.summary}
        date={new Date(item.publishedAt).toLocaleDateString("zh-CN")}
      />
    ))}
  </section>
</CommunityLayout>

<style>
  .news-stream {
    display: grid;
    gap: 1rem;
  }
</style>
