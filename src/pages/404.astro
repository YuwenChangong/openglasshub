---
import CommunityLayout from "../layouts/CommunityLayout.astro";
import { getUiMessages } from "../lib/i18n/catalog";
const text = getUiMessages(Astro.locals.localeContext.locale).shell;
---

<CommunityLayout
  title={text.notFoundTitle}
  description={text.notFoundDescription}
  noindex={true}
  activeSection="home"
>
  <section class="not-found-page community-surface community-surface--padded">
    <p class="not-found-page__eyebrow">404</p>
    <h1>{text.notFoundTitle}</h1>
    <p class="not-found-page__lead">{text.notFoundLead}</p>
    <div class="not-found-page__actions">
      <a href="/" class="community-button">{text.notFoundHome}</a>
      <a href="/feed/" class="community-button--secondary">{text.notFoundForum}</a>
      <a href="/news/" class="community-button--secondary">{text.notFoundNews}</a>
      <a href="/search/" class="community-button--secondary">{text.notFoundSearch}</a>
    </div>
  </section>
</CommunityLayout>

<style>
  .not-found-page {
    width: min(100%, 760px);
    margin: 3.5rem auto 0;
    display: grid;
    gap: 0.9rem;
    text-align: center;
  }
  .not-found-page__eyebrow {
    margin: 0;
    color: rgba(242, 244, 245, 0.54);
    font-size: 0.78rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }
  .not-found-page h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.75rem);
    letter-spacing: -0.05em;
  }
  .not-found-page__lead {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.98rem;
  }
  .not-found-page__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    margin-top: 0.35rem;
  }
</style>
