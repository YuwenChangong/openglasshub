---
export const prerender = false;

import { env as runtimeEnv } from "cloudflare:workers";
import ForumLayout from "../../layouts/ForumLayout.astro";
import { createSSRClient, type CloudflareEnv } from "../../lib/supabase-server";
import CircleCard from "../../components/community/CircleCard.astro";
import { isPublicVisibleCircle } from "../../lib/site-navigation";
import { buildCircleImageMap } from "../../lib/circle-images";
import { fetchCirclesWithFallback } from "../../lib/circle-data";
import { resolveLocale } from "../../lib/i18n/locale";
import { getUiMessages, formatUiMessage } from "../../lib/i18n/catalog";

const env = runtimeEnv as CloudflareEnv;
const localeContext = Astro.locals.localeContext ?? resolveLocale({});
const text = getUiMessages(localeContext.locale).community;
const supabase = createSSRClient(env);

const { circles, error } = await fetchCirclesWithFallback(supabase);
const visibleCircles = circles.filter((circle) => isPublicVisibleCircle(circle));
const circleImageMap = await buildCircleImageMap(supabase, visibleCircles, 60 * 60, {
  publicProxy: true,
});
---

<ForumLayout
  title={text.circles}
  description={text.circlesDescription}
  canonical="/circles/"
  activeTab="circles"
>
  <h1>{text.circles}</h1>
  <p class="section-lead circle-page-lead">{text.circlesLead}</p>

  <div class="community-cta-row circle-page-actions">
    <a href="/feed/" class="community-action-button">{text.backFeed}</a>
    <a href="/circles/new/" class="community-action-button community-action-button--primary">{text.createCircle}</a>
  </div>

  {error ? (
    <div class="forum-empty">
      <strong>{text.circlesFailed}</strong>
      <p>{error.message}</p>
    </div>
  ) : visibleCircles.length === 0 ? (
    <div class="forum-empty">
      <strong>{text.noCircles}</strong>
    </div>
  ) : (
    <section class="circle-grid">
      {visibleCircles.map((circle) => (
        <CircleCard
          id={circle.id}
          name={circle.name}
          slug={circle.slug}
          description={circle.description || undefined}
          latestNote={formatUiMessage(text.created, { date: new Date(circle.created_at).toLocaleDateString(localeContext.locale) })}
          imageUrl={circleImageMap.get(circle.id)}
        />
      ))}
    </section>
  )}
</ForumLayout>

<style>
.circle-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.9rem;
}

.circle-page-lead {
  max-width: 40rem;
}

.circle-page-actions {
  margin: 0.9rem 0 1.2rem;
}

@media (max-width: 900px) {
  .circle-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 720px) {
  .circle-page-actions {
    margin: 0.8rem 0 1rem;
  }
}
</style>

