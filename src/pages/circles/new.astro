---
export const prerender = false;

import CommunityLayout from "../../layouts/CommunityLayout.astro";
import CreateCircleForm from "../../components/forum/CreateCircleForm";
import { resolveLocale } from "../../lib/i18n/locale";
import { getUiMessages } from "../../lib/i18n/catalog";
const localeContext = Astro.locals.localeContext ?? resolveLocale({});
const text = getUiMessages(localeContext.locale).community;
---

<CommunityLayout
  title={text.createCircle}
  description={text.createCircleDescription}
  activeSection="forum"
  noindex={true}
>
  <section class="circle-create-page">
    <nav class="circle-create-page__nav" aria-label={text.backNavigation}>
      <a href="/circles/" class="community-action-button community-action-button--muted">{text.backCircles}</a>
    </nav>

    <section class="community-surface community-surface--padded circle-create-page-panel">
      <h1 class="circle-create-page-panel__title">{text.createCircle}</h1>
      <CreateCircleForm localeContext={localeContext} client:load mode="page" />
    </section>
  </section>
</CommunityLayout>

<style>
  .circle-create-page {
    width: min(100%, 760px);
    margin: 0 auto;
    display: grid;
    gap: 0.9rem;
  }

  .circle-create-page__nav {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .circle-create-page-panel {
    display: grid;
    gap: 0.9rem;
  }

  .circle-create-page-panel__title {
    margin: 0;
    font-size: 1.65rem;
    letter-spacing: -0.03em;
  }
</style>
