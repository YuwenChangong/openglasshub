---
export const prerender = false;

import ForumLayout from "../../layouts/ForumLayout.astro";
import { createSSRClient, type CloudflareEnv } from "../../lib/supabase-server";
import PostCard from "../../components/community/PostCard.astro";
import GlobalSearchBox from "../../components/community/GlobalSearchBox";
import { buildResolvedPostMediaMap, type PostMediaRow } from "../../lib/forum-media";
import { buildPostLikeCountMap } from "../../lib/post-engagement";
import { buildCircleImageMap } from "../../lib/circle-images";
import { fetchCircleBySlugWithFallback } from "../../lib/circle-data";
import CircleManageEntry from "../../components/forum/CircleManageEntry";
import { formatPostTime } from "../../lib/format-time";
import { sanitizeBodyForDisplay } from "../../lib/post-body";
import { isPublicVisibleCircle } from "../../lib/site-navigation";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/circles/");
}

const env = Astro.locals.runtime.env as CloudflareEnv;
const supabase = createSSRClient(env);
const r2PublicBaseUrl = env.R2_PUBLIC_BASE_URL || "";

const { circle, error: circleError } = await fetchCircleBySlugWithFallback(supabase, slug);
const publicCircle = circle && isPublicVisibleCircle(circle) ? circle : null;

if (circleError || !publicCircle) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

let posts: any[] = [];
let postsError: any = null;

if (publicCircle) {
  const result = await supabase
    .from("posts")
    .select("id, author_id, title, body, type, created_at, profiles:author_id(display_name,username), post_media(*)")
    .eq("circle_id", publicCircle.id)
    .eq("status", "published")
    .order("created_at", { ascending: false })
    .limit(50);

  posts = result.data || [];
  postsError = result.error;
}

const postMediaMap = publicCircle
  ? await buildResolvedPostMediaMap(
      supabase,
      posts as Array<{ id: string; post_media?: PostMediaRow[] | null }>,
      60 * 60,
      r2PublicBaseUrl,
    )
  : new Map();
const likeCountMap = publicCircle ? await buildPostLikeCountMap(supabase, posts.map((post) => post.id)) : new Map();

const postTypeLabels: Record<string, string> = {
  experience: "体验",
  question: "提问",
  review: "评测",
  dev: "开发",
  news: "资讯",
  feedback: "反馈",
};

const canonicalUrl = publicCircle ? `https://openglasshub.pages.dev/circles/${publicCircle.slug}/` : undefined;
const circleImageMap = publicCircle ? await buildCircleImageMap(supabase, [publicCircle]) : new Map();
const circleImageUrl = publicCircle ? circleImageMap.get(publicCircle.id) : "";
---

{!publicCircle ? (
  <ForumLayout title="圈子未找到" noindex={true}>
    <div class="forum-empty">
      <strong>圈子未找到</strong>
      <p>该圈子可能不存在，或者当前还没有公开显示。</p>
      <a href="/circles/" class="community-action-button">返回圈子列表</a>
    </div>
  </ForumLayout>
) : (
  <ForumLayout
    title={publicCircle.name}
    description={publicCircle.description || `${publicCircle.name} · OpenGlass Hub 论坛圈子`}
    canonical={canonicalUrl}
    activeTab="circles"
  >
    <nav class="community-breadcrumb" aria-label="面包屑">
      <a href="/">首页</a>
      <span class="community-breadcrumb__sep">/</span>
      <a href="/feed/">论坛</a>
      <span class="community-breadcrumb__sep">/</span>
      <a href="/circles/">圈子</a>
      <span class="community-breadcrumb__sep">/</span>
      <span class="community-breadcrumb__current">{publicCircle.name}</span>
    </nav>

    <header style="margin-bottom: 1.4rem;">
      {circleImageUrl ? (
        <div class="circle-detail-cover">
          <img src={circleImageUrl} alt={`${publicCircle.name} 圈子封面`} />
        </div>
      ) : null}
      <h1 style="margin: 0 0 0.5rem 0; font-size: 1.75rem;">{publicCircle.name}</h1>
      {publicCircle.description ? (
        <p style="color: var(--text-muted); margin: 0 0 0.5rem 0; font-size: 1rem;">{publicCircle.description}</p>
      ) : null}
      <span class="forum-meta">创建于 {new Date(publicCircle.created_at).toLocaleDateString("zh-CN")}</span>
      <div class="community-inline-links" style="margin-top: 0.8rem;">
        <CircleManageEntry circleSlug={publicCircle.slug} ownerId={publicCircle.owner_id ?? null} client:load />
      </div>
    </header>

    <div class="circle-stream-head">
      <div>
        <h2>圈子帖子</h2>
      </div>
      <div class="community-inline-links">
        <a href="/posts/new/" class="community-action-button community-action-button--primary">发帖</a>
        <a href="/feed/" class="community-action-button community-action-button--muted">全部动态</a>
      </div>
    </div>

    <div class="circle-search-box-wrap">
      <GlobalSearchBox circleSlug={publicCircle.slug} compact={true} client:load />
    </div>

    {postsError ? (
      <div class="forum-empty">
        <strong>加载帖子失败</strong>
        <p>{postsError.message}</p>
      </div>
    ) : posts.length === 0 ? (
      <div class="forum-empty">
        <strong>该圈子还没有公开帖子</strong>
      </div>
    ) : (
      <div class="circle-post-stream">
        {posts.map((post) => (
          <PostCard
            id={post.id}
            title={post.title}
            excerpt={sanitizeBodyForDisplay(post.body).replace(/[#*_`>\n\r]+/g, " ").replace(/\s+/g, " ").trim().slice(0, 110)}
            circleName={publicCircle.name}
            circleSlug={publicCircle.slug}
            typeLabel={post.type ? (postTypeLabels[post.type] || post.type) : undefined}
            authorName={post.profiles?.display_name || post.profiles?.username || undefined}
            authorId={post.author_id}
            authorUsername={post.profiles?.username || undefined}
            timestamp={formatPostTime(post.created_at)}
            media={postMediaMap.get(post.id) ?? []}
            likeCount={likeCountMap.get(post.id) ?? 0}
          />
        ))}
      </div>
    )}

    <div class="community-cta-row footer-actions" style="margin-top: 2rem;">
      <a href="/circles/" class="community-action-button community-action-button--muted">返回圈子列表</a>
      <a href="/feed/" class="community-action-button community-action-button--muted">查看全部动态</a>
    </div>
  </ForumLayout>
)}

<style>
  .circle-detail-cover {
    width: 100%;
    max-width: 560px;
    margin: 0 0 1rem;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.03);
  }
  .circle-detail-cover img {
    display: block;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .circle-stream-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.8rem;
    margin-bottom: 0.3rem;
    border-bottom: 1px solid var(--border);
  }
  .circle-stream-head h2 {
    margin: 0;
    font-size: 1.08rem;
  }
  .circle-search-box-wrap {
    margin: 1rem 0 1.5rem;
    max-width: 28rem;
  }
  .circle-post-stream {
    display: grid;
    gap: 0.2rem;
  }
  .footer-actions {
    gap: 0.6rem;
  }
  @media (max-width: 900px) {
    .circle-stream-head {
      align-items: flex-start;
      flex-direction: column;
    }
    .circle-search-box-wrap {
      max-width: 100%;
    }
  }
</style>
