---
export const prerender = false;

import { env as runtimeEnv } from "cloudflare:workers";
import ForumLayout from "../../layouts/ForumLayout.astro";
import { createSSRClient, type CloudflareEnv } from "../../lib/supabase-server";
import PostCard from "../../components/community/PostCard.astro";
import GlobalSearchBox from "../../components/community/GlobalSearchBox";
import { buildResolvedPostMediaMap, type PostMediaRow } from "../../lib/forum-media";
import { buildPostLikeCountMap } from "../../lib/post-engagement";
import { buildCircleImageMap } from "../../lib/circle-images";
import { fetchCircleBySlugWithFallback } from "../../lib/circle-data";
import CircleManageEntry from "../../components/forum/CircleManageEntry";
import ReportTrigger from "../../components/reports/ReportTrigger";
import { formatCommunityPostTime } from "../../lib/i18n/messages/community";
import { resolveLocale } from "../../lib/i18n/locale";
import { getUiMessages, formatUiMessage } from "../../lib/i18n/catalog";
import { sanitizeBodyForDisplay } from "../../lib/post-body";
import { isPublicVisibleCircle } from "../../lib/site-navigation";

const { slug } = Astro.params;
const localeContext = Astro.locals.localeContext ?? resolveLocale({});
const text = getUiMessages(localeContext.locale).community;

if (!slug) {
  return Astro.redirect("/circles/");
}

const env = runtimeEnv as CloudflareEnv;
const supabase = createSSRClient(env);
const r2PublicBaseUrl = env.R2_PUBLIC_BASE_URL || "";

const { circle, error: circleError } = await fetchCircleBySlugWithFallback(supabase, slug);
const publicCircle = circle && isPublicVisibleCircle(circle) ? circle : null;

if (circleError || !publicCircle) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

let posts: any[] = [];
let postsError: any = null;

if (publicCircle) {
  const result = await supabase
    .from("posts")
    .select("id, author_id, title, body, type, created_at, profiles:author_id(display_name,username), post_media(*)")
    .eq("circle_id", publicCircle.id)
    .eq("status", "published")
    .eq("moderation_status", "published")
    .order("created_at", { ascending: false })
    .limit(50);

  posts = result.data || [];
  postsError = result.error;
}

const postMediaMap = publicCircle
  ? await buildResolvedPostMediaMap(
      supabase,
      posts as Array<{ id: string; post_media?: PostMediaRow[] | null }>,
      60 * 60,
      r2PublicBaseUrl,
      {
        publicProxy: true,
      },
    )
  : new Map();
const likeCountMap = publicCircle ? await buildPostLikeCountMap(supabase, posts.map((post) => post.id)) : new Map();

const postTypeLabels: Record<string, string> = text.types;

const canonicalUrl = publicCircle ? `/circles/${publicCircle.slug}/` : undefined;
const circleImageMap = publicCircle
  ? await buildCircleImageMap(supabase, [publicCircle], 60 * 60, {
      publicProxy: true,
    })
  : new Map();
const circleImageUrl = publicCircle ? circleImageMap.get(publicCircle.id) : "";
---

{!publicCircle ? (
  <ForumLayout title={text.circleNotFound} noindex={true}>
    <div class="forum-empty">
      <strong>{text.circleNotFound}</strong>
      <p>{text.circleNotFoundDetail}</p>
      <a href="/circles/" class="community-action-button">{text.backCircles}</a>
    </div>
  </ForumLayout>
) : (
  <ForumLayout
    title={publicCircle.name}
    description={publicCircle.description || formatUiMessage(text.circleDescription, { name: publicCircle.name })}
    canonical={canonicalUrl}
    activeTab="circles"
  >
    <nav class="community-breadcrumb" aria-label={text.breadcrumb}>
      <a href="/">{text.home}</a>
      <span class="community-breadcrumb__sep">/</span>
      <a href="/feed/">{text.forum}</a>
      <span class="community-breadcrumb__sep">/</span>
      <a href="/circles/">{text.circles}</a>
      <span class="community-breadcrumb__sep">/</span>
      <span class="community-breadcrumb__current">{publicCircle.name}</span>
    </nav>

    <header style="margin-bottom: 1.4rem;">
      {circleImageUrl ? (
        <div class="circle-detail-cover">
          <img src={circleImageUrl} alt={formatUiMessage(text.circleCover, { name: publicCircle.name })} />
        </div>
      ) : null}
      <h1 style="margin: 0 0 0.5rem 0; font-size: 1.75rem;">{publicCircle.name}</h1>
      {publicCircle.description ? (
        <p style="color: var(--text-muted); margin: 0 0 0.5rem 0; font-size: 1rem;">{publicCircle.description}</p>
      ) : null}
      <span class="forum-meta">{formatUiMessage(text.created, { date: new Date(publicCircle.created_at).toLocaleDateString(localeContext.locale) })}</span>
      <div class="community-inline-links" style="margin-top: 0.8rem;">
        <CircleManageEntry circleSlug={publicCircle.slug} ownerId={publicCircle.owner_id ?? null} localeContext={localeContext} client:load />
        <ReportTrigger
          localeContext={localeContext}
          targetType="circle"
          targetId={publicCircle.id}
          buttonLabel={text.reportCircle}
          className="community-action-button community-action-button--compact"
          compact={true}
          client:load
        />
      </div>
    </header>

    <div class="circle-stream-head">
      <div>
        <h2>{text.circlePosts}</h2>
      </div>
      <div class="community-inline-links">
        <a href="/posts/new/" class="community-action-button community-action-button--primary">{text.newPost}</a>
        <a href="/feed/" class="community-action-button community-action-button--muted">{text.allFeed}</a>
      </div>
    </div>

    <div class="circle-search-box-wrap">
      <GlobalSearchBox circleSlug={publicCircle.slug} compact={true} localeContext={localeContext} client:load />
    </div>

    {postsError ? (
      <div class="forum-empty">
        <strong>{text.postsFailed}</strong>
        <p>{postsError.message}</p>
      </div>
    ) : posts.length === 0 ? (
      <div class="forum-empty">
        <strong>{text.noCirclePosts}</strong>
      </div>
    ) : (
      <div class="circle-post-stream">
        {posts.map((post) => (
          <PostCard
            id={post.id}
            title={post.title}
            excerpt={sanitizeBodyForDisplay(post.body).replace(/[#*_`>\n\r]+/g, " ").replace(/\s+/g, " ").trim().slice(0, 110)}
            circleName={publicCircle.name}
            circleSlug={publicCircle.slug}
            typeLabel={post.type ? (postTypeLabels[post.type] || post.type) : undefined}
            authorName={post.profiles?.display_name || post.profiles?.username || undefined}
            authorId={post.author_id}
            authorUsername={post.profiles?.username || undefined}
            timestamp={formatCommunityPostTime(post.created_at, localeContext.locale)}
            media={postMediaMap.get(post.id) ?? []}
            likeCount={likeCountMap.get(post.id) ?? 0}
          />
        ))}
      </div>
    )}

    <div class="community-cta-row footer-actions" style="margin-top: 2rem;">
      <a href="/circles/" class="community-action-button community-action-button--muted">{text.backCircles}</a>
      <a href="/feed/" class="community-action-button community-action-button--muted">{text.viewAllFeed}</a>
    </div>
  </ForumLayout>
)}

<style>
  .circle-detail-cover {
    width: 100%;
    max-width: 560px;
    margin: 0 0 1rem;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.03);
  }
  .circle-detail-cover img {
    display: block;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .circle-stream-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.8rem;
    margin-bottom: 0.3rem;
    border-bottom: 1px solid var(--border);
  }
  .circle-stream-head h2 {
    margin: 0;
    font-size: 1.08rem;
  }
  .circle-search-box-wrap {
    margin: 1rem 0 1.5rem;
    max-width: 28rem;
  }
  .circle-post-stream {
    display: grid;
    gap: 0.2rem;
  }
  .footer-actions {
    gap: 0.6rem;
  }
  @media (max-width: 900px) {
    .circle-stream-head {
      align-items: flex-start;
      flex-direction: column;
    }
    .circle-search-box-wrap {
      max-width: 100%;
    }
  }
</style>
