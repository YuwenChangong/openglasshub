---
export const prerender = false;

import ForumLayout from "../../layouts/ForumLayout.astro";
import { createSSRClient, type CloudflareEnv } from "../../lib/supabase-server";
import PostCard from "../../components/community/PostCard.astro";
import { buildResolvedPostMediaMap, type PostMediaRow } from "../../lib/forum-media";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/circles/");
}

const env = Astro.locals.runtime.env as CloudflareEnv;
const supabase = createSSRClient(env);

const { data: circle, error: circleError } = await supabase
  .from("circles")
  .select("id, name, slug, description, created_at")
  .eq("slug", slug)
  .single();

if (circleError || !circle) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

let posts: any[] = [];
let postsError: any = null;

if (circle) {
  const result = await supabase
    .from("posts")
    .select("id, title, body, type, created_at, profiles:author_id(display_name), post_media(id, post_id, kind, url, storage_path, thumbnail_url, alt_text, width, height, duration_seconds, size_bytes, mime_type, sort_order, is_cover, created_at)")
    .eq("circle_id", circle.id)
    .eq("status", "published")
    .order("created_at", { ascending: false })
    .limit(50);

  posts = result.data || [];
  postsError = result.error;
}

const postMediaMap = circle ? await buildResolvedPostMediaMap(supabase, posts as Array<{ id: string; post_media?: PostMediaRow[] | null }>) : new Map();

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
}

const postTypeLabels: Record<string, string> = {
  experience: "体验",
  question: "提问",
  review: "评测",
  dev: "开发",
  news: "资讯",
  feedback: "反馈",
};

const canonicalUrl = circle ? `https://openglasshub.pages.dev/circles/${circle.slug}/` : undefined;
---

{!circle ? (
  <ForumLayout title="圈子未找到" noindex={true}>
    <div class="forum-empty">
      <strong>圈子未找到</strong>
      <p>该圈子可能不存在，或者当前还没有公开显示。</p>
      <a href="/circles/" class="forum-btn">返回圈子列表</a>
    </div>
  </ForumLayout>
) : (
  <ForumLayout
    title={circle.name}
    description={circle.description || `${circle.name} — OpenGlass Hub 论坛圈子`}
    canonical={canonicalUrl}
    activeTab="circles"
  >
    <nav class="breadcrumb">
      <a href="/">首页</a>
      <span>/</span>
      <a href="/feed/">论坛</a>
      <span>/</span>
      <a href="/circles/">圈子</a>
      <span>/</span>
      <span style="color: #e8edf8;">{circle.name}</span>
    </nav>

    <header style="margin-bottom: 2rem;">
      <h1 style="margin: 0 0 0.5rem 0; font-size: 1.75rem;">{circle.name}</h1>
      {circle.description && (
        <p style="color: #9badcd; margin: 0 0 0.5rem 0; font-size: 1rem;">{circle.description}</p>
      )}
      <span class="forum-meta">创建于 {new Date(circle.created_at).toLocaleDateString("zh-CN")}</span>
    </header>

    <h2>圈子帖子</h2>

    {postsError ? (
      <div class="forum-empty">
        <strong>加载帖子失败</strong>
        <p>{postsError.message}</p>
      </div>
    ) : posts.length === 0 ? (
      <div class="forum-empty">
        <strong>该圈子还没有公开帖子</strong>
        <p>如果你已经在用 {circle.name}，或者正在研究相关方向，现在就是最适合发第一篇帖子的时机。</p>
        <a href="/posts/new/" class="forum-btn forum-btn--primary">写第一篇帖子</a>
      </div>
    ) : (
      <div style="display: grid; gap: 1rem;">
        {posts.map((post) => (
          <PostCard
            id={post.id}
            title={post.title}
            excerpt={post.body ? post.body.replace(/[#*_`>\n\r]+/g, " ").replace(/\s+/g, " ").trim().slice(0, 110) : ""}
            circleName={circle.name}
            circleSlug={circle.slug}
            typeLabel={post.type ? (postTypeLabels[post.type] || post.type) : undefined}
            authorName={post.profiles?.display_name || undefined}
            timestamp={formatDate(post.created_at)}
            media={postMediaMap.get(post.id) ?? []}
          />
        ))}
      </div>
    )}

    <div class="footer" style="margin-top: 2rem;">
      <a href="/circles/">← 返回圈子列表</a>
      {" · "}
      <a href="/feed/">查看全部动态</a>
    </div>
  </ForumLayout>
)}
