---
export const prerender = false;

import ForumLayout from "../../layouts/ForumLayout.astro";
import { createSSRClient, type CloudflareEnv } from "../../lib/supabase-server";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/circles/");
}

const env = Astro.locals.runtime.env as CloudflareEnv;
const supabase = createSSRClient(env);

const { data: circle, error: circleError } = await supabase
  .from("circles")
  .select("id, name, slug, description, created_at")
  .eq("slug", slug)
  .single();

if (circleError || !circle) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

let posts: any[] = [];
let postsError: any = null;

if (circle) {
  const result = await supabase
    .from("posts")
    .select("id, title, type, created_at, profiles:author_id(display_name)")
    .eq("circle_id", circle.id)
    .eq("status", "published")
    .order("created_at", { ascending: false })
    .limit(50);

  posts = result.data || [];
  postsError = result.error;
}

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
}

const postTypeLabels: Record<string, string> = {
  experience: "体验",
  question: "提问",
  review: "评测",
  dev: "开发",
  news: "资讯",
  feedback: "反馈",
};

const canonicalUrl = circle ? `https://openglasshub.pages.dev/circles/${circle.slug}/` : undefined;
---

{!circle ? (
  <ForumLayout title="圈子未找到" noindex={true}>
    <div class="empty-state">
      <p style="font-size: 2rem; margin-bottom: 0.5rem;">🔍</p>
      <p>圈子未找到</p>
      <p class="meta">该圈子可能不存在。</p>
      <a href="/circles/" class="btn-primary" style="margin-top: 1rem;">返回圈子列表</a>
    </div>
  </ForumLayout>
) : (
  <ForumLayout
    title={circle.name}
    description={circle.description || `${circle.name} — OpenGlass Hub 论坛圈子`}
    canonical={canonicalUrl}
  >
    <nav class="breadcrumb">
      <a href="/">首页</a>
      <span>/</span>
      <a href="/feed/">动态</a>
      <span>/</span>
      <a href="/circles/">圈子</a>
      <span>/</span>
      <span style="color: #e8edf8;">{circle.name}</span>
    </nav>

    <header style="margin-bottom: 2rem;">
      <h1 style="margin: 0 0 0.5rem 0; font-size: 1.75rem;">{circle.name}</h1>
      {circle.description && (
        <p style="color: #8892b0; margin: 0 0 0.5rem 0; font-size: 1rem;">{circle.description}</p>
      )}
      <span class="meta">创建于 {new Date(circle.created_at).toLocaleDateString("zh-CN")}</span>
    </header>

    <h2>圈子帖子</h2>

    {postsError ? (
      <div class="empty-state">
        <p>⚠️ 加载帖子时出错，请稍后重试。</p>
        <p class="meta">{postsError.message}</p>
      </div>
    ) : posts.length === 0 ? (
      <div class="empty-state">
        <p style="font-size: 2rem; margin-bottom: 0.5rem;">📝</p>
        <p>该圈子暂无帖子</p>
        <p class="meta">成为第一个在「{circle.name}」发帖的人吧！</p>
        <a href="/posts/new/" class="btn-primary" style="margin-top: 1rem;">写第一篇帖子</a>
      </div>
    ) : (
      <div style="display: grid; gap: 1rem;">
        {posts.map((post) => (
          <article class="card" style="padding: 1rem 1.5rem;">
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; flex-wrap: wrap;">
              {post.type && (
                <span class="tag tag-purple">{postTypeLabels[post.type] || post.type}</span>
              )}
              <span class="meta">{formatDate(post.created_at)}</span>
            </div>
            <h3 style="margin: 0 0 0.5rem 0; font-size: 1.1rem;">
              <a href={`/posts/${post.id}/`} style="color: #e8edf8; text-decoration: none;">
                {post.title}
              </a>
            </h3>
            <div class="meta" style="display: flex; gap: 1rem;">
              <span>by {post.profiles?.display_name || "匿名"}</span>
            </div>
          </article>
        ))}
      </div>
    )}

    <div class="footer" style="margin-top: 2rem;">
      <a href="/circles/">← 返回圈子列表</a>
      {" · "}
      <a href="/feed/">查看全部动态</a>
    </div>
  </ForumLayout>
)}
