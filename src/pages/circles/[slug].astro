---
export const prerender = false;

import ForumLayout from "../../layouts/ForumLayout.astro";
import { createSSRClient, type CloudflareEnv } from "../../lib/supabase-server";
import PostCard from "../../components/community/PostCard.astro";
import { buildResolvedPostMediaMap, type PostMediaRow } from "../../lib/forum-media";
import { buildPostLikeCountMap } from "../../lib/post-engagement";
import { buildCircleImageMap } from "../../lib/circle-images";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/circles/");
}

const env = Astro.locals.runtime.env as CloudflareEnv;
const supabase = createSSRClient(env);

const { data: circle, error: circleError } = await supabase
  .from("circles")
  .select("id, name, slug, description, created_at, image_path")
  .eq("slug", slug)
  .single();

if (circleError || !circle) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

let posts: any[] = [];
let postsError: any = null;

if (circle) {
  const result = await supabase
    .from("posts")
    .select("id, title, body, type, created_at, profiles:author_id(display_name), post_media(*)")
    .eq("circle_id", circle.id)
    .eq("status", "published")
    .order("created_at", { ascending: false })
    .limit(50);

  posts = result.data || [];
  postsError = result.error;
}

const postMediaMap = circle ? await buildResolvedPostMediaMap(supabase, posts as Array<{ id: string; post_media?: PostMediaRow[] | null }>) : new Map();
const likeCountMap = circle ? await buildPostLikeCountMap(supabase, posts.map((post) => post.id)) : new Map();

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
}

const postTypeLabels: Record<string, string> = {
  experience: "体验",
  question: "提问",
  review: "评测",
  dev: "开发",
  news: "资讯",
  feedback: "反馈",
};

const canonicalUrl = circle ? `https://openglasshub.pages.dev/circles/${circle.slug}/` : undefined;
const circleImageMap = circle ? await buildCircleImageMap(supabase, [circle]) : new Map();
const circleImageUrl = circle ? circleImageMap.get(circle.id) : "";
---

{!circle ? (
  <ForumLayout title="圈子未找到" noindex={true}>
    <div class="forum-empty">
      <strong>圈子未找到</strong>
      <p>该圈子可能不存在，或者当前还没有公开显示。</p>
      <a href="/circles/" class="forum-btn">返回圈子列表</a>
    </div>
  </ForumLayout>
) : (
  <ForumLayout
    title={circle.name}
    description={circle.description || `${circle.name} — OpenGlass Hub 论坛圈子`}
    canonical={canonicalUrl}
    activeTab="circles"
  >
    <nav class="community-breadcrumb" aria-label="面包屑">
      <a href="/">首页</a>
      <span class="community-breadcrumb__sep">/</span>
      <a href="/feed/">论坛</a>
      <span class="community-breadcrumb__sep">/</span>
      <a href="/circles/">圈子</a>
      <span class="community-breadcrumb__sep">/</span>
      <span class="community-breadcrumb__current">{circle.name}</span>
    </nav>

    <header style="margin-bottom: 1.4rem;">
      {circleImageUrl ? (
        <div class="circle-detail-cover">
          <img src={circleImageUrl} alt={`${circle.name} 圈子封面`} />
        </div>
      ) : null}
      <h1 style="margin: 0 0 0.5rem 0; font-size: 1.75rem;">{circle.name}</h1>
      {circle.description && (
        <p style="color: var(--text-muted); margin: 0 0 0.5rem 0; font-size: 1rem;">{circle.description}</p>
      )}
      <span class="forum-meta">创建于 {new Date(circle.created_at).toLocaleDateString("zh-CN")}</span>
    </header>

    <div class="circle-stream-head">
      <div>
        <h2>圈子帖子</h2>
        <p>只显示该圈子的公开帖子，按发布时间倒序排列。</p>
      </div>
      <div class="community-inline-links">
        <a href="/posts/new/" class="community-inline-link">发帖</a>
        <a href="/feed/" class="community-inline-link">全部动态</a>
      </div>
    </div>

    {postsError ? (
      <div class="forum-empty">
        <strong>加载帖子失败</strong>
        <p>{postsError.message}</p>
      </div>
    ) : posts.length === 0 ? (
      <div class="forum-empty">
        <strong>该圈子还没有公开帖子</strong>
        <p>如果你已经在用 {circle.name}，或者正在研究相关方向，现在就是最适合发第一篇帖子的时机。</p>
        <a href="/posts/new/" class="forum-btn forum-btn--primary">写第一篇帖子</a>
      </div>
    ) : (
      <div class="circle-post-stream">
        {posts.map((post) => (
          <PostCard
            id={post.id}
            title={post.title}
            excerpt={post.body ? post.body.replace(/[#*_`>\n\r]+/g, " ").replace(/\s+/g, " ").trim().slice(0, 110) : ""}
            circleName={circle.name}
            circleSlug={circle.slug}
            typeLabel={post.type ? (postTypeLabels[post.type] || post.type) : undefined}
            authorName={post.profiles?.display_name || undefined}
            timestamp={formatDate(post.created_at)}
            media={postMediaMap.get(post.id) ?? []}
            likeCount={likeCountMap.get(post.id) ?? 0}
          />
        ))}
      </div>
    )}

    <div class="footer" style="margin-top: 2rem;">
      <a href="/circles/">← 返回圈子列表</a>
      {" · "}
      <a href="/feed/">查看全部动态</a>
    </div>
  </ForumLayout>
)}

<style>
  .circle-detail-cover {
    width: 100%;
    max-width: 560px;
    margin: 0 0 1rem;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.03);
  }
  .circle-detail-cover img {
    display: block;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .circle-stream-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.8rem;
    margin-bottom: 0.3rem;
    border-bottom: 1px solid var(--border);
  }
  .circle-stream-head h2 {
    margin: 0;
    font-size: 1.08rem;
  }
  .circle-stream-head p {
    margin: 0.2rem 0 0;
    color: var(--text-muted);
    font-size: 0.82rem;
  }
  .circle-post-stream {
    display: grid;
    gap: 0.2rem;
  }
  .footer {
    color: var(--text-faint);
  }
  .footer a {
    color: rgba(242, 244, 245, 0.72);
    text-decoration: none;
    transition: color 140ms ease;
  }
  .footer a:hover {
    color: var(--text);
  }
  @media (max-width: 900px) {
    .circle-stream-head {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
