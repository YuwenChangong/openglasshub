---
export const prerender = false;
import ForumLayout from "../../../layouts/ForumLayout.astro";
import CircleOwnerDashboard from "../../../components/forum/CircleOwnerDashboard";
import { resolveLocale } from "../../../lib/i18n/locale";
import { getUiMessages } from "../../../lib/i18n/catalog";
const localeContext = Astro.locals.localeContext ?? resolveLocale({});
const text = getUiMessages(localeContext.locale).community;

const slug = String(Astro.params.slug ?? "").trim().toLowerCase();

if (!slug) {
  return Astro.redirect("/circles/");
}
---

<ForumLayout title={text.manageCircle} noindex={true} activeTab="circles">
  <nav class="community-breadcrumb" aria-label={text.breadcrumb}>
    <a href="/">{text.home}</a>
    <span class="community-breadcrumb__sep">/</span>
    <a href="/feed/">{text.forum}</a>
    <span class="community-breadcrumb__sep">/</span>
    <a href="/circles/">{text.circles}</a>
    <span class="community-breadcrumb__sep">/</span>
    <a href={`/circles/${slug}/`}>{text.details}</a>
    <span class="community-breadcrumb__sep">/</span>
    <span class="community-breadcrumb__current">{text.management}</span>
  </nav>

  <CircleOwnerDashboard circleSlug={slug} localeContext={localeContext} client:load />
</ForumLayout>
