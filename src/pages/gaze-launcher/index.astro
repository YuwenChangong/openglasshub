---
import CommunityLayout from "../../layouts/CommunityLayout.astro";

const statusRows = [
  {
    item: "Home / App Library 方向",
    status: "已明确",
    note: "当前公开方向已经明确主界面与应用入口的职责分工，不再按手机桌面思路组织。",
  },
  {
    item: "Navi 交互入口",
    status: "方向已写入",
    note: "Navi 被定义为核心入口，但当前仍属于产品方向与交互验证，不代表可安装能力。",
  },
  {
    item: "语音 / 按键确认边界",
    status: "边界已说明",
    note: "当前强调显式触发和确认层，不把语音或按键写成默认自动化执行能力。",
  },
  {
    item: "眼动 / 硬件集成边界",
    status: "未证明",
    note: "没有证明中的真实眼动、厂商 SDK、OpenXR 或相机集成，不应反向推导为已支持。",
  },
  {
    item: "手机端管理协同",
    status: "方向已定义",
    note: "手机端负责更复杂的输入、设置和管理，眼镜端保持轻量入口，这是当前已公开的设计判断。",
  },
] as const;
---

<CommunityLayout
  title="Gaze Launcher"
  description="面向 AR / AI 眼镜的 AI-first 智能启动器。"
  canonical="https://openglasshub.pages.dev/gaze-launcher/"
  activeSection="launcher"
>
  <section class="community-page-head launcher-head">
    <div>
      <span class="community-tag">开发中 / 实验性</span>
      <h1>Gaze Launcher</h1>
      <p class="community-page-lead launcher-lead">面向 AR / AI 眼镜的 AI-first 智能启动器。当前暂无正式可用版本，页面只说明产品方向和验证边界。</p>
    </div>
    <div class="community-cta-row">
      <a href="#progress" class="community-button">查看项目进展</a>
      <a href="/feed/" class="community-button--secondary">进入论坛讨论</a>
      <a href="/gaze-os/" class="community-button--secondary">查看技术文档</a>
    </div>
  </section>

  <section class="launcher-layout">
    <main class="launcher-main">
      <section class="launcher-block">
        <div class="launcher-block__head">
          <h2>它解决什么</h2>
          <p>不是把手机桌面搬到眼镜上，而是把主界面、应用入口、Navi 和手机端协同整理成更适合眼镜的使用路径。</p>
        </div>
        <div class="community-list launcher-list">
          <article class="community-list-item">
            <strong>Home</strong>
            <p>进入眼镜后优先看到常用入口、最近任务和基础状态，而不是一整页图标墙。</p>
          </article>
          <article class="community-list-item">
            <strong>App Library</strong>
            <p>把翻译、导航、笔记、设置等入口重新整理成眼镜可理解的结构。</p>
          </article>
          <article class="community-list-item">
            <strong>Navi</strong>
            <p>优先围绕“看到内容后要做什么”来组织交互，而不是先找应用再手动执行任务。</p>
          </article>
        </div>
      </section>

      <section class="launcher-block" id="progress">
        <div class="launcher-block__head">
          <h2>当前做到哪</h2>
          <p>这里只列当前文档里已经写明的方向与边界，不补未验证的设备支持或运行时集成。</p>
        </div>
        <div class="launcher-status-table">
          {statusRows.map((row) => (
            <article class="launcher-status-row">
              <div>
                <strong>{row.item}</strong>
                <p>{row.note}</p>
              </div>
              <span class="community-tag community-tag--muted">{row.status}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="launcher-block">
        <div class="launcher-block__head">
          <h2>还不承诺什么</h2>
          <p>实验性项目必须明确哪些能力目前没有，避免把方向页误读成现成系统。</p>
        </div>
        <div class="community-list launcher-list">
          <article class="community-list-item">
            <strong>没有正式可用版本</strong>
            <p>当前不是 production-ready 产品，也不代表已有可安装的正式发行形态。</p>
          </article>
          <article class="community-list-item">
            <strong>没有证明中的真实眼动支持</strong>
            <p>当前不能宣称真实 eye tracking 已完成接入，更不能把“凝视方向”写成已落地能力。</p>
          </article>
          <article class="community-list-item">
            <strong>没有证明中的厂商 SDK / OpenXR / 相机集成</strong>
            <p>除非已有明确代码或文档证明，否则不能宣称已经完成这些运行时或硬件级集成。</p>
          </article>
          <article class="community-list-item">
            <strong>不会通过凝视自动执行动作</strong>
            <p>当前方向强调确认层，不做“看一眼就自动执行”的危险交互。</p>
          </article>
        </div>
      </section>
    </main>

    <aside class="launcher-side">
      <section class="launcher-sidepanel">
        <span class="community-meta">当前状态</span>
        <h2>实验性项目</h2>
        <p>当前页面只说明产品方向、输入模型和验证边界，不代表任何真实硬件兼容承诺。</p>
        <div class="community-cta-row" style="margin-top: 0.9rem;">
          <a href="/gaze-os/" class="community-button--secondary">阅读技术文档</a>
        </div>
      </section>

      <section class="launcher-sidepanel launcher-sidepanel--muted">
        <span class="community-meta">想参与验证？</span>
        <div class="community-list" style="padding: 0.25rem 0 0;">
          <a class="community-list-item community-link-row" href="/feed/">
            <strong>进入论坛讨论</strong>
            <span>跟进方向、边界和真实设备观察。</span>
          </a>
          <a class="community-list-item community-link-row" href="/community/">
            <strong>反馈运行时信息</strong>
            <span>分享你对设备、权限和交互限制的观察。</span>
          </a>
        </div>
      </section>
    </aside>
  </section>
</CommunityLayout>

<style>
  .launcher-head {
    align-items: flex-start;
    margin-bottom: 1rem;
  }
  .launcher-head h1 {
    margin-top: 0.45rem;
  }
  .launcher-lead {
    max-width: 760px;
    margin-top: 0.35rem;
  }
  .launcher-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 1.1rem;
    align-items: start;
  }
  .launcher-main {
    display: grid;
    gap: 1.15rem;
  }
  .launcher-block {
    display: grid;
    gap: 0.85rem;
  }
  .launcher-block__head {
    display: grid;
    gap: 0.2rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--border);
  }
  .launcher-block__head h2 {
    margin: 0;
    color: var(--text);
    font-size: 1.05rem;
  }
  .launcher-block__head p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.6;
    font-size: 0.9rem;
  }
  .launcher-list {
    padding: 0.2rem 0 0;
  }
  .launcher-status-table {
    display: grid;
  }
  .launcher-status-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }
  .launcher-status-row:last-child {
    border-bottom: 0;
  }
  .launcher-status-row strong {
    color: var(--text);
    font-size: 0.92rem;
  }
  .launcher-status-row p {
    margin: 0.25rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .launcher-side {
    display: grid;
    gap: 1rem;
  }
  .launcher-sidepanel {
    display: grid;
    gap: 0.35rem;
    padding: 0.2rem 0 1rem 1rem;
    border-left: 1px solid var(--border);
  }
  .launcher-sidepanel--muted {
    padding-top: 0.8rem;
  }
  .launcher-sidepanel h2 {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
  }
  .launcher-sidepanel p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.6;
    font-size: 0.9rem;
  }
  .community-link-row {
    text-decoration: none;
  }
  .community-link-row:hover strong {
    color: var(--accent-hover);
  }
  @media (max-width: 900px) {
    .launcher-layout {
      grid-template-columns: 1fr;
    }
    .launcher-sidepanel {
      border-left: 0;
      border-top: 1px solid var(--border);
      padding-left: 0;
      padding-top: 0.9rem;
    }
  }
</style>
