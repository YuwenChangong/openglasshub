[CmdletBinding()]
param(
  [Parameter(Mandatory = $true)][string]$AuthorizationPath,
  [Parameter(Mandatory = $true)][string]$PackageRoot,
  [ValidateSet('ValidateOnly', 'FinalizeHumanConfirmation', 'Execute')][string]$Mode = 'ValidateOnly',
  [string]$FinalConfirmationPath
)
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$config = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('__CONFIG_BASE64__')) | ConvertFrom-Json
function Get-Sha256([string]$Path) { $stream=$null; $sha=$null; try { $stream=[IO.File]::OpenRead($Path); $sha=[Security.Cryptography.SHA256]::Create(); return (-join ($sha.ComputeHash($stream) | ForEach-Object { $_.ToString('x2') })) } finally { if($sha){$sha.Dispose()}; if($stream){$stream.Dispose()} } }
$binding = Get-Content -LiteralPath $config.launcherBindingPath -Raw | ConvertFrom-Json
if ($binding.schemaVersion -ne 'r6-production-reconciliation-launcher-binding-v2' -or $binding.packageSchemaVersion -ne 'r6-production-reconciliation-execution-package-v4' -or (Get-Sha256 $PSCommandPath) -ne $binding.launcherSha256) { throw 'R6_PRODUCTION_RECONCILIATION_LAUNCHER_INTEGRITY_INVALID' }
if ((Get-Sha256 $config.transportPath) -ne $config.transportSha256) { throw 'R6_PRODUCTION_RECONCILIATION_TRANSPORT_INTEGRITY_INVALID' }
$env:R6_PRODUCTION_RECONCILIATION_IMPLEMENTATION_COMMIT = $config.implementationCommit
$env:R6_PRODUCTION_RECONCILIATION_LAUNCHER_SHA256 = $binding.launcherSha256
if ($Mode -eq 'ValidateOnly') {
  & $config.nodePath $config.transportPath ValidateOnly $AuthorizationPath $PackageRoot
  exit $LASTEXITCODE
}
if ([string]::IsNullOrWhiteSpace($FinalConfirmationPath)) { throw 'R6_PRODUCTION_RECONCILIATION_FINAL_CONFIRMATION_PATH_REQUIRED' }
if ($Mode -eq 'FinalizeHumanConfirmation') {
  if ([Console]::IsInputRedirected -or [Console]::IsOutputRedirected -or $Host.Name -ne 'ConsoleHost') { throw 'R6_PRODUCTION_RECONCILIATION_INTERACTIVE_HOST_REQUIRED' }
  $confirmation = Read-Host 'Enter the exact approved confirmation phrase' -AsSecureString
  $ptr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($confirmation)
  try {
    $env:R6_PRODUCTION_RECONCILIATION_CONFIRMATION = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($ptr)
    & $config.nodePath $config.transportPath FinalizeHumanConfirmation $AuthorizationPath $PackageRoot $FinalConfirmationPath
    exit $LASTEXITCODE
  } finally {
    [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($ptr)
    Remove-Item Env:R6_PRODUCTION_RECONCILIATION_CONFIRMATION -ErrorAction SilentlyContinue
    $confirmation.Dispose()
  }
}
& $config.nodePath $config.transportPath Execute $AuthorizationPath $PackageRoot $FinalConfirmationPath $config.receiptRoot
exit $LASTEXITCODE
