[CmdletBinding()]
param(
  [Parameter(Mandatory = $true)][string]$LauncherPath,
  [Parameter(Mandatory = $true)][string]$ExpectedLauncherSha256,
  [Parameter(Mandatory = $true)][string]$ExpectedCredentialBrokerSha256
)
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
function Get-Sha256([string]$Path) {
  $stream = $null; $sha = $null
  try { $stream = [IO.File]::OpenRead($Path); $sha = [Security.Cryptography.SHA256]::Create(); return (-join ($sha.ComputeHash($stream) | ForEach-Object { $_.ToString('x2') })) }
  finally { if ($sha) { $sha.Dispose() }; if ($stream) { $stream.Dispose() } }
}
if (-not (Test-Path -LiteralPath $LauncherPath -PathType Leaf)) { throw 'R6_PRODUCTION_RECONCILIATION_SECURE_WRAPPER_LAUNCHER_MISSING' }
if ((Get-Sha256 $LauncherPath) -ne $ExpectedLauncherSha256) { throw 'R6_PRODUCTION_RECONCILIATION_SECURE_WRAPPER_LAUNCHER_INTEGRITY_INVALID' }
$CredentialBrokerPath = Join-Path $PSScriptRoot 'r6-production-dpapi-credential-broker.ps1'
if (-not (Test-Path -LiteralPath $CredentialBrokerPath -PathType Leaf)) { throw 'R6_DPAPI_CREDENTIAL_BROKER_MISSING' }
if ((Get-Sha256 $CredentialBrokerPath) -ne $ExpectedCredentialBrokerSha256) { throw 'R6_DPAPI_CREDENTIAL_BROKER_INTEGRITY_INVALID' }
$launcherBytes = [IO.File]::ReadAllBytes($LauncherPath)
$match = [regex]::Match([Text.Encoding]::UTF8.GetString($launcherBytes), 'FromBase64String\(''([^'']+)''\)')
if (-not $match.Success) { throw 'R6_PRODUCTION_RECONCILIATION_SECURE_WRAPPER_LAUNCHER_CONFIG_INVALID' }
try { $config = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($match.Groups[1].Value)) | ConvertFrom-Json -ErrorAction Stop } catch { throw 'R6_PRODUCTION_RECONCILIATION_SECURE_WRAPPER_LAUNCHER_CONFIG_INVALID' }
$route = $config.routeAuthority
$routeFieldNames = @('projectRef', 'connectionMode', 'pgHost', 'pgPort', 'pgDatabase', 'pgUser')
if ($null -eq $route -or @($routeFieldNames | Where-Object { $null -eq $route.PSObject.Properties[$_] }).Count -ne 0) { throw 'R6_PRODUCTION_RECONCILIATION_SECURE_WRAPPER_ROUTE_AUTHORITY_INVALID' }
if ($route.PSObject.Properties['projectRef'].Value -ne 'xcbnxzjlsvtgzixurcof' -or $route.PSObject.Properties['connectionMode'].Value -ne 'SHARED_POOLER_SESSION' -or $route.PSObject.Properties['pgHost'].Value -ne 'aws-1-ap-northeast-1.pooler.supabase.com' -or $route.PSObject.Properties['pgPort'].Value -ne '5432' -or $route.PSObject.Properties['pgDatabase'].Value -ne 'postgres' -or $route.PSObject.Properties['pgUser'].Value -ne 'postgres.xcbnxzjlsvtgzixurcof') { throw 'R6_PRODUCTION_RECONCILIATION_SECURE_WRAPPER_ROUTE_AUTHORITY_INVALID' }
function Invoke-RouteBoundProcess([string]$FileName, [string]$Arguments) {
  $psi = New-Object Diagnostics.ProcessStartInfo
  $psi.FileName = $FileName
  $psi.Arguments = $Arguments
  $psi.UseShellExecute = $false
  $psi.RedirectStandardOutput = $true
  $psi.RedirectStandardError = $true
  $psi.EnvironmentVariables['PGHOST'] = $route.pgHost
  $psi.EnvironmentVariables['PGPORT'] = $route.pgPort
  $psi.EnvironmentVariables['PGDATABASE'] = $route.pgDatabase
  $psi.EnvironmentVariables['PGUSER'] = $route.pgUser
  $child = [Diagnostics.Process]::Start($psi)
  $stdoutTask = $child.StandardOutput.ReadToEndAsync()
  $stderrTask = $child.StandardError.ReadToEndAsync()
  $child.WaitForExit()
  $stdout = $stdoutTask.Result
  $stderr = $stderrTask.Result
  return [pscustomobject]@{ ExitCode = $child.ExitCode; Stdout = $stdout; Stderr = $stderr }
}
$preflightArguments = ('"{0}" Preflight "{1}" "{2}" "{3}" "{4}" "{5}" "{6}" "{7}" "{8}" "{9}"' -f $config.transportPath, $config.approvalPath, $config.packageRoot, $config.finalConfirmationPath, $config.receiptRoot, $config.candidateRoot, $config.executionBindingPath, $config.materializationPath, $config.launcherBindingPath, $config.evidenceRoot)
$preflight = Invoke-RouteBoundProcess $config.nodePath $preflightArguments
if ($preflight.ExitCode -ne 0 -or -not ($preflight.Stdout -match 'R6_PRODUCTION_RECONCILIATION_OFFLINE_PREFLIGHT_READY')) { throw 'R6_PRODUCTION_RECONCILIATION_SECURE_WRAPPER_OFFLINE_PREFLIGHT_FAILED' }
. $CredentialBrokerPath
$secret = $null; $ptr = [IntPtr]::Zero
try {
  $secret = Get-R6ProductionPgPasswordSecureString
  $ptr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secret)
  $plain = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($ptr)
  $psi = New-Object Diagnostics.ProcessStartInfo
  $psi.FileName = (Get-Command powershell.exe -CommandType Application -ErrorAction Stop).Source
  $psi.Arguments = "-NoProfile -ExecutionPolicy Bypass -File `"$LauncherPath`""
  $psi.UseShellExecute = $false
  $psi.RedirectStandardOutput = $false
  $psi.RedirectStandardError = $false
  $psi.EnvironmentVariables['PGPASSWORD'] = $plain
  $psi.EnvironmentVariables['PGHOST'] = $route.pgHost
  $psi.EnvironmentVariables['PGPORT'] = $route.pgPort
  $psi.EnvironmentVariables['PGDATABASE'] = $route.pgDatabase
  $psi.EnvironmentVariables['PGUSER'] = $route.pgUser
  $child = [Diagnostics.Process]::Start($psi)
  $child.WaitForExit()
  exit $child.ExitCode
} finally {
  if ($ptr -ne [IntPtr]::Zero) { [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($ptr) }
  if ($secret) { $secret.Dispose() }
  Remove-Variable plain -ErrorAction SilentlyContinue
}
