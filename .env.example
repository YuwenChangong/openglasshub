# Server-side (Cloudflare Worker SSR pages — NOT exposed to browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Client-side (bundled into browser JS — visible to users)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Server-only abuse control
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
RATE_LIMIT_SALT=replace-with-a-random-long-string
UPLOAD_TURNSTILE_MODE=risk_based
# Optional local/preview bypass; keep false in production
DEV_TURNSTILE_BYPASS=false
